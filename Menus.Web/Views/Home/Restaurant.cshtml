@using Menus.Abstract.Models
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@model Menus.Web.Models.ViewModels.RestaurantViewModel
@inject Menus.Web.Services.UserService  UserService;
@inject Menus.Domain.Core Core
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var seo = ViewData["seo"] as Menus.Abstract.Models.IRestaurantSeo;
    ViewData["BodyClass"] = "restaurant-page";
    int categoryIndex;

    var selectedCity = ViewData["selectedCity"] as Menus.Abstract.Models.ICity;
    var url = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var restaurantCity = await Core.Restaurants.GetCityById(Model.Restaurant.City);

    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;

    var title = string.IsNullOrEmpty(seo.Title.Get(culture))
        ? string.Format(Localizer["MetaTitle"].Value, Model.Restaurant.Name, restaurantCity.Name.Get(culture))
        : seo.Title.Get(culture);
    ViewData["Title"] = title;

    var restaurantDescription = Model.RestaurantInfo.ShortInfo.Get(culture);
    ViewData["Description"] = string.IsNullOrEmpty(seo.Description.Get(culture))
        ? string.Format(Localizer["MetaDescription"].Value, Model.Restaurant.Name, restaurantCity.Name.Get(culture))
        : seo.Description.Get(culture);

    var currentDay = (int)DateTime.Now.DayOfWeek;
    currentDay = currentDay == 0 ? 6 : currentDay - 1;
    JToken currentDayInfo = null;
    JArray allDaysInfo = null;
    if (Model.SchedulePerDay)
    {
        allDaysInfo = JsonConvert.DeserializeObject<JArray>(Model.OpenHours);
        currentDayInfo = allDaysInfo[currentDay];
    }

    var imgAlt = $"{Localizer["Photo"].Value} {Model.Restaurant.Name} {restaurantCity.Name.Get(culture)}";

    var selectedCityId = Context.Request.Cookies[".Menus.SelectedCity"];
    selectedCityId = !string.IsNullOrEmpty(selectedCityId) ? selectedCityId : "e2655e24-92dc-4179-abf6-c3908278a4de";
    var featuredRestaurants = Core.Restaurants.FindSimilarCuisineRestaurants(Model.RestaurantInfo.Cuisine.Get(culture).Split(",")[0], selectedCityId, Model.RestaurantInfo.RestaurantId).OrderBy(x => x.Name).Take(4).ToList();

    var topDishes = ViewData["topDishes"] as List<IDishWithSeoAndRatings>;

    var isMobile = UserService.IsMobileUser(Context.Request);
    var isDesktop = !UserService.IsMobileUser(Context.Request);
    var notEmptyCategories = Model.Menu.Categories.Count > 0;
    var emptyCategories = Model.Menu.Categories.Count == 0;
    var canSeeAddMenuAndAddDish = (Model.RestaurantInfo.UserAllowedAddMenu || Model.RestaurantInfo.UserAllowedOpenMenu || Model.RestaurantInfo.UserAllowedAddDishes) || !Model.Restaurant.IsModeratable;
    var canSeeAddMenu = (Model.RestaurantInfo.UserAllowedAddMenu || Model.RestaurantInfo.UserAllowedOpenMenu) || !Model.Restaurant.IsModeratable;
    var canSeeAddDish = (Model.RestaurantInfo.UserAllowedAddDishes) || !Model.Restaurant.IsModeratable;
    var h1Text = !string.IsNullOrEmpty(seo.Header.Get(culture)) ? seo.Header.Get(culture): Model.Restaurant.Name;
}

@await Html.PartialAsync("_Header")

@section JsonLd {
    @{
        var ldPageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var ldHomeUrl = Url.Action("Index", "Home", null, Context.Request.Scheme);
    }
    @(Menus.Web.Helpers.JsonLd.Script(
        Menus.Web.Helpers.JsonLd.Restaurant(
            Model.Restaurant.Name, ldPageUrl,
            Model.Photos.Any() ? Img.Url(Model.Photos.First(), Quality.High) : null,
            Model.Restaurant.Phone, Model.RestaurantInfo.Cuisine.Get(culture),
            Model.RestaurantInfo.DisplayAddress.Get(culture), restaurantCity.Name.Get(culture),
            Model.RestaurantInfo.GpsLatitude, Model.RestaurantInfo.GpsLongitude, Model.RestaurantInfo.Website),
        Menus.Web.Helpers.JsonLd.Breadcrumbs(("TipMyMenu", ldHomeUrl), (Model.Restaurant.Name, ldPageUrl))))
}

@section Styles {
    <style>
        button[data-user-id] {
            display: none;
        }

        button[data-user-id="@User.Identity.Name"] {
            display: initial;
        }
    </style>
}

<div itemscope>
    <div class="topSection">
        <div class="wrapper">
            <h1 itemprop="name">
                <figure>
                    <img itemprop="image" src="@Img.Url(Model.Photos.FirstOrDefault(), Quality.Low)" alt="@imgAlt" title="@imgAlt" />
                </figure>
                @h1Text
                @if (Model.UserRole != null)
                {
                    <a href="@Url.Action("EditRestaurant", "Home", new { id = Model.RestaurantInfo.RestaurantId })"><i class="far fa-edit"></i></a>
                }
            </h1>

            @if(Model.Restaurant.Status != RestaurantStatus.Closed)
            {
            
                <p>
                    <em @(!string.IsNullOrEmpty(Model.RestaurantInfo.GpsLatitude) ? "data-open-map" : "")>
                        @(restaurantCity.Name.Get(culture)),
                        @(!string.IsNullOrEmpty(Model.RestaurantInfo.DisplayAddress.Get(culture)) ? $"{Model.RestaurantInfo.DisplayAddress.Get(culture)}" : string.Empty)
                    </em>
                    <span itemprop="address" class="@(!string.IsNullOrEmpty(Model.RestaurantInfo.DisplayAddress.Get(culture)) ? "" : "hidden")" content="@Model.RestaurantInfo.DisplayAddress.Get(culture), @restaurantCity.Name.Get(culture)">|</span>
                    <a itemprop="telephone" content="@Model.Restaurant.Phone" href="tel:@Model.Restaurant.Phone">@(!string.IsNullOrEmpty(Model.Restaurant.Phone) ? Model.Restaurant.Phone : string.Empty)</a>
                    <span itemprop="servesCuisine" class="@(!string.IsNullOrEmpty(Model.Restaurant.Phone) ? "" : "hidden")" content="@Model.RestaurantInfo.Cuisine.Get(culture)">|</span> @(!string.IsNullOrEmpty(Model.RestaurantInfo.Cuisine.Get(culture)) ? Model.RestaurantInfo.Cuisine.Get(culture) : string.Empty)
                </p>
                @if (!Model.SchedulePerDay)
                {
                    <strong>@Localizer["WorkHours"]: @Model.OpenHours</strong>
                }
                else
                {
                    if (isDesktop)
                    {
                        <div class="work-hours">
                            <strong>@Localizer["WorkHours"]: <em>@Localizer["Today"] (@(currentDayInfo["active"].Value<bool>() ? $"{currentDayInfo["from"].Value<string>()}-{currentDayInfo["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</em></strong>
                            <div class="work-hours-dropdown">
                                <span>@Localizer["Mon"] (@(allDaysInfo[0]["active"].Value<bool>() ? $"{allDaysInfo[0]["from"].Value<string>()}-{allDaysInfo[0]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Tue"] (@(allDaysInfo[1]["active"].Value<bool>() ? $"{allDaysInfo[1]["from"].Value<string>()}-{allDaysInfo[1]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Wed"] (@(allDaysInfo[2]["active"].Value<bool>() ? $"{allDaysInfo[2]["from"].Value<string>()}-{allDaysInfo[2]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Thr"] (@(allDaysInfo[3]["active"].Value<bool>() ? $"{allDaysInfo[3]["from"].Value<string>()}-{allDaysInfo[3]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Fri"] (@(allDaysInfo[4]["active"].Value<bool>() ? $"{allDaysInfo[4]["from"].Value<string>()}-{allDaysInfo[4]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Sat"] (@(allDaysInfo[5]["active"].Value<bool>() ? $"{allDaysInfo[5]["from"].Value<string>()}-{allDaysInfo[5]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                                <span>@Localizer["Sun"] (@(allDaysInfo[6]["active"].Value<bool>() ? $"{allDaysInfo[6]["from"].Value<string>()}-{allDaysInfo[6]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <strong>
                            @Localizer["WorkHours"]:
                            <select>
                                <option disabled selected>@Localizer["Today"] (@(currentDayInfo["active"].Value<bool>() ? $"{currentDayInfo["from"].Value<string>()}-{currentDayInfo["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Mon"] (@(allDaysInfo[0]["active"].Value<bool>() ? $"{allDaysInfo[0]["from"].Value<string>()}-{allDaysInfo[0]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Tue"] (@(allDaysInfo[1]["active"].Value<bool>() ? $"{allDaysInfo[1]["from"].Value<string>()}-{allDaysInfo[1]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Wed"] (@(allDaysInfo[2]["active"].Value<bool>() ? $"{allDaysInfo[2]["from"].Value<string>()}-{allDaysInfo[2]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Thr"] (@(allDaysInfo[3]["active"].Value<bool>() ? $"{allDaysInfo[3]["from"].Value<string>()}-{allDaysInfo[3]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Fri"] (@(allDaysInfo[4]["active"].Value<bool>() ? $"{allDaysInfo[4]["from"].Value<string>()}-{allDaysInfo[4]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Sat"] (@(allDaysInfo[5]["active"].Value<bool>() ? $"{allDaysInfo[5]["from"].Value<string>()}-{allDaysInfo[5]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                                <option disabled>@Localizer["Sun"] (@(allDaysInfo[6]["active"].Value<bool>() ? $"{allDaysInfo[6]["from"].Value<string>()}-{allDaysInfo[6]["to"].Value<string>()}" : Localizer["Closed"].Value.ToString()))</option>
                            </select>
                        </strong>
                    }

                }

                <ul class="icons">
                    @if (!string.IsNullOrEmpty(Model.Restaurant.Phone))
                    {
                        <li>
                            <a itemprop="url" content="@Model.Restaurant.Phone" href="tel:@Model.Restaurant.Phone">
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Phone"]</em>
                        </li>
                    }
                    else if (!string.IsNullOrEmpty(Model.RestaurantInfo.Website))
                    {
                        <li>
                            <a itemprop="url" content="@Model.RestaurantInfo.Website" target="_blank" rel="noopener" href="@Model.RestaurantInfo.Website">
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Website"]</em>
                        </li>
                    }
                    @if (isDesktop && Model.Photos.Count > 0)
                    {
                        <li>
                            <a href="#" class="galleryBtn" data-pc>
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Gallery"]</em>
                        </li>
                    }
                    else if (Model.Photos.Count > 0)
                    {
                        <li>
                            <a href="#mobile-carousel" class="galleryBtn" data-mobile>
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Gallery"]</em>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.RestaurantInfo.GpsLatitude))
                    {
                        <li>
                            <a href="#" class="mapBtn" data-open-map>
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Map"]</em>
                        </li>
                    }
                    <li>
                        <a href="#" class="search-icon-button">
                            <span class="fa-fw select-all fas"></span>
                        </a>
                        <em>@Localizer["Search"]</em>
                    </li>
                </ul>
            }  
            
            @if(Model.Restaurant.Status == RestaurantStatus.Closed)
            {
                <div class="restaurant-closed-container">
                    <div class="restaurant-closed-container__restaurant-closed">
                        <div class="restaurant-closed-container__restaurant-closed__first-line">@Localizer["RestaurantClosed"]</div>
                        <div class="restaurant-closed-container__restaurant-closed__second-line">@Localizer["RClosed"]</div>                     
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="site-content">
        @if (isMobile)
        {
            <div class="top_dishes_container__buttons">
                @await Html.PartialAsync("_ServiceButtons", new ViewDataDictionary(ViewData) { { "IsExtented", true } })
            </div>
        }
            <main>
                <div class="breadcrumbs">
                    <ul>
                        <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                        <li><breadcrumb href="#">@Model.Restaurant.Name</breadcrumb></li>
                    </ul>
                </div>

                <div class="local-menu-search hidden">
                    <input type="text" placeholder="@Localizer["MenuSearch"]" />
                    <a href="javascript:void(0)" class="search-icon-button-close"></a>
                </div>

                @if (isDesktop && notEmptyCategories)
                {
                    <div class="contentNavi disableOnMobile">
                        <div class="contentNaviWrapper">

                            @if (canSeeAddMenuAndAddDish)
                            {
                                <div class="restaurant-user-actions">
                                    @if (canSeeAddMenu)
                                    {
                                        <div class="user-actions-manage-menu">
                                            <i class="far fa-file-image"></i>
                                            <label class="hidden" data-upload-photo for="photo-upload-input">@Localizer["AddMenu"]</label>
                                            <a class="hidden" data-open-menus-photos href="#">@Localizer["ViewMenu"]</a>
                                        </div>
                                    }
                                    @if (canSeeAddDish)
                                    {
                                        <div class="user-actions-manage-dish">
                                            <i class="far fa-plus-square"></i>
                                            <a asp-controller="Home" asp-action="CreateDish" asp-route-id="@ViewData["restaurantId"]">@Localizer["AddDish"]</a>
                                        </div>
                                    }
                                </div>
                            }

                            <ul>
                                @{
                                    categoryIndex = 0;
                                }
                                @foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                                {
                                    categoryIndex++;
                                    <li><a href="#table_food_@categoryIndex">@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                }
                else if (Model.Menu.Categories.Any())
                {
                    <!-- Swiper -->
                    <div class="contentNaviCarousel disableOnDesktop">
                        <div class="contentNaviCarouselInner">
                            <div class="swiper-container navi-carousel">
                                <div class="swiper-wrapper">
                                    @{
                                        categoryIndex = 0;
                                    }
                                    @foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                                    {
                                        categoryIndex++;
                                        <div class="swiper-slide"><a href="#table_food_@categoryIndex">@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</a></div>
                                    }

                                    @if (canSeeAddMenuAndAddDish)
                                    {
                                        <div class="restaurant-user-actions">
                                            @if (canSeeAddMenu)
                                            {
                                                <div class="user-actions-manage-menu">
                                                    <i class="far fa-file-image"></i>
                                                    <label class="hidden" data-upload-photo for="photo-upload-input">@Localizer["AddMenu"]</label>
                                                    <a class="hidden" data-open-menus-photos href="#">@Localizer["ViewMenu"]</a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (isMobile && notEmptyCategories)
                {
                    @if (canSeeAddMenuAndAddDish && canSeeAddDish)
                    {
                        <div class="user-actions-manage-dish-fixed">
                            <i class="far fa-plus-square"></i>
                            <a asp-controller="Home" asp-action="CreateDish" asp-route-id="@ViewData["restaurantId"]">@Localizer["AddDish"]</a>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Restaurant.Phone))
                    {
                        <div class="user-actions-phone-fixed">
                            <a itemprop="url" content="@Model.Restaurant.Phone" href="tel:@Model.Restaurant.Phone">
                                <span class="fa-fw select-all fas"></span>
                                @Localizer["Reserv"]
                            </a>
                        </div>
                    }
                }


                <div class="site-content-align">

                    @await Html.PartialAsync("_GoogleSence",
                    new Menus.Web.Models.Internal.GoogleSence() {
                        GoogleSenceType = Menus.Web.Models.Internal.GoogleSenceTypes.Wide
                    })

                    <div class="top_dishes_container">

                        <h2 class="top_dishes_title">
                            @if (topDishes.Any())
                            {
                                @Localizer["TopDishes"]
                            }
                            else
                            {
                                @Localizer["AdditionalServices"]
                            }
                        </h2>

                        @if (isDesktop)
                        {
                            <div class="top_dishes_container__buttons">
                                @await Html.PartialAsync("_ServiceButtons", new ViewDataDictionary(ViewData) { { "IsExtented", true } })
                            </div>
                        }
                    </div>


                    @if (isDesktop && topDishes.Any())
                    {
                        <div class="popular_dishes disableOnMobile">
                            @foreach (var dish in topDishes)
                            {
                                <div class="restaurant">
                                    <a asp-controller="Home" asp-action="Dish" asp-route-city="@ViewData["selectedCityName"]" asp-route-id="@seo.Url" asp-route-dishId="@dish.Url">
                                        @if (dish.Photos.Any())
                                        {
                                            <figure class="restaurant-image" style="background-image: url(@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low));">
                                                <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                            </figure>
                                        }
                                        else
                                        {
                                            <figure class="restaurant-image restaurant-image-blank">
                                                <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                            </figure>
                                        }
                                        <p class="restaurant-name">
                                            @dish.Name.Get(culture)
                                        </p>
                                        <p class="popular_dish_info">
                                            <strong>@dish.RatingFloat.ToString("F1")</strong>
                                            @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                            <em>(@dish.RatingCount)</em>
                                        </p>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else if (topDishes.Any())
                    {
                        <!-- Swiper -->
                        <div class="popular-area disableOnDesktop">
                            <div class="swiper-container popular-container">
                                <div class="swiper-wrapper">
                                    @foreach (var dish in topDishes)
                                    {
                                        <a class="swiper-slide" asp-controller="Home" asp-action="Dish" asp-route-city="@ViewData["selectedCityName"]" asp-route-id="@seo.Url" asp-route-dishId="@dish.Url">

                                            @if (dish.Photos.Any())
                                            {
                                                <figure class="restaurant-image" style="background-image: url(@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low));">
                                                    <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                </figure>
                                            }
                                            else
                                            {
                                                <figure class="restaurant-image restaurant-image-blank">
                                                    <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                </figure>
                                            }
                                            <p class="restaurant-name">
                                                @dish.Name.Get(culture)
                                            </p>
                                            <p class="popular_dish_info">
                                                <strong>@dish.RatingFloat.ToString("F1")</strong>
                                                @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                <em>(@dish.RatingCount)</em>
                                            </p>
                                        </a>
                                    }
                                    <div class="swiper-slide"></div>
                                </div>
                                <!-- Add Pagination -->
                                <div class="swiper-pagination"></div>
                            </div>
                        </div>
                    }

                    <div id="table_food_top"></div>
                    @if (isDesktop)
                    {
                        @if (notEmptyCategories)
                        {
                            categoryIndex = 0;
                            foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                            {
                                categoryIndex++;
                                <div class="table_element @(categoryIndex == 1 ? "visible" : "")">
                                    <table class="table_food disableOnMobile" id="table_food_@categoryIndex">
                                        <thead>
                                            <tr>
                                                <td class="table_food_name"><h2>@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</h2></td>
                                                @if (categoryIndex == 1)
                                                {
                                                    <td class="table_food_price">@Localizer["Price"]</td>
                                                    <td class="table_food_weight">@Localizer["Weight"]</td>
                                                    <td class="table_food_rating">@Localizer["Rating"]</td>
                                                }
                                                else
                                                {
                                                    <td class="table_food_price"></td>
                                                    <td class="table_food_weight"></td>
                                                    <td class="table_food_rating"></td>
                                                }
                                                <td class="table_food_count"></td>
                                                <td class="table_food_link"></td>
                                            </tr>
                                        </thead>
                                        <tbody style="@(categoryIndex == 1 ? "display: table-row-group;" : "")">
                                            @foreach (var dish in category.Dishes.OrderByDescending(x => x.RatingFloat))
                                            {
                                                <tr data-dish-id="@dish.Id">
                                                    <td class="table_food_name">
                                                        <h3>
                                                            <a href="@Url.Action("Dish", "Home", new { id = ViewData["restaurantId"], dishId = dish.Url })">
                                                                @(Char.ToUpper(dish.Name.Get(culture)[0]) + dish.Name.Get(culture).Substring(1))
                                                                @if (dish.Photos.Any())
                                                                {
                                                                    <span class="show-dish-image">
                                                                        <object class="has-pictures-icon" type="image/svg+xml" data="~/images/has_pictures.svg"></object>
                                                                    </span>
                                                                }
                                                            </a>

                                                        </h3>
                                                        @if (dish.ShortDescription.Get(culture).Length > 0)
                                                        {
                                                            <p>@dish.ShortDescription.Get(culture)</p>
                                                        }
                                                    </td>
                                                    <td class="table_food_price">
                                                        @if (dish.IsPriceMultiple)
                                                        {
                                                            <span>@Localizer["From"]&nbsp;</span>
                                                        }
                                                        @Model.RestaurantInfo.Currency @dish.Price.ToString("F2")
                                                    </td>
                                                    <td class="table_food_weight">@dish.Weight @dish.WeightType</td>
                                                    <td class="table_food_rating @(dish.UserRating > 0 ? "rated" : "")">
                                                        @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                        @if (User.Identity.IsAuthenticated)
                                                        {
                                                            <div class="hover_rating">
                                                                @if (dish.UserRating > 0)
                                                                {
                                                                    <p>@Localizer["YourRate"]</p>
                                                                    for (var i = 1; i <= 5; i++)
                                                                    {
                                                                        if (i <= dish.UserRating)
                                                                        {
                                                                            <span class="stars star_red"></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="stars star_grey"></span>
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <p>@Localizer["RateDish"]</p>
                                                                    for (var i = 1; i <= 5; i++)
                                                                    {
                                                                        if (i < dish.Rating)
                                                                        {
                                                                            <span class="stars star_yellow"></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="stars star_grey"></span>
                                                                        }
                                                                    }
                                                                }
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="table_food_count"><em>@dish.RatingCount</em> @Localizer["Ratings"]</td>
                                                    <td class="table_food_link"><a href="@Url.Action("Dish", "Home", new { id = ViewData["restaurantId"], dishId = dish.Url })"></a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <div class="found_mistake pc" style="@(categoryIndex == 1 ? "display: block;" : "")">
                                        <span>@Localizer["FoundError"]?</span>
                                        <a href="#">@Localizer["HelpUsToImproveData"]</a>
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
