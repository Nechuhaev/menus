@section Scripts
    {
    <script src="~/js/swiper.min.js"></script>
    <script>
        let TRANSLATION_YOU_RATE = `@Localizer["YourRate"]`;
        let TRANSLATION_NO_ITEMS = `@Localizer["NoItems"]`;

        var cityId = "@ViewData["selectedCity"]";
        window.cropperAspectRatio = 0.75555;

                var loggedIn = @User.Identity.IsAuthenticated.ToString().ToLower();
        var restaurantId = "@Model.RestaurantInfo.RestaurantId";

        var lat = "@Model.RestaurantInfo.GpsLatitude";
        var lon = "@Model.RestaurantInfo.GpsLongitude";

        var photosCount = @Model.MenuPhotos.Count();
    </script>
    <script src="~/js/typeahead-inner.js"></script>

    <script>
        var galleryThumbs;
        var galleryTop;
        var galleryMenu;
        var galleryMenuThumbs;
        var galleryMobileMenu;
        var infoInfoWindow = null;

        function updateMenuUserInfo(photoId) {
            $.ajax({
                    url: "@Url.Action("GetMenuUserInfo", "Home")",
                    type: "GET",
                    data: {
                        menuPhotoId: photoId
                    }
                })
                .done(function(html) {
                    $(".menu-user-info").html(html);
                });
        }

        function getToken() {
            var token = '@Html.AntiForgeryToken()';
            token = $(token).val();
            return token;
        }

        function initMap() {
            console.log('init map');
            if (lat && lon) {
                var mapLat = parseFloat(lat);
                var mapLon = parseFloat(lon);
                window.map = new google.maps.Map(document.getElementById('mapContainer'),
                    {
                        center: { lat: mapLat, lng: mapLon },
                        zoom: 16
                    });

                var marker = new google.maps.Marker({
                    position: new google.maps.LatLng(mapLat, mapLon),
                    map: map,
                    icon: '/images/star_for_map.png'
                });
                marker.directionUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapLat},${mapLon}`;
                marker.description = `<div class="restaurant_caption">
                                    <figure>
                                        <img src="@Img.Url(Model.Photos.FirstOrDefault(), Quality.Low)" alt="Alternate Text" />
                                    </figure>
                                    <div class="info-window-content">
                                        <h3><a href="${marker.directionUrl}" target="_blank">@Model.Restaurant.Name</a></h3><span class="item_location">@Model.RestaurantInfo.DisplayAddress.Get(culture)</span></div>
                                    </div>
                                  `;
                google.maps.event.addListener(marker,
                    'click',
                    function () {
                        showInfoWindow(this);
                    });

                showInfoWindow(marker);

                function showInfoWindow(marker) {
                    var contentString = marker.description
                    if (infoInfoWindow) {
                        infoInfoWindow.close()
                    }

                    infoInfoWindow = new google.maps.InfoWindow({
                        content: contentString,
                        position: marker.getPosition(),
                        pixelOffset: new google.maps.Size(0, -15)
                    })

                    $('.direction-link').attr('href', marker.directionUrl)
                    infoInfoWindow.open(map);
                }
            }
        };

        /* Search popup in mobile */
        function updateUploadMenuPhotoButtons() {
            if (photosCount === 0) {
                $(".restaurant-user-actions [data-upload-photo]").removeClass("hidden");
                $(".restaurant-user-actions [data-open-menus-photos]").addClass("hidden");

                $('.popUpBlockMain').removeClass('visible visible_gallery visible_map');
                $('.popUpWindow').fadeOut();
                $('.popUpCarousel').removeClass('visible');
            } else {
                $(".restaurant-user-actions [data-upload-photo]").addClass("hidden");
                $(".restaurant-user-actions [data-open-menus-photos]").removeClass("hidden");
            }
        }

        function uploadPhotoCallback(result) {
            photosCount++;
            updateUploadMenuPhotoButtons();

            //show gallery
            $('.popUpBlockMain').addClass('visible visible_gallery');
            $('.popUpCarousel').addClass("hidden").removeClass('visible');
            $('.popUpCarouselMenu').removeClass('hidden');
            $('.popUpCarouselMenu').addClass('visible');

            //hide upload popup
            $('.mobileAddPhotoContainer').toggleClass("hidden", true);
            $(".popUpBlockPhotos").removeClass("visible");
            $(".popUpBlockPhotos").hide();

            //Adding emage to gallery
            $('.popUpCarouselMenu .gallery-top .swiper-wrapper').prepend('<div data-menu-photo-id="' + result.id + '" data-menu-user-id="@User.Identity.Name" class="swiper-slide" style="background-image:url(@Img.BaseUrl/' + result.name + ')"></div>');
            $('.popUpCarouselMenu .gallery-thumbs .swiper-wrapper').prepend('<div data-menu-photo-id="' + result.id + '" class="swiper-slide" style="background-image:url(@Img.BaseUrl/' + result.name + ')"></div>');

            let item = jQuery(".popUpCarouselMenu .swiper-wrapper [data-menu-photo-id=" + result.id + "]");
            let index = jQuery('.popUpCarouselMenu .swiper-wrapper div').index(item);

            updateMenuUserInfo(result.id);
            $("[data-delete-photo]").removeClass("hidden");

            item.css("width", "100%");

            galleryMenu.update();
            galleryMenu.slideTo(0);
            galleryMenu.update();
            if (galleryMenuThumbs) {
                galleryMenuThumbs.update();
            }
        }

        function processDeleteButton(slide) {
            var userId = slide.attr("data-menu-user-id");
            if (userId === "@User.Identity.Name") {
                $("[data-delete-photo]").removeClass("hidden");
            } else {
                $("[data-delete-photo]").addClass("hidden");
            }
        }

        function initFeaturedSwiper() {
            let featuredSwiper = new Swiper('.featured-container', {
                slidesPerView: 2,
                spaceBetween: 15,
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
            });
        }

        function initPopularSwiper() {
            let popularSwiper = new Swiper('.popular-container', {
                slidesPerView: 3,
                spaceBetween: 15,
            });
        }

        function processGalleryFirstImage(gallery) {
            const canProcessGallery = Boolean(gallery.slides && gallery.slides.length);
            if (canProcessGallery) {
                const slide = $(gallery.slides[0]);
                const photoId = slide.attr("data-menu-photo-id");
                const canProcess = slide && photoId;
                if (slide) {
                    processDeleteButton(slide);
                }
                if (photoId) {
                    updateMenuUserInfo(photoId);
                }
            }            
        }

        function initGalleryMobile() {
            galleryMenu = new Swiper('.popUpCarouselMenu .gallery-top', {
                slidesPerView: 1,
                keyboard: {
                    enabled: true,
                },
                pagination: {
                    el: '.popUpCarouselMenu .swiper-pagination',
                    type: 'fraction',
                },
            });
            processGalleryFirstImage(galleryMenu);

            console.log('Gallery Mobile');
            galleryMobileMenu = new Swiper('.mobile_carousel_wrapper .mobile_carousel', {
                slidesPerView: 1,
                keyboard: {
                    enabled: true,
                },
                navigation: {
                    nextEl: '.mobile_carousel_wrapper .mobile_carousel-next',
                    prevEl: '.mobile_carousel_wrapper .mobile_carousel-prev',
                }
            });
            processGalleryFirstImage(galleryMobileMenu);

            galleryMenu.on('slideChange', function () {
                processDeleteButton($(galleryMenu.slides[galleryMenu.activeIndex]));
            });
            galleryMenu.on('slideNextTransitionStart', function () {
                var elem = $(galleryMenu.slides[galleryMenu.activeIndex]);
                var photoId = elem.attr("data-menu-photo-id");

                updateMenuUserInfo(photoId);
            });
            galleryMenu.on('slidePrevTransitionStart', function () {
                var elem = $(galleryMenu.slides[galleryMenu.activeIndex]);
                var photoId = elem.attr("data-menu-photo-id");

                updateMenuUserInfo(photoId);
            });

            /*Navigation carusel*/

            let linksSection = jQuery('.contentNaviCarousel').length ? jQuery('.contentNaviCarousel').offset().top : 0;
            let linksHeight = jQuery('.contentNaviCarousel').length ? jQuery('.contentNaviCarousel').innerHeight() : 0;
            let topHeaderMobile = jQuery('.header-top').innerHeight();

            jQuery(document).on('scroll', function () {
                var currentPosition = jQuery(document).scrollTop();

                if (currentPosition >= linksSection) {
                    jQuery('.contentNaviCarousel').addClass('stickUp');
                    jQuery('.user-actions-phone-fixed').addClass('user-actions-phone-fixed__visible');
                }
                else {
                    jQuery('.contentNaviCarousel').removeClass('stickUp');
                    jQuery('.user-actions-phone-fixed').removeClass('user-actions-phone-fixed__visible');
                }
            });

            jQuery('.contentNaviCarousel .swiper-slide a').on('click', function (e) {
                e.preventDefault();

                var
                    href = jQuery(this).attr('href'),
                    top = jQuery(href).offset().top;

                jQuery('.contentNaviCarousel .swiper-slide a').removeClass("active");
                jQuery(this).addClass("active");
                jQuery(href).closest('.accordion_item').addClass('open');
                jQuery(href).closest('.accordion_item').find('.accordion_content').slideDown();

                jQuery('html, body').animate({
                    scrollTop: top - linksHeight - topHeaderMobile
                }, 750);

            });

        }

        function initGalleryDesctop() {
            galleryMenuThumbs = new Swiper('.popUpCarouselMenu .gallery-thumbs', {
                spaceBetween: 10,
                slidesPerView: 9,
                freeMode: true,
                watchSlidesVisibility: true,
                watchSlidesProgress: true,
            });

            galleryMenu = new Swiper('.popUpCarouselMenu .gallery-top', {
                spaceBetween: 10,
                keyboard: {
                    enabled: true,
                },
                navigation: {
                    nextEl: '.popUpCarouselMenu .swiper-button-next',
                    prevEl: '.popUpCarouselMenu .swiper-button-prev',
                },
                pagination: {
                    el: '.popUpCarouselMenu .swiper-pagination',
                    type: 'fraction',
                },
                thumbs: {
                    swiper: galleryMenuThumbs,
                }
            });
            processGalleryFirstImage(galleryMenu);

            galleryMenu.on('slideChange', function () {
                var elem = $(galleryMenu.slides[galleryMenu.activeIndex]);
                var userId = elem.attr("data-menu-user-id");
                var photoId = elem.attr("data-menu-photo-id");
                if (userId === "@User.Identity.Name") {
                    $("[data-delete-photo]").removeClass("hidden");
                }
                else $("[data-delete-photo]").addClass("hidden");
            });

            galleryMenu.on('slideNextTransitionStart', function () {
                var elem = $(galleryMenu.slides[galleryMenu.activeIndex]);
                var photoId = elem.attr("data-menu-photo-id");

                updateMenuUserInfo(photoId);
            });

            galleryMenu.on('slidePrevTransitionStart', function () {
                var elem = $(galleryMenu.slides[galleryMenu.activeIndex]);
                var photoId = elem.attr("data-menu-photo-id");

                updateMenuUserInfo(photoId);
            });

            //*Restaraunt Gallery*/
            galleryThumbs = new Swiper('.popUpCarouselRestaurant .gallery-thumbs', {
                spaceBetween: 10,
                slidesPerView: 9,
                freeMode: true,
                watchSlidesVisibility: true,
                watchSlidesProgress: true,
            });
            galleryTop = new Swiper('.popUpCarouselRestaurant .gallery-top', {
                spaceBetween: 10,
                navigation: {
                    nextEl: '.popUpCarouselRestaurant .swiper-button-next',
                    prevEl: '.popUpCarouselRestaurant .swiper-button-prev',
                },
                thumbs: {
                    swiper: galleryThumbs,
                },
            });

            /*Sticky links*/

            let linksSection = jQuery('.contentNavi').length ? jQuery('.contentNavi').offset().top : 0;
            let linksHeight = jQuery('.contentNavi').length ? jQuery('.contentNavi').innerHeight() : 0;
            let headHeight = jQuery('.header-top').innerHeight();

            jQuery(document).on('scroll', function () {
                let currentPosition = jQuery(document).scrollTop();
                //linksHeight = jQuery('.contentNavi').innerHeight();

                if (currentPosition >= linksSection) {
                    jQuery('.contentNavi').addClass('stickUp');//.css({ minHeight: linksHeight });
                }
                else {
                    jQuery('.contentNavi').removeClass('stickUp');
                }
            });

            jQuery('.contentNavi ul li a').on('click', function (e) {
                e.preventDefault();

                var
                    href = jQuery(this).attr('href'),
                    top = jQuery(href).offset().top;

                jQuery('.contentNavi ul li a').removeClass("active");
                jQuery(this).addClass("active");
                jQuery(href).closest('.table_element').addClass('visible');
                jQuery(href).closest('.table_element').find('.table_food tbody').fadeIn();
                jQuery(href).closest('.table_element').find('.found_mistake').fadeIn();

                jQuery('html, body').animate({
                    scrollTop: top - linksHeight - headHeight - 20
                }, 750);

            });

        }

        //Page onload
        jQuery(document).ready(function () {
            const localSearchParams = {
                localSearchButtonSelector: '.search-icon-button',
                localSearchContainerSelector: '.local-menu-search',
                localSearchContainerInputSelector: '.local-menu-search input',
                categoriesContainerSelector: isMobile ? '.accordion_area' : '#table_food_top',
                localSearchCloseButtonSelector: '.search-icon-button-close',
                categoriesSelector: isMobile ? '.accordion_item' : '.table_element',
                categoryItemsSelector: isMobile ? 'li[data-dish-id] a.food_list_dish' : '.table_food tbody tr .table_food_name',
                categoryItemsRowSelector: isMobile ? 'li[data-dish-id]' : '.table_food tbody tr',
                categoriesSwiperSelector: isMobile ? '.contentNaviCarousel' : '.contentNavi',
                topDishes: isMobile ? '.top_dishes_title, .popular-area' : '.top_dishes_title, .popular_dishes',
                topSectionSelector: '.topSection',
                noItemsText: TRANSLATION_NO_ITEMS
            }

            initLocalSearch(localSearchParams);
            updateUploadMenuPhotoButtons();

            /* DropDown work ours
            =======================================================*/
            jQuery('.work-hours strong em').on('click', function () {
                jQuery('.work-hours-dropdown').slideToggle();
            });

            /* Accordion for desktop content menu
            =======================================================*/
            jQuery('.table_element .table_food thead').on('click', function () {
                jQuery(this).closest('.table_element').toggleClass('visible');
                jQuery(this).closest('.table_element').find('.table_food tbody').fadeToggle();
                jQuery(this).closest('.table_element').find('.found_mistake').fadeToggle();
            });


            //Button found mistake
            jQuery('.found_mistake.pc a, .btn_find_error.pc').on('click', function (e) {
                e.preventDefault();

                if (!loggedIn) {
                    jQuery('.popUpCarousel').addClass('hidden');
                    jQuery('.popUpBlockMain').addClass('visible');
                    jQuery('.popUpReg').fadeIn();
                    return false;
                }

                var section = $(this).closest(".table_element ").find("table").attr("id");
                if (!section) section = "restaurant";
                jQuery('.popUpInfo').find("input[name=url]").val(jQuery('.popUpInfo').find("input[name=url]").val() + "#" + section);
                jQuery('.incorrect_information textarea').focus();
                jQuery('.popUpInfo').fadeIn();
            });
            jQuery('.popUpInfoClose, .popUpInfoBlackout').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpInfo').fadeOut();
            });

            //Init top swiper
            var swiper = new Swiper('.navi-carousel', {
                /*slidesPerView: 3,*/
                slidesPerView: 'auto',
                spaceBetween: 20,
                /*freeMode: true,*/
            });

            $(".accordion_area.disableOnDesktop .found_mistake a, .btn_find_error_mob").click(function(e) {
                if (!loggedIn) {
                    jQuery('.popUpCarousel').addClass('hidden');
                    jQuery('.popUpBlockMain').addClass('visible');
                    jQuery('.popUpReg').fadeIn();
                    e.preventDefault();
                }
            });

            /* popUp blocks */
            jQuery('.table_food_rating .star-rating-container .stars').on('click', function (e) {
                e.preventDefault();
                var index = jQuery(this).parent().find(".stars").index(this);

                window.dishId = $(this).closest("[data-dish-id]").attr("data-dish-id");
                if (isMobile) {
                    if (!loggedIn) {
                        jQuery('.popUpCarousel').addClass('hidden');
                        jQuery('.popUpBlockMain').addClass('visible');
                        jQuery('.popUpReg').fadeIn();
                        return false;
                    }

                    location.href = "@Url.Action("MobileRate", "Home")?dishId=" + window.dishId + "&restaurantId=" + restaurantId + "&returnUrl=" + encodeURIComponent("@($"{Context.Request.Path}{Context.Request.QueryString}")");
                    return false;
                }

                if (loggedIn) {
                    window.rating = index + 1;

                    $.ajax({
                        url: "@Url.Action("RateDish")",
                        type: "POST",
                        data: {
                            "__RequestVerificationToken": getToken(),
                            rating: window.rating,
                            restaurantId: window.restaurantId,
                            dishId: window.dishId,
                            text: ""
                        }
                    }).done(function (x) {
                        var selectedRatingElem =
                            $("tr[data-dish-id=" + window.dishId + "] .table_food_rating .star-rating-container .stars")
                                .removeAttr('class').addClass("stars").eq(x.ratingNum - 1);
                        selectedRatingElem.addClass("star_yellow");
                        if (x.ratingFloat < x.ratingNum) selectedRatingElem.addClass("star_50");
                        selectedRatingElem.prevAll().addClass("star_yellow");
                        selectedRatingElem.nextAll().addClass("star_grey");

                        var selectedUserRatingElem =
                            $("tr[data-dish-id=" + window.dishId + "] .table_food_rating .hover_rating .stars")
                                .removeAttr('class').addClass("stars").eq(x.userRating - 1);
                        selectedUserRatingElem.addClass("star_red");
                        selectedUserRatingElem.prevAll().addClass("star_red");
                        selectedUserRatingElem.nextAll().addClass("star_grey");

                        $("tr[data-dish-id=" + window.dishId + "] .table_food_count em").text(x.ratingCount);
                        $("tr[data-dish-id=" + window.dishId + "] .table_food_rating").addClass("rated");
                        $("tr[data-dish-id=" + window.dishId + "] .table_food_rating .hover_rating p").text(TRANSLATION_YOU_RATE);
                    });
                } else {
                    jQuery('.popUpBlockMain').addClass('visible');
                    jQuery('.popUpCarousel').addClass('hidden');
                    jQuery('.popUpReg').fadeIn();
                }
            });


            /*Map Blocks*/
            jQuery('[data-open-map]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible visible_map');
                jQuery('.popUpCarousel').addClass('hidden');
                jQuery('.popUpMap').fadeIn();
            });

            $(document).on("mouseover", ".table_food_rating .star-rating-container .stars", function () {
                $(this).addClass("star_hover");
                $(this).prevAll().addClass("star_hover");
                $(this).nextAll().addClass("star_not_hover");
            });

            $(".popUpStars").mouseout(function () {
                $(".popUpStars .stars").removeClass("star_hover").removeClass("star_not_hover");
            });

            $(".popUpRating .popUpStars .stars").click(function () {
                window.rating = $(".popUpRating .popUpStars .stars").index(this) + 1;
                var selectedRating = $(this);
                $(".popUpRating .stars").removeClass("star_grey").removeClass("star_yellow");
                selectedRating.addClass("star_yellow");
                selectedRating.prevAll().addClass("star_yellow");
                selectedRating.nextAll().addClass("star_grey");
            });

            $(document).on("mouseout", ".table_food_rating", function () {
                $(this).find(".stars").removeClass("star_hover").removeClass("star_not_hover");
            });

            $(".popUpRating .btn-primary").click(function (e) {
                e.preventDefault();
                jQuery('.popUpRating').hide();
                jQuery('.popUpThanks').show();

                var selectedRatingElem = $("tr[data-dish-id=" + window.dishId + "] .table_food_rating .stars").removeClass("star_grey").removeClass("star_yellow")
                    .removeClass("star_red").eq(window.rating - 1);
                selectedRatingElem.addClass("star_red");
                selectedRatingElem.prevAll().addClass("star_red");
                selectedRatingElem.nextAll().addClass("star_grey");
                var ratingText = document.getElementById("rating-text-element");
                if (ratingText) {
                    ratingText = ratingText.value;
                } else {
                    ratingText = "";
                }

                $.ajax({
                    url: "@Url.Action("RateDish")",
                    type: "POST",
                    data: {
                        "__RequestVerificationToken": getToken(),
                        rating: window.rating,
                        restaurantId: window.restaurantId,
                        dishId: window.dishId,
                        text: ratingText
                    }
                });
            });

            jQuery('.popUpReg .btn-primary').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible');
                jQuery('.popUpWindow').fadeOut();
            });

            jQuery('.popUpWindow .popUp_close, [data-popup-close]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible visible_gallery visible_map');
                jQuery('.popUpWindow').fadeOut();
            });

            jQuery('.popUpCarousel-close-block, .popUpCarousel-close').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible visible_gallery visible_map custom_gallery');
                jQuery('.popUpCarousel').addClass("hidden").removeClass('visible');
            });

            jQuery('.popUpCloser, .btn_no').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible visible_gallery visible_map');
                jQuery('.popUpWindow').fadeOut();
                jQuery('.popUpCarousel').removeClass('visible');
            });



            /* Table hidden content */

            jQuery('.table_food tbody .table_food_name h3').on('click', function () {

                if (jQuery(this).closest('tr').hasClass('visible_table_content')) {
                    jQuery(this).closest('tr').removeClass('visible_table_content');
                    jQuery(this).closest('td').find('.table_content').fadeOut();
                } else {
                    jQuery('.table_food tbody tr').removeClass('visible_table_content');
                    jQuery('.table_food .table_content').fadeOut();
                    jQuery(this).closest('tr').addClass('visible_table_content');
                    jQuery(this).closest('td').find('.table_content').fadeIn();
                }

            });



            /* Mobile accordion */

            jQuery('.accordion_area .accordion_item .accordion_title').on('click', function () {
                jQuery(this).closest('.accordion_item').toggleClass('open');
                if (jQuery(this).closest('.accordion_item').hasClass('open')) {
                    jQuery(this).closest('.accordion_item').find('.accordion_content').slideDown();
                } else {
                    jQuery(this).closest('.accordion_item').find('.accordion_content').slideUp();
                }
            });

            jQuery('.search_restaurant .icon-search').on('click', function () {
                jQuery('.mobile_content').fadeIn();
            });

            jQuery('.search_restaurant_close').on('click', function () {
                jQuery('.mobile_content').fadeOut();
            });

            //Open menu gallery
            $("[data-open-menus-photos]").click(function (e) {
                e.preventDefault();

                jQuery('.popUpBlockMain').addClass('visible visible_gallery custom_gallery');
                jQuery('.popUpCarousel').addClass("hidden").removeClass('visible');
                jQuery('.popUpCarouselMenu').removeClass('hidden');
                jQuery('.popUpCarouselMenu').addClass('visible');

                galleryMenu.slideTo(0);
                galleryMenu.update();
                processGalleryFirstImage(galleryMenu);
                if(galleryMenuThumbs) {
                    galleryMenuThumbs.update();
                }

                $(".popUpCarouselMenu .swiper-pagination-total").html(galleryMenu.slides.length);
            });

            $(document).on("click", "button[data-delete-photo]", function (e) {
                e.preventDefault();

                jQuery('.popUpConfirmationWindow').show();
                jQuery('.popUpCarouselMenu').addClass('hidden');
                jQuery('.popUpCarouselMenu').removeClass('visible');

                var id = $(".popUpCarouselMenu .gallery-top .swiper-slide-active").attr("data-menu-photo-id");
                $("[name=deleteMenuId]").val(id);
            });

            $(".btn_yes").click(function (e) {
                e.preventDefault();

                jQuery('.popUpConfirmationWindow').hide();
                jQuery('.popUpCarouselMenu').toggleClass('hidden', false);
                jQuery('.popUpCarouselMenu').toggleClass('visible', true);

                var id = $("[name=deleteMenuId]").val();

                photosCount--;
                updateUploadMenuPhotoButtons();
                $('.popUpCarouselMenu .swiper-wrapper [data-menu-photo-id="' + id + '"]').remove();
                galleryMenu.update();
                if (typeof (galleryMenuThumbs) !== "undefined") {
                    galleryMenuThumbs.update();
                }

                processDeleteButton($(galleryMenu.slides[galleryMenu.activeIndex]));

                if (galleryMenu.slides.length === 0) {
                    jQuery('.popUpCarouselMenu').toggleClass('hidden', true);
                    jQuery('.popUpCarouselMenu').toggleClass('visible', false);
                }

                $.ajax({
                    url: "@Url.Action("DeleteMenuPhoto", "Home", new { area = "" })",
                    method: "POST",
                    data: {
                        id: id
                    }
                }).done(function (x) {

                });
            });

            jQuery('.images_area a').on('click', function (e) {
                e.preventDefault();

                var index = jQuery('.images_area a').index(this) - 1;

                jQuery('.popUpBlockMain').addClass('visible visible_gallery');
                jQuery('.popUpCarousel').addClass("hidden").removeClass('visible');
                jQuery('.popUpCarouselRestaurant').removeClass('hidden');
                jQuery('.popUpCarouselRestaurant').addClass('visible');

                galleryTop.slideTo(index);
                galleryTop.update();
                galleryThumbs.update();
             });

            jQuery('.galleryBtn[data-pc]').on('click', function (e) {
                e.preventDefault();

                jQuery('.popUpBlockMain').addClass('visible visible_gallery');
                jQuery('.popUpCarousel').addClass("hidden").removeClass('visible');
                jQuery('.popUpCarouselRestaurant').removeClass('hidden');
                jQuery('.popUpCarouselRestaurant').addClass('visible');

                galleryTop.slideTo(0);
                galleryTop.update();
                galleryThumbs.update();
            });

            initFeaturedSwiper()
            initPopularSwiper()

            if (isMobile) {
                initGalleryMobile()
            } else {
                initGalleryDesctop()
            }

        });
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewData["googleMapsKey"]&callback=initMap" async defer></script>
