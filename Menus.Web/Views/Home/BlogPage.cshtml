@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer;
@model Menus.Abstract.Models.IPage

@{
    ViewData["Title"] = "Blog";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;

    var otherBlogs = ViewData["otherBlogs"] as IEnumerable<Menus.Abstract.Models.IPage>;
}


@await Html.PartialAsync("_Header")
<div class="site-content">
    <main>

        <div class="breadcrumbs breadcrumbs-content">
            <ul>
                <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Blog">@Localizer["Blog"]</breadcrumb></li>
                <li><breadcrumb href="#">@Model.Title.Get(culture)</breadcrumb></li>
            </ul>
        </div>

        <div class="site-content-align">
            <!-- BLOG single START -->
            <div class="blog_single">

                <div class="blog_single_content">

                    <div class="blog_single_info">
                        <h1>@Model.Title.Get(culture)</h1>
                        <div class="blog_single_caption">
                            <div class="blog_single_date">@Model.Timestamp.ToString("f")</div>
                            <div class="blog_single_social">
                          @*      <a href="#" class="social_facebook"></a>
                                <a href="#" class="social_twitter"></a>
                                <a href="#" class="social_telegram"></a>*@
                            </div>
                        </div>
                    </div>

                    <figure class="single_post_img">
                        <img src="@Img.Url(Model.Photo, Quality.High)" alt="" />
                    </figure>

                    <div>
                        @Html.Raw(Model.Content.Get(culture))
                    </div>

                </div>

                <div class="blog_single_aside">

                    <div class="widget widget_news">
                        <div class="widget_title">@Localizer["ReadAlso"]:</div>
                        <div class="widget_content">
                            <ul>
                                @foreach (var item in otherBlogs)
                                {
                                    <li>
                                        <a asp-controller="Home" asp-action="NewsPage" asp-route-id="@item.Url">
                                            <figure>
                                                <img src="@Img.Url(item.Photo, Quality.Medium)" alt="@item.Title.Get(culture)" title="@item.Title.Get(culture)" />
                                            </figure>
                                            <h3>@item.Title.Get(culture)</h3>
                                            <div class="widget_news_date">@item.Timestamp.ToString("f")</div>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                </div>

            </div>

            <!-- BLOG single END -->



        </div>



    </main>
</div>



@await Html.PartialAsync("_Footer")

@section Scripts
    {
    <script src="~/js/typeahead-inner.js"></script>
}