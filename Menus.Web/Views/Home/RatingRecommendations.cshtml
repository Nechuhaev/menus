                            <img src="~/images/icon_star_yellow_rec.png" alt="Alternate Text" />
                            <img src="~/images/icon_star_yellow_rec.png" alt="Alternate Text" />
                            <img src="~/images/icon_star_yellow_rec.png" alt="Alternate Text" />
