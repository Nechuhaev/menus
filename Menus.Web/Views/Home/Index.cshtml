                    @{
                        var maxNearestCounter = nearestRestaurants.Count >= 4 ? 4 : nearestRestaurants.Count;
                    }
                    @for (int nearestRestCounter = 0; nearestRestCounter < maxNearestCounter; nearestRestCounter++)
                    {
                        var restaurant = nearestRestaurants[nearestRestCounter];
                        var photos = string.IsNullOrEmpty(restaurant.Photos) ? new List<string>() : Newtonsoft.Json.JsonConvert.DeserializeObject<List<string>>(restaurant.Photos);
                        <div class="restaurant">
                            <a class="restaurant" asp-action="Restaurant" asp-route-city="@ViewData["selectedCityName"]" asp-route-id="@restaurant.Url">
                                @if (photos.Count > 0)
                                {
                                    <figure class="restaurant-image" style="background-image: url(@Img.Url(photos.FirstOrDefault(), Quality.Medium));"></figure>
                                }
                                else
                                {
                                    <figure class="restaurant-image"></figure>
                                }
                                <p class="restaurant-name">
                                    @restaurant.Name
                                    @if (restaurant.Distance != null)
                                    {
                                        <span class="restaurant-distance">@restaurant.Distance.Value.ToString("F1") km</span>
                                    }
                                </p>
                                <p class="restaurant-kitchen">
