@using System.Text.RegularExpressions
@using Menus.Abstract.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject Menus.Domain.Core Core
@inject Menus.Web.Services.LocaleService LocaleSrvc;

@inject Menus.Web.Services.UserService  UserService;
@{
    ViewData["Title"] = Localizer["MetaTitle"];
    ViewData["Description"] = Localizer["MetaDescription"];
    var user = await UserService.GetUserById(User.Identity.Name);
    var selectedCity = ViewData["selectedCity"] as ICity;
    var latestRestaurants = (ViewData["latestViewedRestaurants"] as List<ICompleteRestaurant>) ?? new List<ICompleteRestaurant>();
    var featuredRestaurants = (ViewData["featuredRestaurants"] as List<ICompleteRestaurant>) ?? new List<ICompleteRestaurant>();
    var nearestRestaurants = (ViewData["nearestRestaurants"] as List<ICompleteRestaurant>) ?? new List<ICompleteRestaurant>();
    var bestDishes = ViewData["bestDishes"] as List<ISearchDish>;

    var locales = LocaleSrvc.GetLocales();

    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;
    var isMobileUser = UserService.IsMobileUser(Context.Request);
}

<link href="~/css/swiper.min.css" rel="stylesheet" />

<header id="site-header" class="site-header header-home">

    <div class="header-top header-top-white">

        <div class="site-header--left">
            <a class="site-logo" asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="@culture">
                <img src="~/images/site_logo_dark.svg" alt="Logo" />
            </a>
        </div>

        <div class="site-header--right">
            @await Html.PartialAsync("_SignInButtons")

            @if (!isMobileUser)
            {
                @await Html.PartialAsync("_LanguagesDropdown")
            }
        </div>

    </div>

    <div class="header-bottom">
        <h1 data-search="restaurant">@Localizer["MenusOfAllRestarauns"]</h1>
        <h1 data-search="dish" class="hidden">@Localizer["DishesOfAllRestaraunts"]</h1>
        <div class="locationBlock">
            <button id="chosen-city-button">@selectedCity.Name.Get(culture)</button>
            <div id="choose-city-container" class="hidden" onclick="event.stopPropagation()">
                <div id="choose-city-container-input" class="autocomplete" style="width: auto;">
                    <input type="text" id="search_cities_input" name="search_cities_input" placeholder="@Localizer["PleaseEnterCityName"]" />
                </div>
            </div>
            <input type="hidden" name="search_cities_input_id" value="" />
        </div>
        @if (!isMobileUser)
        {
            <form class="search-form" action="@Url.Action("FindRestaurant")">
                <div data-search="restaurant" class="search-form-content">
                    <div class="autocomplete">
                        <input type="text" name="q" autocomplete="off" value="" id="search_restaurants_input" placeholder="@Localizer["SearchPlaceholder"]" />
                    </div>
                    <input type="hidden" name="q_id" value="" />
                    <button type="submit">@Localizer["Search"]</button>
                </div>
                <div data-search="dish" class="search-form-content hidden">
                    <div class="autocomplete">
                        <input type="text" name="dish_q" autocomplete="off" value="" id="search_dishes_input" placeholder="@Localizer["EnterDishName"]" />
                        <object class="loading-icon hidden" type="image/svg+xml" data="~/images/loading.svg"></object>
                    </div>
                    <input type="hidden" name="dish_q_id" value="" />
                    <button data-search-dish type="submit">@Localizer["FindDish"]</button>
                </div>
                <div class="search-form-radio">
                    <ul>
                        <li data-select-search="restaurant" class="current">@Localizer["RestarauntSearch"]</li>
                        <li data-select-search="dish">@Localizer["DishSearch"]</li>
                    </ul>
                </div>
            </form>
        }
        else
        {
            <form class="search-form mobile_search_open" action="@Url.Action("FindRestaurant")">
                <div data-search="restaurant" class="search-form-content">
                    <div class="autocomplete">
                        <input type="text" autocomplete="off" value="" placeholder="@Localizer["SearchPlaceholder"]" />
                    </div>
                    <input type="hidden" value="" />
                    <button type="submit">@Localizer["Search"]</button>
                </div>
                <div data-search="dish" class="search-form-content hidden">
                    <div class="autocomplete">
                        <input type="text" autocomplete="off" value="" placeholder="@Localizer["EnterDishName"]" />
                    </div>
                    <input type="hidden" value="" />
                    <button data-search-dish type="submit">@Localizer["FindDish"]</button>
                </div>
                <div class="search-form-radio">
                    <ul>
                        <li data-select-search="restaurant" class="current">@Localizer["RestarauntSearch"]</li>
                        <li data-select-search="dish">@Localizer["DishSearch"]</li>
                    </ul>
                </div>
            </form>
            <form class="search_restaurant locationBlock sub_search" method="get" asp-area="" asp-controller="Home" asp-action="FindRestaurant">

                <div class="mobile_search_block">
                    <span class="mobile_search_close"></span>
                    <span class="selected-city"><i class="fas fa-map-marker-alt"></i> <em>@selectedCity.Name.Get() </em></span>
                    <div data-search="restaurant" class="inner inner_restaurant">
                        <input type="text" name="q" autocomplete="off" value="" id="search_restaurants_input" placeholder="@Localizer["EnterRestarauntName"]" />
                        <input type="hidden" name="q_id" value="" />
                        <input type="submit" value="" />
                    </div>
                    <div data-search="dish" class="inner inner_dish hidden">
                        <input type="text" name="dish_q" autocomplete="off" value="" id="search_dishes_input" placeholder="@Localizer["EnterDishName"]" />
                        <object class="loading-icon hidden" type="image/svg+xml" data="~/images/loading.svg"></object>
                        <a href="javascript:void(0);" target="_blank" class="view-all-dish-search-result-top view-all-dishes-button">
                            <object class="view-all-icon" type="image/svg+xml" data="~/images/viewall.svg"></object>
                        </a>
                        <input type="hidden" name="dish_q_id" value="" />
                        <input type="submit" value="" />
                        <div class="view-all-dish-search-result">
                            <a href="javascript:void(0);" target="_blank" class="view-all-dishes-button">@Localizer["ViewAllDishes"]</a>
                        </div>
                    </div>
                    <div class="search_restaurant-radio">
                        <ul>
                            <li data-select-search="restaurant" class="current">@Localizer["RestarauntSearch"]</li>
                            <li data-select-search="dish">@Localizer["DishSearch"]</li>
                        </ul>
                    </div>
                </div>

            </form>
        }
    </div>

</header>

