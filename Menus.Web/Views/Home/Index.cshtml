    <div class="popUpBlock_inner">

        <div class="popUpWindow popUpClosestRestaurants pop-up-text-left">
            <span class="popUp_close"></span>
            <div data-restaurant-helper-result class="hidden">
                <div class="popUpTitle">@Localizer["MayBeYouAreAtTheCurrentPlace"]</div>
                <ul id="nearest-restaurants"></ul>
                <a class="view-all-nearest" href="@Url.Action("Nearest", "Home")" style="display: none;">@Localizer["ShowNearbyPlaces"]</a>
            </div>
            <div data-restaurant-helper-enable class="hidden">
                <div class="popUpTitle">@Localizer["AllowGeolocation"]</div>
                <object class="loading-icon" type="image/svg+xml" data="~/images/loading.svg"></object>
                <div class="description">
                    <p>@Localizer["AllowGeolocationDescription1"]</p>
                    <p>@Localizer["AllowGeolocationDescription2"]</p>
                </div>
            </div>
            <div data-restaurant-helper-loading class="hidden">
                <div class="popUpTitle">@Localizer["LoadingNearestRestaraunts"]</div>
                <object class="loading-icon" type="image/svg+xml" data="~/images/loading.svg"></object>
            </div>
            <div data-restaurant-helper-error class="hidden">
                <div class="popUpTitle">@Localizer["ErrorGeolocationTurnedOff"]</div>
                <div class="description">
                    <p>@Localizer["YouPreventTipMyMenuOfUsingGeolocation1"]</p>
                    <p>@Localizer["YouPreventTipMyMenuOfUsingGeolocation2"]</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="btn_nearest_restaurants" class="ab-test-button">
    <img src="~/images/icon_nearest_restaurants.png" alt="" />
    <div>@Localizer["RestarauntsNearMe"]</div>
</div>

@section Scripts {
    <script src="~/js/jquery.js"></script>
    <script src="~/js/swiper.min.js"></script>
    <script>
        //transplation constants
        const NO_ANY_NEARBY_RESTARAUNT = '@Localizer["NoAnyNearbyPlace"]';
        var cities = @Html.Raw(ViewData["cities"]);
        var selectedCity = "@selectedCity.Id";
    </script>
    <script src="~/js/typeahead.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            //hide return top buttn
            $("#toTop").addClass("hidden");
            //init swiper
            var swiper = new Swiper('.swiper-container', {
                slidesPerView: 2,
                spaceBetween: 20,
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
            });

            params = {
                searchSelectRadioButtonDataAttribute: 'data-select-search',
                searchSelectContainerAttribute: 'data-search',
                findRestaurantsPath: '@Url.Action("FindRestaurant", "Home", new { culture = culture })',
                findDishesPath: '@Url.Action("SearchDish", "Home", new { culture = culture })',
                formSelector: 'form.search_restaurant, form.search-form',
                dishQueryDataAttribute: 'dish_q',
                buttonSeachDishSelector: '[data-search-dish]',
                formContentSelector: '.search-form-content',
                viewAllDishesSelector: '.view-all-dishes-button',
            }
            initSearchEvents(params);
            loadMainPageBannerAbTest();
        });


        //Restaurant nearest search
        $("#btn_nearest_restaurants").click(function(e) {
            e.preventDefault();

            $('.popUpBlockMain').addClass('visible');
            $(".popUpClosestRestaurants").fadeIn();
            $("[data-restaurant-helper-enable]").removeClass("hidden");

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    $(".popUpClosestRestaurants > div").addClass("hidden");
                    $("[data-restaurant-helper-loading]").removeClass("hidden");

                    setCoordinates(position)
                    setDishSearchOrder(SORT_ORDER_DISTANCE)

                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;

                    setCookie(".Menus.UserLatitude", lat, 5);
                    setCookie(".Menus.UserLongitude", lon, 5);

                    $.ajax({
                        url: "@Url.Action("FindNearestRestaurants")",
                        type: "GET",
                        data: {
                            lat: lat,
                            lon: lon
                        }
                    }).done(function(x) {
                        if (x.length < 10) {
                            $(".popUpClosestRestaurants .popUpTitle").text(NO_ANY_NEARBY_RESTARAUNT);
                            $("#nearest-restaurants").remove();
                        }

                        if (x.length < 10) {
                            $('.view-all-nearest').hide();
                        } else {
                            $('.view-all-nearest').show();
                        }

                        $(".popUpClosestRestaurants > div").addClass("hidden");
                        $("[data-restaurant-helper-result]").removeClass("hidden");

                        $("#nearest-restaurants").empty().append(x);
                    });
                }, function() {
                    $(".popUpClosestRestaurants > div").addClass("hidden");
                    $("[data-restaurant-helper-error]").removeClass("hidden");
                });
            }
        });

        $(".do_not_offer a").click(function(e) {
            e.preventDefault();
            $(".do_not_offer").addClass("hidden");
            $(".popUpClosestRestaurants .are_you_sure").removeClass("hidden");
        });

        $(".popUpClosestRestaurants .are_you_sure .btn_yes").click(function(e) {
            e.preventDefault();

            localStorage.setItem("closestRestaurantsDisable", "true");
            $('.popUpBlock').removeClass('visible');
            $(".popUpClosestRestaurants").fadeOut();
        });

        $(".popUpClosestRestaurants .are_you_sure .btn_no").click(function(e) {
            e.preventDefault();

            $(".do_not_offer").removeClass("hidden");
            $(".popUpClosestRestaurants .are_you_sure").addClass("hidden");
        });

        //Profile events

        jQuery('.profile_close').on('click', function () {
            jQuery('.js-mobile-profile').removeClass('active');
        });

        function loadMainPageBannerAbTest() {
            const testName = 'mainPageBanner';
            const currentIdTestResult = getLastAbTestAccess(testName)

            if (!currentIdTestResult) {
                const ABTEST_NAMES = {
                    withBanner: 'withBanner',
                    withoutBanner: 'withoutBanner',
                    withoutBannerOldButton: 'withoutBannerOldButton'
                }
                const url = `@Url.Action("GetAbTest")?name=${testName}`;
                $.ajax({
                    url: url,
                    type: "GET",
                }).done(function (abTest) {
                    if (abTest) {
                        const {
                            name
                        } = abTest;
                        setLastAbTestAccess(testName);

                        if (name === ABTEST_NAMES.withBanner) {
                            runABTestWithBanner();
                        }
                        if (name === ABTEST_NAMES.withoutBanner) {
                            runABTestWithoutBanner();
                        }
                        if (name === ABTEST_NAMES.withoutBannerOldButton) {
                            runABTestWithoutBannerOldButton();
                        }
                    }
                });
            }
        }

        function runABTestWithBanner() {
            const $container = $('.popUpBlockMain .popUpBlock_inner');
            const withTipMyMenuYouCan = '@Localizer["WithTipMyMenuYouCan"]';
            const youCanViewMenu = '@Localizer["YouCanViewMenu"]';
            const youCanAddPhoto = '@Localizer["YouCanAddPhoto"]';
            const youCanRateViewDish = '@Localizer["YouCanRateViewDish"]';
            const youCanRateDish = '@Localizer["YouCanRateDish"]';
            const letGo = '@Localizer["LetGo"]';

            const bannersMarkup = `
                <div class="popUpWindow popUpAbTestBanner">
                    <span class="popUp_close"></span>
                    <div data-restaurant-helper-result">
                        <div class="popUpTitle">${withTipMyMenuYouCan}</div>
                        <ul id="nearest-restaurants">
                            <li class="restaurant-menu">
                                ${youCanViewMenu}
                            </li>
                            <li class="restaurant-dish">
                                ${youCanRateViewDish}
                            </li>
                            <li class="add-photo">
                                ${youCanRateDish}
                            </li>
                            <li class="rate-dish">
                                ${youCanAddPhoto}
                            </li>
                        </ul>
                        <a href="#" class="btn-primary btn-primary--fill btn-lets-go">
                            ${letGo}
                        </a>
                    </div>
                </div>
            `;

            $container.append(bannersMarkup);
            $('.popUpBlockMain').addClass('visible');
            $(".popUpAbTestBanner").fadeIn();

            jQuery('.btn-lets-go, .popUpAbTestBanner .popUp_close').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible');
                jQuery('.popUpWindow').fadeOut();
            });
        }

        function runABTestWithoutBanner() {
            //optional
        }

        function runABTestWithoutBannerOldButton() {
            //optional
        }
    </script>
}
