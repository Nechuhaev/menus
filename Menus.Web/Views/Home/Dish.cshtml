@using Menus.Abstract.Models
@model Menus.Abstract.Models.IDishWithSeoAndRatings
@inject Menus.Web.Services.UserService  UserService;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer;
@inject Menus.Domain.Core Core
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var restaurant = ViewData["restaurant"] as Menus.Abstract.Models.IRestaurant;
    var restaurantInfo = ViewData["restaurantInfo"] as Menus.Abstract.Models.IRestaurantInfo;
    var photos = ViewData["photos"] as List<string>;
    var menu = ViewData["menu"] as Menus.Web.Models.ViewModels.DishesListViewModel;
    var ratings = ViewData["ratings"] as IEnumerable<Menus.Web.Models.DishRatingWithUser>;
    var page = (int)ViewData["page"];
    ratings = ratings.Where(x => !string.IsNullOrEmpty(x.Text)).Skip(page * 12).Take(12);

    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;

    // Місто ресторану, а не вибране відвідувачем (cookie): інакше в описі й посиланнях завжди «kyiv»
    var restaurantCity = ViewData["restaurantCity"] as Menus.Abstract.Models.ICity;
    var restaurantCitySlug = restaurantCity?.Name.Get("en").ToLower() ?? ViewData["selectedCityName"] as string;
    ViewData["Title"] = string.Format(Localizer["MetaTitle"].Value, Model.Name.Get(culture), restaurant.Name, restaurantCity?.Name.Get(culture) ?? restaurantCitySlug);
    ViewData["Description"] = string.Format(Localizer["MetaDescription"].Value, Model.Name.Get(culture), restaurant.Name, restaurantCity?.Name.Get(culture) ?? restaurantCitySlug);

    var url = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";

    var imgAlt = $"{Localizer["Photo"].Value} {Model.Name.Get(culture)} {Localizer["In"].Value} {restaurant.Name}";
    var crq = Context.Request;

    var images = ViewData["images"] as IEnumerable<IDishPhoto>;
    var similarDishes = ViewData["similarDishes"] as List<IDishWithSeoAndRatings>;

    var review = ViewData["review"] as IRating;
    var isMobile = UserService.IsMobileUser(Context.Request);
    var isDesktop = !UserService.IsMobileUser(Context.Request);
}

@await Html.PartialAsync("_Header")

<div class="site-content">
    <main>
        <div class="breadcrumbs breadcrumbs-content breadcrumbs-content-position">
            <ul>
                <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                <li><breadcrumb asp-action="Restaurant" asp-route-city="@restaurantCitySlug" asp-route-id="@ViewData["restaurantId"]">@restaurant.Name</breadcrumb></li>
                <li><breadcrumb href="#">@(Char.ToUpper(Model.Name.Get(culture)[0]) + Model.Name.Get(culture).Substring(1))</breadcrumb></li>
            </ul>
        </div>

        <div class="site-content-align" itemscope>
            <div class="btn-view-full-restaurant-menu">
                <a class="btn-view-full-restaurant-menu-link" href="@Url.Action("Restaurant", "Home", new {id = Model.RestaurantId})" title="@Localizer["ViewFullRestaurantMenu"] @restaurant.Name">
                    @Localizer["ViewFullRestaurantMenu"] @restaurant.Name
                </a>
            </div>

            @await Html.PartialAsync("_GoogleSence",
                    new Menus.Web.Models.Internal.GoogleSence() {
                        GoogleSenceType = Menus.Web.Models.Internal.GoogleSenceTypes.Wide
                    })

            <div class="dishSingle">

                <div class="dishSingleLeft">

                    @if (isDesktop)
                    {
                        <article>
                            <div class="article_top">
                                <div class="article_top_left">
                                    <h1 itemprop="name">@Model.Name.Get(culture)</h1>
                                    <div class="food_info">
                                        <h2>
                                            @if (Model.IsPriceMultiple)
                                            {
                                                <span>@Localizer["From"]&nbsp;</span>
                                            }
                                            @restaurantInfo.Currency @Model.Price.ToString("F2")
                                        </h2> | @Model.Weight @Model.WeightType
                                    </div>
                                </div>
                                <div class="article_top_right">
                                    <div class="article_data">
                                        <div class="article_rating">
                                            @if (Model.UserRating > 0)
                                            {
                                                for (var i = 1; i <= 5; i++)
                                                {
                                                    if (i <= Model.UserRating)
                                                    {
                                                        <span class="stars star_red"></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="stars star_grey"></span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                @await Html.PartialAsync("_StarRating", Model.RatingFloat)
                                            }
                                        </div>
                                    </div>
                                    <span class="food_value">@Model.RatingFloat.ToString("F1")</span>
                                    <span class="food_count"><em>@Model.RatingCount</em> @Localizer["Rates"]</span>
                                </div>
                            </div>

                            <div class="article_description" itemprop="description">
                                @Model.Description.Get(culture)
                            </div>

                            @if (!Model.Ingredients.IsEmpty() || !Model.ShortDescription.IsEmpty())
                            {
                                <div class="article_ingredients">
                                    <h2>@Localizer["Composition"]:</h2>
                                    <p>@(Model.Ingredients.IsEmpty() ? Model.ShortDescription.Get(culture) : Model.Ingredients.Get(culture))</p>
                                </div>
                            }

                            @{
                                var numberOfPhotos = Model.Photos.Count() < 4 ? Model.Photos.Count() : 4;
                                var additionalClass = numberOfPhotos == 0 ? "article_photos_one" : "";
                            }

                            <div class="article_photos @additionalClass">
                                <!-- for one image add class "article_photos_one" -->
                                @for (int photoCounter = 0; photoCounter < numberOfPhotos; photoCounter++)
                                {
                                    <div class="dish-photo" style="background-image: url(@Img.Url(Model.Photos.Skip(photoCounter).First(), Quality.Medium));">
                                        <img itemprop="image" src="@Img.Url(Model.Photos.Skip(photoCounter).First(), Quality.Medium)" alt="@imgAlt" title="@imgAlt" data-image-id="@Model.Photos.Skip(photoCounter).First()" />
                                    </div>
                                }
                                <div class="add-dish-photo">
                                    <label data-upload-photo for="photo-upload-input" style="display: block; width: 100%; height: 100%; cursor: pointer;">
                                        Добавить фото
                                    </label>
                                    <a style="display: none;" data-show-photos href="#">@Localizer["ViewAllPhotos"]</a>
                                </div>
                            </div>

                        </article>
                    }
                    else
                    {
                        <article class="mobileDish">
                            <div class="mobileDishTop">
                                <h1 itemprop="name">@Model.Name.Get(culture)</h1>
                                <span class="mobileDishData">
                                    @if (Model.IsPriceMultiple)
                                    {
                                        <span>@Localizer["From"]&nbsp;</span>
                                    }
                                    @restaurantInfo.Currency @Model.Price.ToString("F2") <span>| @Model.Weight @Model.WeightType</span>
                                </span>
                                <span class="mobileDishRating">
                                    <span class="dish_rate_star" asp-rate="Model.Rating"></span> <em>@Model.RatingFloat.ToString("F1")</em>
                                    <br />
                                    <span class="food_count"><em>@Model.RatingCount</em> @Localizer["Rates"]</span>
                                </span>
                            </div>
                            <div class="mobileDishPicture">
                                @if (Model.Photos.Any())
                                {
                                    <img itemprop="image" src="@Img.Url(Model.Photos.First(), Quality.Medium)" alt="@imgAlt" title="@imgAlt" />
                                }
                                else
                                {
                                    <label data-upload-photo for="photo-upload-input"><img src="~/images/image_add_img_mobile.png" alt="@imgAlt" title="@imgAlt" /></label>
                                }
                                @if (Model.Photos.Any())
                                {
                                    <div class="mobile-dish-picture-data">
                                        <span class="picture-data-icon"></span>
                                        <span class="picture-data-count">1 / @Model.Photos.Count()</span>
                                    </div>
                                }
                            </div>
                            <div class="mobileDishRate">
                                @if (Model.UserRating > 0)
                                {
                                    <em>@Localizer["YourRate"]</em>
                                }
                                else
                                {
                                    <em>@Localizer["RateDish"]!</em>
                                }
                                <span class="mobileStarsRate">
                                    @if (Model.UserRating > 0)
                                    {
                                        for (var i = 1; i <= 5; i++)
                                        {
                                            if (i <= Model.UserRating)
                                            {
                                                <span class="stars star_red"></span>
                                            }
                                            else
                                            {
                                                <span class="stars star_grey"></span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="stars star_grey"></span>
                                        <span class="stars star_grey"></span>
                                        <span class="stars star_grey"></span>
                                        <span class="stars star_grey"></span>
                                        <span class="stars star_grey"></span>
                                    }
                                </span>
                                <a href="#" data-rate-dish>@Localizer["WriteReview"]</a>
                            </div>
                        </article>
                    }

                    <div class="social_area">
                        <p>@Localizer["ShareDishWithYourFriends"]</p>
                        <ul>
                            <li><a rel="noopener" target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(url)"><span class="fa-fw select-all fab"></span></a></li>
                            <li><a href="mailto:?subject=Tipmymenu share&amp;body=Check out this page: @url"><span class="fa-fw select-all fas"></span></a></li>
                        </ul>
                    </div>

                    <div class="reviews">
                        @if (ratings.Count() > 0 || !UserService.IsMobileUser(Context.Request))
                        {
                            <div class="reviews_top">
                                <div class="reviews_top_left">
                                    <h2>@Localizer["UsersRates"] <span class="reviews_counter">(@ratings.Count())</span></h2>
                                    @if (ratings.Count() == 0 && !UserService.IsMobileUser(Context.Request))
                                    {
                                        <span class="review_first">@Localizer["BecomeFirstWhoWillAddReview"]</span>
                                    }
                                </div>
                                <div class="reviews_top_right">
                                    @if (review != null && !string.IsNullOrEmpty(review.Text))
                                    {
                                        <a href="#" data-rate-dish>@Localizer["EditReview"]</a>
                                    }
                                    else
                                    {
                                        <a href="#" data-rate-dish>@Localizer["AddReview"]</a>
                                    }
                                </div>
                            </div>
                        }

                        <div class="reviews_content">
                            <ul class="reviews_list" data-load-more-container>
                                @await Html.PartialAsync("_DishRatingsAjax", Model)
                            </ul>
                            <div class="reviews_link_all">
                                @if (!UserService.IsMobileUser(Context.Request) && ratings.Count() == 12)
                                {
                                    <a data-load-more href="#">@Localizer["LoadMore"]</a>
                                }
                                else if (ratings.Count() == 12)
                                {
                                    <a data-load-more href="#">@Localizer["LoadMore"]</a>
                                }
                            </div>

                            @if (ratings.Count() == 0 && UserService.IsMobileUser(Context.Request))
                            {
                                <div class="no_reviews">
                                    <strong>@Localizer["BecomeFirstWhoWillAddReview"]</strong>
                                    <a href="#" data-rate-dish>@Localizer["WriteReview"]</a>
                                </div>
                            }

                        </div>

                    </div>

                    @await Html.PartialAsync("_GoogleSence",
                    new Menus.Web.Models.Internal.GoogleSence() {
                        GoogleSenceType = Menus.Web.Models.Internal.GoogleSenceTypes.Wide
                    })

                    @if (similarDishes.Any())
                    {
                        <h2 class="top_dishes_title">@Localizer["OtherDishes"]</h2>

                        <ul class="list_of_dishes">
                            @foreach (var dish in similarDishes)
                            {
                                <li>
                                    <div class="caption">

                                        <div class="caption_image">
                                            <figure>
                                                @if (dish.Photos.Any())
                                                {
                                                    <a href="@Url.Action("Dish", "Home", new {id = ViewData["restaurantId"], dishId = dish.Url})" style="background-image: url(@Img.Url(dish.Photos.First(), Quality.Low))"></a>
                                                    @*<figcaption>@Localizer["Advertisment"]</figcaption>*@
                                                }
                                            </figure>
                                        </div>

                                        <div class="caption_content">
                                            <h3><a href="@Url.Action("Dish", "Home", new {id = ViewData["restaurantId"], dishId = dish.Url})">@dish.Name.Get()</a></h3>
                                            <p class="excerpt">@dish.ShortDescription.Get(culture)</p>
                                            <p class="dish_info">
                                                <strong>@dish.RatingFloat.ToString("F1")</strong>
                                                @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                <em>(@dish.RatingCount)</em>
                                            </p>
                                            <p class="location">@restaurant.Name, @restaurant.Address <b>0.9 км</b></p>
                                        </div>

                                        <div class="caption_info">
                                            <span class="price">₴ @dish.Price.ToString("F2")</span>
                                            <span class="weight">@dish.Weight @dish.WeightType</span>
                                        </div>

                                    </div>
                                </li>
                            }
                        </ul>
                    }

                </div>


                @if (!UserService.IsMobileUser(Context.Request))
                {
                    <div class="dishSingleRight">
                        <div class="restaurant-menu">
                            @foreach (var category in menu.Categories)
                            {
                                <div class="restaurant-menu-category">
                                    <div class="header">@(((Menus.Abstract.Models.IMenuCategory)category).Name.Get(culture))</div>
                                    <div class="items" style="display: none;">
                                        @foreach (var dish in category.Dishes)
                                        {
                                            <div class="item">
                                                <div class="item-title">
                                                    <a href="@Url.Action("Dish", "Home", new { id = ViewData["restaurantId"], dishId = dish.Url })">
                                                        @(Char.ToUpper(dish.Name.Get(culture)[0]) + dish.Name.Get(culture).Substring(1))
                                                    </a>
                                                    <span>@restaurantInfo.Currency @dish.Price.ToString("F2")</span>
                                                </div>
                                                <div class="item-rating">
                                                    <span>
                                                        @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                    </span>
                                                    <strong>@dish.RatingFloat.ToString("F1")</strong>
                                                    @dish.RatingCount @Localizer["Rates"]
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                        </div>

                    </div>
                }

            </div><!-- .dishSingle -->

        </div>
    </main>
</div>

@await Html.PartialAsync("_Footer")
@await Html.PartialAsync("_PcPhotoUpload", ViewData)

<div class="popUpBlock popUpBlockMain">
    <div class="popUpCloser"></div>
    <div class="popUpBlock_inner">

        <!-- PopUp registered users -->

        <div class="popUpWindow popUpReg">
            <span class="popUp_close"></span>
            <figure>
                <img src="~/images/popUpImg_01.jpg" alt="@imgAlt" title="@imgAlt" />
            </figure>
            <div class="popUpText">@Localizer["OnlyRegisteredUser"] <span>@Localizer["CanRateDishOrAddPhoto"]</span></div>
            <div class="popUpLinks">
                <a href="#" class="btn-primary" data-sign-in>@Localizer["Login"]</a>
                <a href="#" class="btn-primary btn-primary--fill" data-sign-up>@Localizer["Signup"]</a>
            </div>
        </div>



        <!-- PopUp rating -->

        <div class="popUpWindow popUpRating" data-dish-id="">
            <span class="popUp_close"></span>
            <div class="popUpTitle">@Localizer["RateDish"]!</div>
            <div class="popUpStars">
                <span class="stars star_grey"></span>
                <span class="stars star_grey"></span>
                <span class="stars star_grey"></span>
                <span class="stars star_grey"></span>
                <span class="stars star_grey"></span>
            </div>
            <div>
                <textarea class="form-control" rows="3" id="rating-text-element">@(review?.Text)</textarea>
            </div>
            <div class="popUpLinks">
                @if (review != null && !string.IsNullOrEmpty(review.Text))
                {
                    <a href="#" class="btn-primary btn-primary--fill btn-process-review">
                        @Localizer["EditReview"]
                    </a>
                }
                else
                {
                    <a href="#" class="btn-primary btn-primary--fill btn-process-review">
                        @Localizer["AddReview"]
                    </a>
                }
            </div>
        </div>


        <!-- PopUp thank you -->

        <div class="popUpWindow popUpThanksRating">
            <span class="popUp_close"></span>
            <figure class="extra">
                <img src="~/images/popUpImg_02.jpg" alt="@imgAlt" title="@imgAlt" />
            </figure>
            <div class="rating-loading">
                <object class="loading-icon" type="image/svg+xml" data="~/images/loading.svg"></object>
            </div>
            <div class="rating-text">
                <div class="popUpTitle">@Localizer["ThankYouForYourRate"]!</div>
                <div class="popUpText extra">@Localizer["YouHelpedOtherUsers"]<br /><span>@Localizer["ToMakeRightChoice"]</span></div>
                <div class="popUpLinks">
                    <a href="javascript:void()" class="btn-primary btn-primary--fill" data-popup-close>@Localizer["Continue"]</a>
                </div>

                <div class="popupReturnLink">
                    <a href="@Url.Action("Restaurant", "Home", new {id = ViewData["restaurantId"]})">@Localizer["ReturnToMenu"]</a>
                </div>
            </div>
        </div>

        <div class="popUpWindow popUpRateIt">
            <span class="popUp_close"></span>
            <figure class="popUpHands">
                <img src="~/images/popup_hands.png" alt="" />
            </figure>
            <div class="popUpTitle">@Localizer["DontForgetToRateDish"]</div>
            <p>@Localizer["YouAreHelpingOtherPeopleToMakeRightChoice"]</p>
            <figure class="popup_stars">
                <img src="~/images/popup_stars.png" alt="" />
            </figure>
            <figure class="popup_big_hand">
                <img src="~/images/popup_big_hand.png" alt="" />
            </figure>
        </div>

        <div class="popUpWindow popup-thank-you-rating">
            <span class="popUp_close"></span>
            <figure class="popup-image">
                <img src="~/images/popup_thanks.png" alt="" />
            </figure>
            <div class="popup-title">@Localizer["ThankYouForYourRate"]!</div>
            <p>@Localizer["YouAreHelpingOtherPeopleToMakeRightChoice"]</p>
            <div class="popup-links">
                <a href="@url" class="btn-primary btn-primary--fill">@Localizer["Continue"]</a>
                <span><a href="#">@Localizer["ReturnToMenu"]</a></span>
            </div>
        </div>

        <!-- PopUp delete -->

        <div class="popUpWindow popUpConfirmationWindow">
            <span class="popUp_close"></span>
            <div class="popUpTitle">@Localizer["AreYouSure"]<br />@Localizer["YouWantToDeletePhoto"]</div>

            <div class="are_you_sure">
                <a href="#" class="btn_yes">@Localizer["Yes"]</a>
                <a href="#" class="btn_no">@Localizer["No"]</a>
            </div>

            <input type="hidden" name="deleteMenuId" value="" />
        </div>

        <!-- PopUp carousel -->

        <div class="popUpCarousel popUpCarouselMenu popUpCarouselMenuNew fullHeight">
            <div class="popUpCarousel-close-block">
                <span class="popUpCarousel-close">x</span>
            </div>

            <div class="popUpCarouselMenu-content">

                <div class="menu-user-info">

                </div>

                <!-- Swiper -->
                <div class="swiper-container gallery-top">
                    <div class="swiper-wrapper">
                        @foreach (var photo in Model.Photos)
                        {
                            var image = images.FirstOrDefault(x => x.ImageUrl == photo);
                            if (image != null)
                            {
                                <div data-menu-photo-id="@image.Id" data-menu-user-id="@image.UserId" class="swiper-slide" style="background-image: url(@Img.Url(photo, Quality.High))">
                                </div>
                            }
                            else
                            {
                                // Фото без запису в DishPhotos (додані content-bot або адміном): показуємо без кнопки видалення
                                <div class="swiper-slide" style="background-image: url(@Img.Url(photo, Quality.High))">
                                </div>
                            }

                        }
                    </div>
                    <!-- Add Pagination -->
                    <div class="swiper-pagination"></div>
                </div>

            </div>

            <div class="popUpCarouselMenu-buttons">
                <label data-upload-photo for="photo-upload-input"><i class="fas fa-camera"></i><span>@Localizer["AddOneMore"]</span></label>
                <button data-delete-photo type="button"><i class="far fa-trash-alt"></i><span>@Localizer["Delete"]</span></button>
            </div>

            <!-- Add Arrows -->
            @if (!UserService.IsMobileUser(Context.Request))
            {
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            }
        </div>

    </div>
</div>

@section JsonLd {
    @{
        var ldPageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var ldHomeUrl = Url.Action("Index", "Home", null, Context.Request.Scheme);
        var ldRestaurantUrl = Url.Action("Restaurant", "Home", new { city = restaurantCitySlug, id = ViewData["restaurantId"] }, Context.Request.Scheme);
        var ldDishName = Model.Name.Get(culture);
        var ldDescription = Model.ShortDescription?.Get(culture);
        if (string.IsNullOrWhiteSpace(ldDescription)) { ldDescription = Model.Description?.Get(culture); }
    }
    @(Menus.Web.Helpers.JsonLd.Script(
        Menus.Web.Helpers.JsonLd.Product(
            ldDishName, ldPageUrl,
            Model.Photos != null && Model.Photos.Any() ? Img.Url(Model.Photos.First(), Quality.High) : null,
            ldDescription, restaurant.Name,
            Model.Price, restaurantInfo.Currency, Model.RatingFloat, Model.RatingCount),
        Menus.Web.Helpers.JsonLd.Breadcrumbs(("TipMyMenu", ldHomeUrl), (restaurant.Name, ldRestaurantUrl), (ldDishName, ldPageUrl))))
}

@section Scripts
    {
    <!-- Initialize Swiper -->

    <script src="~/js/jquery.js"></script>
    <script src="~/js/swiper.min.js"></script>
    <script>
        let TRANSLATION_YOU_RATE = `@Localizer["YourRate"]`;
        let TRANSLATION_YOU_CANT_ADD_REVIEW_WITHOUT_RATE = `@Localizer["YouCantAddReviewWithoutRate"]`;

        window.customViewMode = 3;
        var cityId = "@ViewData["selectedCity"]";
        var allowRateDishAnonymous = @ViewData["AllowRateDishAnonymous"].ToString().ToLower();
        var dishRating = @Model.Rating;

        var loggedIn = @User.Identity.IsAuthenticated.ToString().ToLower();
        var restaurantId = "@restaurantInfo.RestaurantId";
        window.rating = @Model.UserRating;

        var lat = "@restaurantInfo.GpsLatitude";
        var lon = "@restaurantInfo.GpsLongitude";

        var dataLoadMorePage = 0;

        var galleryTop;
    </script>
    <script src="~/js/typeahead-inner.js"></script>

    <script>
        //--Page load--
        $(document).ready(function () {
            //--Init bot gallery--
            if (isMobile) {
                initMobileGallery();
                initSetMobileRating();
            } else {
                initDesktopGallery();
                initDesktopRestaurantsSideList();
                initSetDesktopRating();
            }

            initDeletePhoto();
            initUpdateRatingAndReview();
            initRegistrtionPopup();
            initLoadMore();
        });

        function initMobileGallery() {
            initMobileSlider();
            initGalleryOnSlideChange();
            initGalleryOnImageClick();
            initGalleryOnCloseClick();
            initGalleryShowAllButton();
            initGalleryOtherFunctions();
        }

        function initDesktopGallery() {
            initDesktopSlider();
            initGalleryOnSlideChange();
            initGalleryOnImageClick();
            initGalleryOnCloseClick();
            initGalleryShowAllButton();
            initGalleryOtherFunctions();
        }

        function initDesktopSlider() {
            galleryTop = new Swiper('.popUpCarousel .gallery-top', {
                spaceBetween: 10,
                navigation: {
                    nextEl: '.popUpCarousel .swiper-button-next',
                    prevEl: '.popUpCarousel .swiper-button-prev',
                },
                pagination: {
                    el: '.popUpCarousel .swiper-pagination',
                    type: 'fraction',
                },
                keyboard: {
                    enabled: true,
                },
                init: () => {
                    const $slide = $(galleryTop.slides[0]);
                    processDeleteButton($slide);
                }
            });
        }

        function initMobileSlider() {
            galleryTop = new Swiper('.popUpCarousel .gallery-top', {
                spaceBetween: 10,
                navigation: {
                    nextEl: '.popUpCarousel .swiper-button-next',
                    prevEl: '.popUpCarousel .swiper-button-prev',
                },
                pagination: {
                    el: '.popUpCarousel .swiper-pagination',
                    type: 'fraction',
                },
                keyboard: {
                    enabled: true,
                },
                init: () => {
                    const $slide = $(galleryTop.slides[0]);
                    processDeleteButton($slide);
                }
            });
        }

        function initGalleryShowAllButton() {
            jQuery("[data-show-photos]").click(function (e) {
                e.preventDefault();
                let numberOfPhotos = galleryTop.slides.length;

                if (numberOfPhotos > 0) {
                    jQuery('.popUpBlockMain').addClass('visible visible_gallery');
                    jQuery('.popUpCarousel').removeClass('hidden');
                    jQuery('.popUpCarousel').addClass('visible');

                    galleryTop.slideTo(0);
                    galleryTop.update();

                    $(".popUpCarouselMenu .swiper-pagination-total").html(galleryTop.slides.length);
                }
            });
