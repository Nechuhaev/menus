@using System.Text.RegularExpressions
@using Microsoft.Extensions.Configuration
@inject Menus.Web.Services.UserService  UserService;
@inject IConfiguration Configuration;
@{
    var crq = Context.Request;
    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;
    bool isIphone = @UserService.IsIphone(Context.Request);
    string additionalBodyClass = isIphone ? "iphone-in-use" : "";
    var robots = ViewData["Robots"] ?? Configuration["Meta:Robots"];
    var isTestMode = Convert.ToBoolean(Configuration[$"GoogleSenceTestModeOn"] != null ? Configuration[$"GoogleSenceTestModeOn"] : "false");
    var testModeValue = isTestMode ? "on" : "off";
    var baseUrl = $"http{(crq.IsHttps ? "s" : "")}://{crq.Host}";
    // Canonical без query string (utm, sort тощо), крім пагінації
    var pageParam = crq.Query["page"].ToString();
    var canonical = ViewData["Canonical"] as string
        ?? $"{baseUrl}{crq.Path}{(!string.IsNullOrEmpty(pageParam) && pageParam != "0" ? "?page=" + System.Net.WebUtility.UrlEncode(pageParam) : "")}";
    var ogLocale = culture == "uk" ? "uk_UA" : culture == "ru" ? "ru_RU" : "en_US";
    var isMobileUser = UserService.IsMobileUser(Context.Request);
    // запасне обмеження для всіх сторінок; сторінки ресторанів і страв підбирають коротший варіант самі
    var metaDescription = Menus.Web.Helpers.SeoText.Truncate(Menus.Web.Helpers.SeoText.AsText(ViewData["Description"]), Menus.Web.Helpers.SeoText.DescriptionMax);
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="@culture" lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"
          data-content-zoomable="width=device-width, initial-scale=1.0"
          data-content-non-zoomable="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="format-detection" content="address=no">
    <meta name="description" content="@metaDescription" />
    <title>@ViewData["Title"]</title>

    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonical" />
    @await Html.PartialAsync("_AlternativeLinks")
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@ogLocale" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:site_name" content="TipMyMenu" />
    <meta property="og:image" content="@(ViewData["MainImage"] ?? $"{baseUrl}/images/og-default.png")" />
    <meta name="twitter:card" content="summary_large_image" />
    @RenderSection("JsonLd", required: false)
    <meta name="yandex-verification" content="279a6808640a1bd4" />
    <environment include="Development">

    </environment>
    <environment exclude="Development">
        @*<link rel="stylesheet" href="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/css/bootstrap.min.css"
            asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
            asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />*@
    </environment>
    <link rel="manifest" href="~/manifest.json">

    @* Стилі сторінок підключаються ДО основного CSS, щоб зберегти попередній порядок каскаду *@
    @* swiper.min.css не блокує відмальовку (PageSpeed: блокуючі запити); розмітку слайдера тримають базові правила
       нижче (з того ж swiper.min.css), тож поки файл вантажиться, слайди не розсипаються і сторінка не стрибає *@
    <style>
        .swiper-container{margin:0 auto;position:relative;overflow:hidden;list-style:none;padding:0;z-index:1}
        .swiper-wrapper{position:relative;width:100%;height:100%;z-index:1;display:flex;box-sizing:content-box}
        .swiper-slide{flex-shrink:0;width:100%;height:100%;position:relative}
    </style>
    <link href="~/css/swiper.min.css" rel="stylesheet" asp-append-version="true" media="print" onload="this.media='all'" />
    <noscript><link href="~/css/swiper.min.css" rel="stylesheet" asp-append-version="true" /></noscript>
    @RenderSection("Styles", required: false)
    @if (isMobileUser)
    {
        <link href="~/css/main-mobile.css" rel="stylesheet" asp-append-version="true" />
    }
    else
    {
        <link href="~/css/main-pc.css" rel="stylesheet" asp-append-version="true" />
    }
    @* основний шрифт тексту - одразу, а не після розбору CSS: текст сторінки (часто LCP) малюється раніше *@
    <link rel="preload" href="~/fonts/GTWalsheimPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <partial name="_FontsInline" />
    <link rel="preconnect" href="https://use.fontawesome.com" crossorigin />
    <link href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" rel="stylesheet" /></noscript>
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

    <!-- Google Tag Manager -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-P5WP82B');
    </script>
    <!-- End Google Tag Manager -->
    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "himdi8nqxp");
    </script>
    <!-- End Microsoft Clarity -->
    <!-- Google Sence Manager -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1409649052535600"
     crossorigin="anonymous"></script>
    <!-- End Google Sence Manager -->

    <script>
        window.isMobile = @isMobileUser.ToString().ToLowerInvariant();
        window.culture = '@culture';
    </script>
</head>



<body class="@ViewData["BodyClass"] @additionalBodyClass">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P5WP82B"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->


    @RenderBody()

    @if (Context.Items.ContainsKey(Menus.Web.Helpers.EdgeCacheAttribute.ItemKey))
    {
        @* Сторінка могла прийти з кешу Cloudflare - токен у формах чужий, беремо свіжий *@
        <script>
            fetch('/antiforgery/token', { credentials: 'same-origin', cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    window.freshAntiforgeryToken = d.token;
                    document.querySelectorAll('input[name="__RequestVerificationToken"]').forEach(function (input) { input.value = d.token; });
                });
        </script>
    }

    @*<script>
            var afToken = '@Html.AntiForgeryToken()';
        </script>*@

    <environment include="Development">
    </environment>
    <environment exclude="Development">
        @*<script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.3.1.min.js"
                    asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
                    asp-fallback-test="window.jQuery"
                    crossorigin="anonymous"
                    integrity="sha384-tsQFqpEReu7ZLhBV2VZlAu7zcOV+rXbYlF2cqB8txI/8aZajjp4Bqd+V6D5IgvKT">
            </script>*@
        <script src="~/lib/sentry.min.js" asp-append-version="true"></script>
        <script src="~/js/raveninit.js" asp-append-version="true"></script>
    </environment>

    <script src="~/js/jquery.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
    @await Html.PartialAsync("_SignInPopup")

    <script src="~/js/promise.min.js" async></script>
    <script src="~/js/fetch.min.js" async></script>
    <script src="~/js/index.js" async></script>
    <environment include="Development">
        <script src="~/js/common.js"></script>
        <script src="~/js/googleSence.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/common.js" asp-append-version="true"></script>
        <script src="~/js/googleSence.js" asp-append-version="true"></script>
    </environment>    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Реклама не критична для першого рендеру - відкладаємо
            setTimeout(function () {
                if (typeof (initSence) !== 'undefined') {
                  initSence("@testModeValue");
                }
                if (typeof (initSenceSticky) !== 'undefined') {
                    initSenceSticky();
                }
            }, 500);

            if (typeof (initClosePopup) !== 'undefined') {
                initClosePopup();
            }

            if (typeof (initSearchRadioButton) !== 'undefined') {
                initSearchRadioButton("@Url.Action("FindRestaurant", "Home")", "@Url.Action("SearchDish", "Home")");
            }

            if (typeof (initServiceButtons) !== 'undefined') {
                initServiceButtons();
            }
        }, false);


    </script>

    <mini-profiler />
</body>
</html>
