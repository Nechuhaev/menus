@using Microsoft.AspNetCore.Mvc.Localization
@using Menus.Web.Services
@model List<Menus.Web.Services.DishCityPage>
@inject IViewLocalizer Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var culture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>().RequestCulture.Culture.TwoLetterISOLanguageName;
    var cityName = ViewData["cityName"] as string;
    var citySlug = ViewData["citySlug"] as string;
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";

    ViewData["Title"] = Menus.Web.Helpers.SeoText.Fit(Menus.Web.Helpers.SeoText.TitleMax,
        string.Format(Localizer["MetaTitle"].Value, cityName), $"{cityName} | TipMyMenu");
    ViewData["Description"] = string.Format(Localizer["MetaDescription"].Value, cityName, Model.Count);
}

@section JsonLd {
    @(Menus.Web.Helpers.JsonLd.Script(
        Menus.Web.Helpers.JsonLd.ItemList(string.Format(Localizer["Header"].Value, cityName),
            Model.Select(x => (x.GetTitle(culture), $"{siteUrl}/{culture}/{citySlug}/dishes/{x.Slug}"))),
        Menus.Web.Helpers.JsonLd.Breadcrumbs(
            ("TipMyMenu", $"{siteUrl}/{culture}"),
            (string.Format(Localizer["Header"].Value, cityName), $"{siteUrl}/{culture}/{citySlug}/dishes"))))
}

@section Styles {
    <style>
        .dish-city-hub { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; padding: 0; list-style: none; }
        .dish-city-hub a { display: block; padding: 12px 14px; border: 1px solid #e5e5e5; border-radius: 6px; }
        .dish-city-hub strong { display: block; }
        .dish-city-hub span { color: #777; font-size: 14px; }
    </style>
}

@await Html.PartialAsync("_Header")
<div class="site-content">
    <main>
        <div class="breadcrumbs breadcrumbs-content">
            <ul>
                <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                <li><breadcrumb href="#">@string.Format(Localizer["Header"].Value, cityName)</breadcrumb></li>
            </ul>
        </div>

        <div class="site-content-align">
            <h1>@string.Format(Localizer["Header"].Value, cityName)</h1>
            @if (!Model.Any())
            {
                <p>@Localizer["Empty"]</p>
            }
            else
            {
                <ul class="dish-city-hub">
                    @foreach (var dishPage in Model)
                    {
                        <li>
                            <a href="/@culture/@citySlug/dishes/@dishPage.Slug">
                                <strong>@dishPage.GetTitle(culture)</strong>
                                <span>@string.Format(Localizer["Venues"].Value, dishPage.Venues, dishPage.MedianPrice.ToString("0"))</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </main>
</div>
@await Html.PartialAsync("_Footer")
