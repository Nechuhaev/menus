@using System.Text.RegularExpressions
@using Menus.Web.Models.ViewModels
@using Microsoft.Extensions.Configuration
@inject Menus.Web.Services.UserService  UserService;
@inject IConfiguration Configuration;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var crq = Context.Request;
    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;
    bool isIphone = @UserService.IsIphone(Context.Request);
    string additionalBodyClass = isIphone ? "iphone-in-use" : "";
    ViewData["Robots"] = "NOINDEX,FOLLOW";

    IframeSettingsModel iframeSettings = ViewData["iframeSettings"] as IframeSettingsModel;
    var locales = iframeSettings.Languages;
    var robots = ViewData["Robots"] ?? Configuration["Meta:Robots"];
}

@using Menus.Abstract.Models
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@model Menus.Web.Models.ViewModels.RestaurantViewModel
@inject Menus.Web.Services.UserService  UserService;
@inject Menus.Domain.Core Core
@{
    Layout = null;

    var seo = ViewData["seo"] as Menus.Abstract.Models.IRestaurantSeo;
    ViewData["BodyClass"] = "restaurant-page";
    int categoryIndex;

    var selectedCity = ViewData["selectedCity"] as Menus.Abstract.Models.ICity;
    var url = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var restaurantCity = await Core.Restaurants.GetCityById(Model.Restaurant.City);

    ViewData["Title"] = string.IsNullOrEmpty(seo.Title.Get(culture))
        ? $"Меню ресторана {Model.Restaurant.Name} в городе {restaurantCity.Name.Get(culture)} | tipmymenu"
        : seo.Title.Get(culture);

    var restaurantDescription = Model.RestaurantInfo.ShortInfo.Get(culture);
    ViewData["Description"] = string.IsNullOrEmpty(restaurantDescription)
        ? Model.Restaurant.Name
        : Model.RestaurantInfo.ShortInfo.Get(culture).Substring(0, restaurantDescription.Length > 150 ? 150 : restaurantDescription.Length);

    var currentDay = (int)DateTime.Now.DayOfWeek;
    currentDay = currentDay == 0 ? 6 : currentDay - 1;
    JToken currentDayInfo = null;
    JArray allDaysInfo = null;
    if (Model.SchedulePerDay)
    {
        allDaysInfo = JsonConvert.DeserializeObject<JArray>(Model.OpenHours);
        currentDayInfo = allDaysInfo[currentDay];
    }

    var imgAlt = $"Фото {Model.Restaurant.Name} {restaurantCity.Name.Get(culture)}";

    var selectedCityId = Context.Request.Cookies[".Menus.SelectedCity"];
    selectedCityId = !string.IsNullOrEmpty(selectedCityId) ? selectedCityId : "e2655e24-92dc-4179-abf6-c3908278a4de";
    var featuredRestaurants = Core.Restaurants.FindSimilarCuisineRestaurants(Model.RestaurantInfo.Cuisine.Get(culture).Split(",")[0], selectedCityId, Model.RestaurantInfo.RestaurantId).Take(4).ToList();

    var topDishes = ViewData["topDishes"] as List<IDishWithSeoAndRatings>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"
          data-content-zoomable="width=device-width, initial-scale=1.0"
          data-content-non-zoomable="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="format-detection" content="address=no">
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"]</title>

    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@($"http{(crq.IsHttps ? "s" : "")}://{crq.Host}{crq.Path}{crq.QueryString}")" />

    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@(culture)_UA" />
    <meta property="og:url" content="@($"http{(crq.IsHttps ? "s" : "")}://{crq.Host}{crq.Path}{crq.QueryString}")" />
    <meta property="og:image" content="@(ViewData["MainImage"] ?? $"http{(crq.IsHttps ? "s" : "")}://{crq.Host}/images/site_logo_dark.svg")" />

    <script>
        var isMobile = @UserService.IsMobileUser(Context.Request).ToString().ToLowerInvariant();
        window.isMobile = isMobile
    </script>

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600&display=swap&subset=cyrillic" rel="stylesheet">

    <style>
        @Html.Raw(seo.CustomCss);

    </style>
    <link href="~/css/swiper.min.css" rel="stylesheet" />
    @if (UserService.IsMobileUser(Context.Request))
    {
        <link href="~/css/main-mobile.css" rel="stylesheet" asp-append-version="true" />
    }
    else
    {
        <link href="~/css/main-pc.css" rel="stylesheet" asp-append-version="true" />
    }
    <link href="~/fonts/fonts.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" rel="stylesheet" />
</head>
<body class="@ViewData["BodyClass"] @additionalBodyClass">

    @if (iframeSettings.ShowHeader)
    {
        @await Html.PartialAsync("_Header")
    }
    else
    {
        <div style="display: none!important">
            @await Html.PartialAsync("_Header")
        </div>
    }


    <style>
        button[data-user-id] {
            display: none;
        }

        button[data-user-id="@User.Identity.Name"] {
            display: initial;
        }
    </style>

    <div itemscope itemtype="http://schema.org/Restaurant">
        @if (iframeSettings.ShowInfo)
        {
            <div class="topSection">
                <div class="wrapper">
                    <h1 itemprop="name">
                        <figure>
                            <img itemprop="image" src="@Img.Url(Model.Photos.FirstOrDefault(), Quality.Low)" alt="@imgAlt" title="@imgAlt" />
                        </figure>
                        @Model.Restaurant.Name
                        @if (Model.UserRole != null)
                        {
                            <a href="@Url.Action("EditRestaurant", "Home", new { id = Model.RestaurantInfo.RestaurantId })"><i class="far fa-edit"></i></a>
                        }
                    </h1>
                    <p><em @(!string.IsNullOrEmpty(Model.RestaurantInfo.GpsLatitude) ? "data-open-map" : "")>@(restaurantCity.Name.Get(culture)), @(!string.IsNullOrEmpty(Model.RestaurantInfo.DisplayAddress.Get(culture)) ? Model.RestaurantInfo.DisplayAddress.Get(culture) : Localizer["Address"].ToString())</em> <span itemprop="address" content="@Model.RestaurantInfo.DisplayAddress.Get(culture), @restaurantCity.Name.Get(culture)">|</span> <a itemprop="telephone" content="@Model.Restaurant.Phone" href="tel:@Model.Restaurant.Phone">@(!string.IsNullOrEmpty(Model.Restaurant.Phone) ? Model.Restaurant.Phone : Localizer["Phone"].ToString())</a> <span itemprop="servesCuisine" content="@Model.RestaurantInfo.Cuisine.Get(culture)">|</span> @(!string.IsNullOrEmpty(Model.RestaurantInfo.Cuisine.Get(culture)) ? Model.RestaurantInfo.Cuisine.Get(culture) : Localizer["Kitchen"].ToString())</p>
                    @if (!Model.SchedulePerDay)
                    {
                        <strong>@Localizer["WorkHours"]: @Model.OpenHours</strong>
                    }
                    else
                    {
                        if (!UserService.IsMobileUser(Context.Request))
                        {
                            <div class="work-hours">
                                <strong>@Localizer["WorkHours"]: <em>@Localizer["Today"] (@(currentDayInfo["active"].Value<bool>() ? $"{currentDayInfo["from"].Value<string>()}-{currentDayInfo["to"].Value<string>()}" : Localizer["Closed"].ToString()))</em></strong>
                                <div class="work-hours-dropdown">
                                    <span>@Localizer["Mon"] (@(allDaysInfo[0]["active"].Value<bool>() ? $"{allDaysInfo[0]["from"].Value<string>()}-{allDaysInfo[0]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Tue"] (@(allDaysInfo[1]["active"].Value<bool>() ? $"{allDaysInfo[1]["from"].Value<string>()}-{allDaysInfo[1]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Wed"] (@(allDaysInfo[2]["active"].Value<bool>() ? $"{allDaysInfo[2]["from"].Value<string>()}-{allDaysInfo[2]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Thr"] (@(allDaysInfo[3]["active"].Value<bool>() ? $"{allDaysInfo[3]["from"].Value<string>()}-{allDaysInfo[3]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Fri"] (@(allDaysInfo[4]["active"].Value<bool>() ? $"{allDaysInfo[4]["from"].Value<string>()}-{allDaysInfo[4]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Sat"] (@(allDaysInfo[5]["active"].Value<bool>() ? $"{allDaysInfo[5]["from"].Value<string>()}-{allDaysInfo[5]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                    <span>@Localizer["Sun"] (@(allDaysInfo[6]["active"].Value<bool>() ? $"{allDaysInfo[6]["from"].Value<string>()}-{allDaysInfo[6]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <strong>
                                @Localizer["WorkHours"]:
                                <select>
                                    <option disabled selected>@Localizer["Today"] (@(currentDayInfo["active"].Value<bool>() ? $"{currentDayInfo["from"].Value<string>()}-{currentDayInfo["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Mon"] (@(allDaysInfo[0]["active"].Value<bool>() ? $"{allDaysInfo[0]["from"].Value<string>()}-{allDaysInfo[0]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Tue"] (@(allDaysInfo[1]["active"].Value<bool>() ? $"{allDaysInfo[1]["from"].Value<string>()}-{allDaysInfo[1]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Wed"] (@(allDaysInfo[2]["active"].Value<bool>() ? $"{allDaysInfo[2]["from"].Value<string>()}-{allDaysInfo[2]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Thr"] (@(allDaysInfo[3]["active"].Value<bool>() ? $"{allDaysInfo[3]["from"].Value<string>()}-{allDaysInfo[3]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Fri"] (@(allDaysInfo[4]["active"].Value<bool>() ? $"{allDaysInfo[4]["from"].Value<string>()}-{allDaysInfo[4]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Sat"] (@(allDaysInfo[5]["active"].Value<bool>() ? $"{allDaysInfo[5]["from"].Value<string>()}-{allDaysInfo[5]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                    <option disabled>@Localizer["Sun"] (@(allDaysInfo[6]["active"].Value<bool>() ? $"{allDaysInfo[6]["from"].Value<string>()}-{allDaysInfo[6]["to"].Value<string>()}" : Localizer["Closed"].ToString()))</option>
                                </select>
                            </strong>
                        }

                    }

                    <ul class="icons">
                        @if (!string.IsNullOrEmpty(Model.Restaurant.Phone))
                        {
                            <li>
                                <a itemprop="url" content="@Model.Restaurant.Phone" href="tel:@Model.Restaurant.Phone">
                                    <span class="fa-fw select-all fas"></span>
                                </a>
                                <em>@Localizer["Phone"]</em>
                            </li>
                        }
                        else if (!string.IsNullOrEmpty(Model.RestaurantInfo.Website))
                        {
                            <li>
                                <a itemprop="url" content="@Model.RestaurantInfo.Website" target="_blank" rel="noopener" href="@Model.RestaurantInfo.Website">
                                    <span class="fa-fw select-all fas"></span>
                                </a>
                                <em>@Localizer["Website"]</em>
                            </li>
                        }
                        @if (!UserService.IsMobileUser(Context.Request) && Model.Photos.Count > 0)
                        {
                            <li>
                                <a href="#" class="galleryBtn" data-pc>
                                    <span class="fa-fw select-all fas"></span>
                                </a>
                                <em>@Localizer["Gallery"]</em>
                            </li>
                        }
                        else if (Model.Photos.Count > 0)
                        {
                            <li>
                                <a href="#mobile-carousel" class="galleryBtn" data-mobile>
                                    <span class="fa-fw select-all fas"></span>
                                </a>
                                <em>@Localizer["Gallery"]</em>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.RestaurantInfo.GpsLatitude))
                        {
                            <li>
                                <a href="#" class="mapBtn" data-open-map>
                                    <span class="fa-fw select-all fas"></span>
                                </a>
                                <em>@Localizer["Map"]</em>
                            </li>
                        }
                        <li>
                            <a href="#" class="search-icon-button">
                                <span class="fa-fw select-all fas"></span>
                            </a>
                            <em>@Localizer["Search"]</em>
                        </li>
                    </ul>
                </div>
            </div>
        }



        <div class="site-content site-content-iframe">
            <main>

                <div class="site-content-align">
                    <div class="iframe-top-section">

                        @if (iframeSettings.ShowLogo)
                        {
                            <div class="iframe-top-section-title">@Model.Restaurant.Name</div>
                        }

                        @if (iframeSettings.ShowLanguages)
                        {
                            <div class="iframe-top-section-language">
                                <ul>
                                    @foreach (var lang in locales)
                                    {
                                        <li class="@(lang.Id == culture ? "current" : "")"><a href="@($"http{(crq.IsHttps ? "s" : "")}://{crq.Host}{Regex.Replace(crq.Path, "/(ru|uk|en)", $"/{lang.Id}")}{crq.QueryString}")">@lang.Id</a></li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (iframeSettings.ShowPhone)
                        {
                            <div class="iframe-top-section-phone">
                                <span class="iframe-top-section-phone-title">
                                    @Localizer["ReserveTable"]
                                </span>
                                <span class="iframe-top-section-phone-phone">
                                    @Model.Restaurant.Phone
                                </span>
                            </div>
                        }

                    </div>
                </div>


                @if (iframeSettings.ShowBreadcrump)
                {
                    <div class="breadcrumbs">
                        <ul>
                            <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                            <li><breadcrumb href="#">@Model.Restaurant.Name</breadcrumb></li>
                        </ul>
                    </div>

                    <div class="local-menu-search hidden">
                        <input type="text" placeholder="@Localizer["MenuSearch"]" />
                        <a href="javascript:void(0);" class="search-icon-button-close">
                            <span class="fa-fw select-all fas"></span>
                        </a>
                    </div>
                }


                @if (iframeSettings.ShowCategories)
                {
                    @if (!UserService.IsMobileUser(Context.Request) && Model.Menu.Categories.Any())
                    {
                        <div class="contentNavi disableOnMobile">
                            <div class="contentNaviWrapper">

                                @if (!Model.Restaurant.IsModeratable)
                                {
                                    <div class="restaurant-user-actions">
                                        @if (Model.RestaurantInfo.UserAllowedAddMenu || Model.RestaurantInfo.UserAllowedOpenMenu)
                                        {
                                            <i class="far fa-file-image"></i>
                                            <label class="hidden" data-upload-photo for="photo-upload-input">@Localizer["AddMenu"]</label>
                                            <a class="hidden" data-open-menus-photos href="#">@Localizer["ViewMenu"]</a>
                                        }
                                        @if (Model.RestaurantInfo.UserAllowedAddDishes)
                                        {
                                            <i class="far fa-plus-square"></i><a asp-controller="Home" asp-action="CreateDish" asp-route-id="@ViewData["restaurantId"]">@Localizer["AddDish"]</a>
                                        }
                                    </div>
                                }

                                <ul>
                                    @{
                                        categoryIndex = 0;
                                    }
                                    @foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                                    {
                                        categoryIndex++;
                                        <li><a href="#table_food_@categoryIndex">@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</a></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    else if (Model.Menu.Categories.Any())
                    {
                        <!-- Swiper -->
                        <div class="contentNaviCarousel disableOnDesktop">
                            <div class="contentNaviCarouselInner">
                                <div class="swiper-container navi-carousel">
                                    <div class="swiper-wrapper">
                                        @{
                                            categoryIndex = 0;
                                        }
                                        @foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                                        {
                                            categoryIndex++;
                                            <div class="swiper-slide"><a href="#table_food_@categoryIndex">@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</a></div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <div class="site-content-align">
                    @if (iframeSettings.ShowTop)
                    {
                        @if (topDishes.Any())
                        {
                            <h2 class="top_dishes_title">@Localizer["TopDishes"]</h2>
                        }

                        @if (!UserService.IsMobileUser(Context.Request) && topDishes.Any())
                        {
                            <div class="popular_dishes disableOnMobile">
                                @foreach (var dish in topDishes)
                                {
                                    <div class="restaurant">
                                        <a asp-controller="Home" asp-action="Dish" asp-route-city="@ViewData["selectedCityName"]" asp-route-id="@seo.Url" asp-route-dishId="@dish.Url">
                                            @if (dish.Photos.Any())
                                            {
                                                <figure class="restaurant-image" style="background-image: url(@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low));">
                                                    <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                </figure>
                                            }
                                            else
                                            {
                                                <figure class="restaurant-image restaurant-image-blank">
                                                    <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                </figure>
                                            }
                                            <p class="restaurant-name">
                                                @dish.Name.Get(culture)
                                            </p>
                                            <p class="popular_dish_info">
                                                <strong>@dish.RatingFloat.ToString("F1")</strong>
                                                @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                <em>(@dish.RatingCount)</em>
                                            </p>
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                        else if (topDishes.Any())
                        {
                            <!-- Swiper -->
                            <div class="popular-area disableOnDesktop">
                                <div class="swiper-container popular-container">
                                    <div class="swiper-wrapper">
                                        @foreach (var dish in topDishes)
                                        {
                                            <a class="swiper-slide" asp-controller="Home" asp-action="Dish" asp-route-city="@ViewData["selectedCityName"]" asp-route-id="@seo.Url" asp-route-dishId="@dish.Url">

                                                @if (dish.Photos.Any())
                                                {
                                                    <figure class="restaurant-image" style="background-image: url(@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low));">
                                                        <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                    </figure>
                                                }
                                                else
                                                {
                                                    <figure class="restaurant-image restaurant-image-blank">
                                                        <figcaption>₴ @dish.Price.ToString("F2")</figcaption>
                                                    </figure>
                                                }
                                                <p class="restaurant-name">
                                                    @dish.Name.Get(culture)
                                                </p>
                                                <p class="popular_dish_info">
                                                    <strong>@dish.RatingFloat.ToString("F1")</strong>
                                                    @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                    <em>(@dish.RatingCount)</em>
                                                </p>
                                            </a>
                                        }
                                        <div class="swiper-slide"></div>
                                    </div>
                                    <!-- Add Pagination -->
                                    <div class="swiper-pagination"></div>
                                </div>
                            </div>
                        }

                    }

                    <div id="table_food_top"></div>
                    @if (!UserService.IsMobileUser(Context.Request) && Model.Menu.Categories.Any())
                    {
                        categoryIndex = 0;
                        foreach (var category in Model.Menu.Categories.OrderBy(x => x.Index))
                        {
                            categoryIndex++;
                            <div class="table_element @(categoryIndex == 1 ? "visible" : "")">
                                <table class="table_food disableOnMobile" id="table_food_@categoryIndex">
                                    <thead>
                                        <tr>
                                            <td class="table_food_name"><h2>@((category as Menus.Abstract.Models.IMenuCategory).Name.Get(culture))</h2></td>
                                            @if (categoryIndex == 1)
                                            {
                                                <td class="table_food_price">@Localizer["Price"]</td>
                                                <td class="table_food_weight">@Localizer["Weight"]</td>
                                                @if (iframeSettings.ShowRating)
                                                {
                                                    <td class="table_food_rating">@Localizer["Rating"]</td>
                                                }

                                            }
                                            else
                                            {
                                                <td class="table_food_price"></td>
                                                <td class="table_food_weight"></td>
                                                @if (iframeSettings.ShowRating)
                                                {
                                                    <td class="table_food_rating"></td>
                                                }

                                            }
                                            @if (iframeSettings.ShowRating)
                                            {
                                                <td class="table_food_count"></td>
                                            }
                                            <td class="table_food_link"></td>
                                        </tr>
                                    </thead>
                                    <tbody style="@(categoryIndex == 1 ? "display: table-row-group;" : "")">
                                        @foreach (var dish in category.Dishes.OrderByDescending(x => x.RatingFloat))
                                        {
                                        <tr data-dish-id="@dish.Id">
                                            <td class="table_food_name">
                                                @if (dish.Photos.Any() && iframeSettings.ShowDishImages)
                                                {
                                                    <div class="dish-image" style="background-image: url(@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low));">
                                                    </div>
                                                }
                                                <h3>
                                                    @if (iframeSettings.ShowExternalUrl)
                                                    {
                                                        <a href="@Url.Action("Dish", "Home", new { id = ViewData["restaurantId"], dishId = dish.Url })">@(Char.ToUpper(dish.Name.Get(culture)[0]) + dish.Name.Get(culture).Substring(1))</a>
                                                    }
                                                    else if (dish.Photos.Any() && iframeSettings.ShowDishImages)
                                                    {
                                                        <a class="show-dish-image"
                                                           href="javascript:void(0);"
                                                           data-image-url="@Img.Url(dish.Photos.FirstOrDefault(), Quality.Low)">
                                                            @(Char.ToUpper(dish.Name.Get(culture)[0]) + dish.Name.Get(culture).Substring(1))
                                                        </a>
                                                        @if (iframeSettings.ShowDishImagesIcons)
                                                        {
                                                            <span>icon</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <a href="javascript:void(0);">@(Char.ToUpper(dish.Name.Get(culture)[0]) + dish.Name.Get(culture).Substring(1))</a>
                                                    }
                                                </h3>
                                                @if (dish.ShortDescription.Get(culture).Length > 0)
                                                {
                                                    <p>@dish.ShortDescription.Get(culture)</p>
                                                }
                                            </td>
                                            <td class="table_food_price">
                                                @if (dish.IsPriceMultiple)
                                                {
                                                    <span>@Localizer["From"]&nbsp;</span>
                                                }
                                                @if (dish.Price != 0)
                                                {
                                                    @Model.RestaurantInfo.Currency @dish.Price.ToString("F2")
                                                }
                                            </td>
                                            @if (dish.Weight != "0")
                                            {
                                                <td class="table_food_weight">@dish.Weight @dish.WeightType</td>
                                            }                                            
                                            @if (iframeSettings.ShowRating)
                                            {
                                                <td class="table_food_rating @(dish.UserRating > 0 ? "rated" : "")">
                                                    @await Html.PartialAsync("_StarRating", @dish.RatingFloat)
                                                    @if (User.Identity.IsAuthenticated)
                                                    {
                                                        <div class="hover_rating">
                                                            @if (dish.UserRating > 0)
                                                            {
                                                                <p>@Localizer["YourRate"]</p>
                                                                for (var i = 1; i <= 5; i++)
                                                                {
                                                                    if (i <= dish.UserRating)
                                                                    {
                                                                        <span class="stars star_red"></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="stars star_grey"></span>
                                                                    }
