@* Меню ресторану для вбудовування на сайт закладу (iframe). Дизайн TipMyMenu: обкладинка, картка закладу, вкладки
   розділів, страви картками, «Про заклад». Один шаблон для живої сторінки (/{мова}/{місто}/iframe/{slug}) і для кешу
   (IframeController.Clean). Посилання на tipmymenu.com - без схеми (//tipmymenu.com): кеш на frm.tipmymenu.com
   замінює «https://tipmymenu.com» на CDN фото. *@
@using System.Text.RegularExpressions
@using Menus.Abstract.Models
@using Menus.Web.Models.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using Microsoft.AspNetCore.Mvc.Localization
@model Menus.Web.Models.ViewModels.RestaurantViewModel
@inject IViewLocalizer Localizer
@inject Menus.Domain.Core Core
@functions {
    // Одиниці з різних джерел (г / g / gr, мл / ml, psc, «/», «\», порожньо) - до одного вигляду.
    // Напої (за назвою розділу) у грамах - у мл. Без одиниці: до 20 - штуки, більше - г або мл.
    static readonly System.Text.RegularExpressions.Regex DrinkCategory = new System.Text.RegularExpressions.Regex(
        "чай|кав|coffee|tea|напо|напи|фреш|сік|сок|лимонад|вод|пив|вин|wine|коктейл|моктейл|cocktail|mocktail|сангр|глінтвейн|глинтвейн|алко|бар|джин|gin|віскі|виски|whisk|горілк|водк|чач|коньяк|ром|текіл|лікер|ликер|шампан|ігрист|игрист|смузі|смузи|какао|морс|компот|узвар|drink",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    // розділи з їжею, хоч і зі словом напою в назві («винна дегустація», «закуски до пива»)
    static readonly System.Text.RegularExpressions.Regex FoodCategory = new System.Text.RegularExpressions.Regex(
        "дегустац|закуск|страв|блюд|десерт|сет|асорті|ассорти|снек|салат|суп",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    static bool IsDrinkCategory(string name) => !string.IsNullOrEmpty(name) && DrinkCategory.IsMatch(name) && !FoodCategory.IsMatch(name);

    static string Unit(string value, string unit, bool drink)
    {
        var v = (value ?? "").Trim();
        if (v.Length == 0 || v == "0") return null;
        var u = (unit ?? "").Trim().Trim('.').ToLowerInvariant();
        string norm;
        if (u == "г" || u == "g" || u == "gr" || u == "гр" || u == "грам" || u == "gram" || u == "grams" || u == "/" || u == "\\") norm = "г";
        else if (u == "мл" || u == "ml") norm = "мл";
        else if (u == "кг" || u == "kg") norm = "кг";
        else if (u == "л" || u == "l") norm = "л";
        else if (u == "шт" || u == "psc" || u == "pcs" || u == "pc") norm = "шт";
        else if (u.Length == 0)
        {
            norm = decimal.TryParse(v.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) && n <= 20 ? "шт" : "г";
        }
        else norm = unit.Trim();
        if (drink && norm == "г") norm = "мл";
        if (drink && norm == "кг") norm = "л";
        return v + " " + norm;
    }

    // Назва, набрана ВЕЛИКИМИ ЛІТЕРАМИ, - як речення («ХІНКАЛІ З СИРОМ» -> «Хінкалі з сиром»)
    static string Sentence(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;
        text = text.Trim();
        if (text.Any(char.IsLetter) && !text.Any(char.IsLower)) text = text.ToLower();
        return char.ToUpper(text[0]) + text.Substring(1);
    }

    // усе, що потрібно для картки страви (у списку, у «Топ страви» і в картці поверх меню)
    class DishCard
    {
        public string Title, Desc, FullDesc, Ingr, Photo, PhotoHigh, PriceText, Weight, Variants, RatingText;
        public float Rating;
        public int RatingCount;
    }
    static TimeZoneInfo KyivZone()
    {
        foreach (var id in new[] { "Europe/Kyiv", "Europe/Kiev", "FLE Standard Time" })
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById(id); } catch (Exception) { }
        }
        return TimeZoneInfo.Utc;
    }
}
@{
    Layout = null;
    var crq = Context.Request;
    var culture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>().RequestCulture.Culture.TwoLetterISOLanguageName;
    var seo = ViewData["seo"] as IRestaurantSeo;
    var iframeSettings = ViewData["iframeSettings"] as IframeSettingsModel;
    // налаштування вигляду з кабінету ресторану (блок «Меню для вашого сайту»)
    var design = ViewData["design"] as Menus.Web.Services.IframeDesign ?? new Menus.Web.Services.IframeDesign();
    // мови iframe - українська й англійська (російської в iframe немає; старі вставки /ru/ працюють як і раніше)
    var locales = design.HideLanguages ? new List<string>() : new List<string> { "uk", "en" };
    var city = await Core.Restaurants.GetCityById(Model.Restaurant.City);
    var citySlug = city?.Name.Get("en")?.ToLower() ?? "kyiv";
    var cityName = city?.Name.Get(culture) ?? "";
    var info = Model.RestaurantInfo;
    var address = info.DisplayAddress?.Get(culture);
    var fullAddress = string.IsNullOrWhiteSpace(address) ? cityName : $"{cityName}, {address}";
    var cuisines = (info.Cuisine?.Get(culture) ?? "").Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).Take(3).ToList();
    var currency = string.IsNullOrWhiteSpace(info.Currency) ? "₴" : info.Currency;
    var cover = design.Cover == "brand" ? null
        : !string.IsNullOrEmpty(design.Cover) && Model.Photos != null && Model.Photos.Contains(design.Cover) ? design.Cover
        : Model.Photos?.FirstOrDefault();
    var coverStyle = cover != null ? $"background-image: url('{Img.Url(cover, Quality.High)}')" : null;
    var initials = string.Concat((Model.Restaurant.Name ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    // порядок розділів - як в адмінці (Index); у меню з групами (Clean) порядок уже задано групами
    // «Сніданки» завжди першими (далі - порядок розділів як у кабінеті)
    bool IsBreakfast(IMenuCategory c) => System.Text.RegularExpressions.Regex.IsMatch((c.Name?.Get("uk") ?? "") + " " + (c.Name?.Get("ru") ?? "") + " " + (c.Name?.Get("en") ?? ""), "сніданк|снiданк|завтрак|breakfast", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    // меню з групами (верхні розділи з підрозділами) лишається як є, щоб підрозділи не відірвались від групи
    var allCategories = Model.Menu.Categories.Any(c => c.IsTopLevelCategory) ? Model.Menu.Categories.ToList()
        : Model.Menu.Categories.OrderBy(c => IsBreakfast((IMenuCategory)c) ? 0 : 1).ThenBy(c => c.Index).ToList();
    var categories = allCategories.Where(c => c.IsTopLevelCategory || (c.Dishes != null && c.Dishes.Any())).ToList();
    var aboutTitle = Localizer["AboutPlace"].IsResourceNotFound ? "Про заклад" : Localizer["AboutPlace"].Value;
    string Hours(JToken day) => day["active"].Value<bool>() ? $"{day["from"].Value<string>()} — {day["to"].Value<string>()}" : Localizer["Closed"].Value;
    JArray days = null;
    if (Model.SchedulePerDay) { try { days = JsonConvert.DeserializeObject<JArray>(Model.OpenHours); } catch (Exception) { days = null; } }
    var dayNames = new[] { "Mon", "Tue", "Wed", "Thr", "Fri", "Sat", "Sun" };
    // час закладу - київський (сервер живе в UTC)
    var kyivNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, KyivZone());
    var today = (int)kyivNow.DayOfWeek; today = today == 0 ? 6 : today - 1;
    var dishIndex = 0;

    // «Відчинено / Зачинено» - лише коли години задані по днях
    bool? openNow = null;
    string openUntil = null;
    var dailyHours = days == null && !string.IsNullOrWhiteSpace(Model.OpenHours)
        ? Regex.Match(Model.OpenHours, @"^\s*(\d{1,2}[:.]\d{2})\s*[-–—]\s*(\d{1,2}[:.]\d{2})") : null;
    if (dailyHours != null && dailyHours.Success
        && TimeSpan.TryParse(dailyHours.Groups[1].Value.Replace('.', ':'), out var df) && TimeSpan.TryParse(dailyHours.Groups[2].Value.Replace('.', ':'), out var dt))
    {
        var nowT = kyivNow.TimeOfDay;
        openNow = dt > df ? nowT >= df && nowT < dt : nowT >= df || nowT < dt;
        openUntil = openNow == true ? dailyHours.Groups[2].Value.Replace('.', ':') : null;
    }
    if (days != null && days.Count >= 7)
    {
        bool TryTimes(JToken day, out TimeSpan from, out TimeSpan to)
        {
            from = to = TimeSpan.Zero;
            return day["active"].Value<bool>() && TimeSpan.TryParse(day["from"].Value<string>(), out from) && TimeSpan.TryParse(day["to"].Value<string>(), out to);
        }
        var now = kyivNow.TimeOfDay;
        openNow = false;
        if (TryTimes(days[today], out var f, out var t))
        {
            if (t > f ? now >= f && now < t : now >= f) { openNow = true; openUntil = days[today]["to"].Value<string>(); }
        }
        // хвіст учорашньої зміни після півночі (напр. 18:00 - 02:00)
        if (openNow == false && TryTimes(days[(today + 6) % 7], out var yf, out var yt) && yt <= yf && now < yt)
        {
            openNow = true; openUntil = days[(today + 6) % 7]["to"].Value<string>();
        }
    }
    string Capital(string v) => string.IsNullOrEmpty(v) ? v : char.ToUpper(v[0]) + v.Substring(1);
    var openText = Localizer["OpenNow"].IsResourceNotFound ? "Відчинено" : Localizer["OpenNow"].Value;

    // варіанти страв і Instagram закладу
    var extras = ViewData["extras"] as Menus.Web.Services.IframeExtras ?? new Menus.Web.Services.IframeExtras();
    string Money(decimal v) => $"{v.ToString("0.##")} {currency}";
    var cards = new Dictionary<string, DishCard>();
    foreach (var (cat, d) in allCategories.Where(c => c.Dishes != null).SelectMany(c => c.Dishes.Select(x => (c, x))))
    {
        if (cards.ContainsKey(d.Id)) { continue; }
        var drink = IsDrinkCategory(((IMenuCategory)cat).Name.Get("uk")) || IsDrinkCategory(((IMenuCategory)cat).Name.Get(culture));
        extras.Variants.TryGetValue(d.Id ?? "", out var variants);
        var multi = variants != null && variants.Count > 1;
        var ph = design.HidePhotos ? null : d.Photos?.FirstOrDefault();
        var minPrice = multi ? variants.Min(v => v.Price) : d.Price;
        var maxPrice = multi ? variants.Max(v => v.Price) : d.Price;
        cards[d.Id] = new DishCard
        {
            Title = Sentence(Menus.Web.Helpers.DishName.Title(d.Name, culture)),
            Desc = design.HideDescriptions ? null : d.ShortDescription?.Get(culture),
            FullDesc = design.HideDescriptions ? null : new[] { d.Description?.Get(culture), d.ShortDescription?.Get(culture) }.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)),
            Ingr = design.HideDescriptions ? null : d.Ingredients?.Get(culture),
            Photo = string.IsNullOrEmpty(ph) ? null : Img.Url(ph, Quality.Low),
            PhotoHigh = string.IsNullOrEmpty(ph) ? null : Img.Url(ph, Quality.High),
            // кілька варіантів - діапазон цін «245 – 315 ₴», інакше «від» як і раніше
            PriceText = maxPrice == 0 ? null
                : multi && minPrice != maxPrice ? $"{minPrice.ToString("0.##")} – {Money(maxPrice)}"
                : $"{(d.IsPriceMultiple && !multi ? Localizer["From"].Value + " " : "")}{Money(minPrice)}",
            Weight = design.HideWeight || multi ? null : Unit(d.Weight, d.WeightType, drink),
            Variants = multi ? string.Join("\n", variants.Select(v => (design.HideWeight || v.Weight == 0 ? "" : Unit(v.Weight.ToString(), v.Type, drink) + " — ") + Money(v.Price))) : null,
            Rating = d.RatingFloat,
            RatingCount = d.RatingCount,
            RatingText = d.RatingCount > 0 ? $"★ {d.RatingFloat.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} · {d.RatingCount} {Localizer["Ratings"].Value}" : null
        };
    }
    // «Топ страви»: найвище оцінені відвідувачами TipMyMenu (від 3 таких страв)
    var popular = cards.Where(x => x.Value.RatingCount > 0).OrderByDescending(x => x.Value.Rating).ThenByDescending(x => x.Value.RatingCount).Take(8).ToList();
    if (popular.Count < 3) { popular.Clear(); }

    // сайт закладу (не QR-меню й не соцмережа) та Instagram
    var website = info.Website;
    if (!string.IsNullOrWhiteSpace(website) && Regex.IsMatch(website, "choiceqr|expz\\.menu|expirenza|restoapp\\.eu|instagram\\.com|facebook\\.com|svkus\\.com|restaurantguru|tripadvisor|firstline\\.in\\.ua|2gis|google\\.[a-z.]+/maps|tomato\\.ua|linktr\\.ee|taplink", RegexOptions.IgnoreCase)) { website = null; }
    if (!string.IsNullOrWhiteSpace(website) && !Regex.IsMatch(website, "^https?://", RegexOptions.IgnoreCase)) { website = "https://" + website.Trim(); }
    // без міток реклами (?fbclid=, utm_) - посилання чисте
    if (!string.IsNullOrWhiteSpace(website)) { website = Regex.Replace(website, "[?&](fbclid|gclid|utm_[a-z]+)=[^&#]*", "", RegexOptions.IgnoreCase).TrimEnd('?', '&'); }
    var instagram = extras.Instagram.FirstOrDefault();
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="NOINDEX,FOLLOW" />
    <title>@Model.Restaurant.Name - меню | TipMyMenu</title>
    <style>
        @@font-face { font-family: TMM; src: url(//tipmymenu.com/fonts/GTWalsheimPro-Regular.woff2) format("woff2"); font-weight: 400; font-display: swap; }
        @@font-face { font-family: TMM; src: url(//tipmymenu.com/fonts/gtwalsheimpro-bold-webfont.woff) format("woff"); font-weight: 700; font-display: swap; }
        :root { --accent: #ffb80e; --dark: #231f20; --text: #1f2328; --muted: #6b7079; --bg: #f5f6f9; --card: #fff; --line: #eceef2; }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; font-family: TMM, system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); font-size: 16px; line-height: 1.45; -webkit-text-size-adjust: 100%; }
        a { color: inherit; }
        :root { --accent: @design.Accent; --accent-text: @design.AccentText; }
        @if (design.Dark)
        {
            <text>:root { --bg: #121214; --card: #1d1d21; --text: #f2f2f3; --muted: #a3a7ae; --line: #2c2c31; --dark: #0b0b0c; }
            .tab.on { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }</text>
        }
        .cover { height: 150px; position: relative; background: radial-gradient(circle at 20% 30%, rgba(255,184,14,.35), transparent 45%), radial-gradient(circle at 85% 70%, rgba(255,184,14,.25), transparent 40%), var(--dark); background-size: cover; background-position: center; }
        .cover.photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,.1)); }
        .lang { position: absolute; z-index: 1; top: 12px; right: 12px; display: flex; background: rgba(0,0,0,.35); border-radius: 20px; padding: 3px; }
        .lang a { color: #fff; text-decoration: none; font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: 16px; text-transform: uppercase; }
        .lang a.on { background: var(--accent); color: var(--accent-text); }
        .wrap { max-width: 760px; margin: 0 auto; padding: 0 14px; }
        .head { background: var(--card); border-radius: 18px; margin-top: -56px; position: relative; padding: 18px; box-shadow: 0 6px 24px rgba(0,0,0,.08); display: flex; gap: 14px; align-items: center; }
        .logo { width: 64px; height: 64px; border-radius: 50%; flex: none; background: #231f20 center/cover no-repeat; color: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; }
        .head h1 { margin: 0; font-size: 22px; line-height: 1.2; }
        .head .addr { color: var(--muted); font-size: 14px; margin-top: 4px; }
        .chips { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
        .chip { font-size: 12px; background: color-mix(in srgb, var(--accent) 18%, var(--card)); color: var(--text); border-radius: 12px; padding: 2px 9px; font-weight: 700; }
        .tabs { position: sticky; top: 0; z-index: 5; background: var(--bg); display: flex; gap: 8px; overflow-x: auto; padding: 14px 0 10px; scrollbar-width: none; }
        .tabs::-webkit-scrollbar { display: none; }
        .tab { white-space: nowrap; text-decoration: none; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 7px 14px; font-size: 14px; font-weight: 700; }
        .tab.on { background: var(--dark); color: #fff; border-color: var(--dark); }
        .group { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 26px 2px 0; }
        section h2 { font-size: 20px; margin: 18px 2px 10px; }
        .dish { background: var(--card); border-radius: 16px; padding: 14px; display: flex; gap: 12px; margin-bottom: 10px; align-items: stretch; }
        .dish .dt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .dish h3 { margin: 0 0 4px; font-size: 16px; line-height: 1.25; }
        .dish p { margin: 0; color: var(--muted); font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .meta { margin-top: auto; padding-top: 10px; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
        .price { font-weight: 700; font-size: 17px; white-space: nowrap; }
        .w { color: var(--muted); font-size: 13px; }
        /* без фото ціна - праворуч, вага й рейтинг - ліворуч */
        .dish.nophoto .meta .price { order: 2; margin-left: auto; }
        .ph { width: 104px; height: 104px; border-radius: 12px; flex: none; background: var(--line) center/cover no-repeat; }
        .about { background: var(--card); border-radius: 16px; padding: 16px; margin: 22px 0 10px; }
        .about h2 { margin: 0 0 10px; font-size: 20px; }
        .row { display: flex; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); font-size: 15px; }
        .row:first-of-type { border-top: 0; }
        .row b { min-width: 96px; color: var(--muted); font-weight: 400; }
        .hours { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; }
        .hours .now { font-weight: 700; }
        .btn { display: inline-block; margin-top: 10px; background: var(--accent); color: var(--accent-text); text-decoration: none; font-weight: 700; border-radius: 10px; padding: 10px 16px; }
        .foot { text-align: center; color: var(--muted); font-size: 13px; padding: 18px 0 28px; }
        .foot a { text-decoration: none; }
        .foot img { height: 16px; vertical-align: -3px; margin-left: 4px; }
        .dish { cursor: pointer; }
        /* рамка фокусу - лише при навігації клавіатурою, не після кліку чи дотику */
        .dish:focus { outline: none; }
        .dish:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .sheet-bg { position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.5); display: none; align-items: flex-end; justify-content: center; }
        .sheet-bg.open { display: flex; }
        .sheet { background: var(--card); color: var(--text); width: 100%; max-width: 560px; max-height: 88vh; overflow: auto; border-radius: 20px 20px 0 0; padding-bottom: 20px; }
        .sheet .sp { width: 100%; aspect-ratio: 4 / 3; background: var(--line) center/cover no-repeat; border-radius: 20px 20px 0 0; }
        .sheet .sb { padding: 16px 18px 0; }
        .sheet h3 { margin: 0 0 8px; font-size: 20px; line-height: 1.25; }
        .sheet p { margin: 0 0 10px; color: var(--muted); font-size: 15px; white-space: pre-line; }
        .sheet .close { position: sticky; top: 10px; float: right; margin: 10px 10px -46px 0; width: 36px; height: 36px; border: 0; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 20px; line-height: 36px; cursor: pointer; z-index: 1; }
        @@media (min-width: 720px) { .sheet-bg { align-items: center; } .sheet { border-radius: 20px; } }
        [hidden] { display: none !important; }
        .open { display: inline-block; margin-top: 6px; font-size: 13px; font-weight: 700; border-radius: 10px; padding: 2px 9px; }
        .open.on { background: #e3f6e9; color: #1b7f3b; }
        .open.off { background: var(--line); color: var(--muted); }
        .bar { position: sticky; top: 0; z-index: 5; background: var(--bg); padding-top: 12px; }
        .bar .tabs { position: static; padding-top: 10px; }
        .search { width: 100%; min-height: 42px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--text); font: inherit; font-size: 15px; }
        .search:focus { outline: 2px solid var(--accent); outline-offset: 0; }
        section { scroll-margin-top: 120px; }
        .rate { color: #b7791f; font-size: 13px; font-weight: 700; white-space: nowrap; }
        .popular h2 { font-size: 20px; margin: 18px 2px 10px; }
        .pop-row { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
        .pop-row::-webkit-scrollbar { display: none; }
        .dish.pop { flex: 0 0 156px; flex-direction: column; gap: 8px; margin: 0; padding: 10px; }
        .dish.pop .ph { width: 100%; height: 110px; }
        .dish.pop h3 { font-size: 14px; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .dish.pop .meta { padding-top: 0; }
        .sheet .variants { color: var(--text); }
        .sheet .rating { color: #b7791f; font-weight: 700; }
        .empty { background: var(--card); border-radius: 16px; padding: 24px; text-align: center; color: var(--muted); margin-top: 14px; }
        @@media (min-width: 720px) { .cover { height: 200px; } .dish .ph { width: 120px; height: 120px; } .head h1 { font-size: 26px; } }
    </style>
</head>
<body>
    <div class="cover @(cover != null ? "photo" : "")" style="@coverStyle">
        @if (locales.Count > 1)
        {
            <nav class="lang">
                @foreach (var lang in locales)
                {
                    <a class="@(lang == culture ? "on" : "")" href="@Regex.Replace(crq.Path.Value, "^/(ru|uk|en)/", $"/{lang}/")@crq.QueryString">@(lang == "uk" ? "UA" : lang.ToUpper())</a>
                }
            </nav>
        }
    </div>
    <div class="wrap">
        <header class="head">
            @if (!string.IsNullOrEmpty(info.Logo))
            {
                <div class="logo" style="background-image: url('@Img.Url(info.Logo, Quality.Low)')"></div>
            }
            else
            {
                <div class="logo">@initials</div>
            }
            <div>
                <h1>@Model.Restaurant.Name</h1>
                <div class="addr">@fullAddress</div>
                @if (openNow == true)
                {
                    <div class="open on">@openText@(openUntil != null ? " · " + openUntil : "")</div>
                }
                else if (openNow == false)
                {
                    <div class="open off">@Capital(Localizer["Closed"].Value)</div>
                }
                @if (cuisines.Any())
                {
                    <div class="chips">@foreach (var c in cuisines) { <span class="chip">@c</span> }</div>
                }
            </div>
        </header>

        @if (categories.Any(c => c.Dishes != null && c.Dishes.Any()))
        {
            <div class="bar" id="bar">
            <input type="search" id="q" class="search" placeholder="@Capital(Localizer["MenuSearch"].Value)" autocomplete="off" />
            <nav class="tabs" id="tabs">
                @foreach (var c in categories.Where(c => c.Dishes != null && c.Dishes.Any()))
                {
                    <a class="tab" href="#c-@c.Id">@Sentence(((IMenuCategory)c).Name.Get(culture))</a>
                }
            </nav>
            </div>
            <div class="empty" id="noResults" hidden>@Localizer["NoItems"]</div>

            if (popular.Any())
            {
                <section class="popular" id="popular">
                    <h2>@Capital(Localizer["TopDishes"].Value)</h2>
                    <div class="pop-row">
                        @foreach (var item in popular)
                        {
                            var pc = item.Value;
                            <article class="dish pop" tabindex="0" role="button" data-title="@pc.Title" data-desc="@pc.FullDesc" data-ingr="@pc.Ingr"
                                     data-photo="@pc.PhotoHigh" data-price="@pc.PriceText" data-weight="@pc.Weight" data-variants="@pc.Variants" data-rating="@pc.RatingText">
                                @if (pc.Photo != null)
                                {
                                    <div class="ph" style="background-image: url('@pc.Photo')"></div>
                                }
                                <h3>@pc.Title</h3>
                                <div class="meta"><span class="price">@pc.PriceText</span><span class="rate">★ @pc.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span></div>
                            </article>
                        }
                    </div>
                </section>
            }

            foreach (var c in categories)
            {
                if (c.Dishes == null || !c.Dishes.Any())
                {
                    <div class="group">@Sentence(((IMenuCategory)c).Name.Get(culture))</div>
                    continue;
                }
                <section id="c-@c.Id">
                    <h2>@Sentence(((IMenuCategory)c).Name.Get(culture))</h2>
                    @foreach (var dish in c.Dishes)
                    {
                        dishIndex++;
                        var card = cards[dish.Id];
                        <article class="dish@(card.Photo == null ? " nophoto" : "")" tabindex="0" role="button" data-title="@card.Title" data-desc="@card.FullDesc" data-ingr="@card.Ingr"
                                 data-photo="@card.PhotoHigh" data-price="@card.PriceText" data-weight="@card.Weight" data-variants="@card.Variants" data-rating="@card.RatingText">
                            <div class="dt">
                                <h3>@card.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(card.Desc))
                                {
                                    <p>@card.Desc</p>
                                }
                                <div class="meta">
                                    @if (card.PriceText != null)
                                    {
                                        <span class="price">@card.PriceText</span>
                                    }
                                    @if (card.Weight != null)
                                    {
                                        <span class="w">@card.Weight</span>
                                    }
                                    @if (card.RatingCount > 0)
                                    {
                                        <span class="rate">★ @card.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) <span class="w">(@card.RatingCount)</span></span>
                                    }
                                </div>
                            </div>
                            @if (card.Photo != null)
                            {
                                <div class="ph" role="img" aria-label="@card.Title" style="background-image: url('@card.Photo')" @(dishIndex > 8 ? "data-lazy" : "")></div>
                            }
                        </article>
                    }
                </section>
            }
        }
        else
        {
            <div class="empty">@Localizer["NoItems"]</div>
        }

        <section class="about" id="about">
            <h2>@aboutTitle</h2>
            <div class="row"><b>@Localizer["Address"]</b><span>@fullAddress</span></div>
            @if (days != null && days.Count >= 7)
            {
                <div class="row">
                    <b>@Localizer["WorkHours"]</b>
                    <div class="hours">
                        @for (var i = 0; i < 7; i++)
                        {
                            <span class="@(i == today ? "now" : "")">@Localizer[dayNames[i]]</span><span class="@(i == today ? "now" : "")">@Hours(days[i])</span>
                        }
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.OpenHours))
            {
                <div class="row"><b>@Localizer["WorkHours"]</b><span>@Model.OpenHours</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Restaurant.Phone))
            {
                <div class="row"><b>@Localizer["Phone"]</b><a href="tel:@Model.Restaurant.Phone">@Model.Restaurant.Phone</a></div>
            }
            @if (!string.IsNullOrWhiteSpace(website))
            {
                <div class="row"><b>@Localizer["Website"]</b><a href="@website" target="_blank" rel="noopener">@Regex.Replace(website, "^https?://(www\\.)?|/$", "")</a></div>
            }
            @if (!string.IsNullOrWhiteSpace(instagram))
            {
                <div class="row"><b>Instagram</b><a href="https://@instagram" target="_blank" rel="noopener">@@@Regex.Replace(instagram, "^(www\\.)?instagram\\.com/|/$", "")</a></div>
            }
            @if (!string.IsNullOrEmpty(info.GpsLatitude) && !string.IsNullOrEmpty(info.GpsLongitude))
            {
                <a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=@info.GpsLatitude,@info.GpsLongitude">@Localizer["Directions"]</a>
            }
        </section>

        <footer class="foot">
            @Localizer["LastMenuUpdate"]: @Model.Restaurant.UpdateDate.ToString("dd.MM.yyyy") ·
            <a href="//tipmymenu.com/@culture/@citySlug/restaurant/@(seo?.Url)" target="_blank" rel="noopener">Powered by <img src="//tipmymenu.com/images/site_logo_dark.svg" alt="TipMyMenu" /></a>
        </footer>
    </div>

    <div class="sheet-bg" id="sheet" aria-hidden="true">
        <div class="sheet" role="dialog" aria-modal="true">
            <button class="close" type="button" aria-label="×">×</button>
            <div class="sp" id="sheetPhoto"></div>
            <div class="sb">
                <h3 id="sheetTitle"></h3>
                <p id="sheetDesc"></p>
                <p id="sheetIngr"></p>
                <p class="variants" id="sheetVariants"></p>
                <p class="rating" id="sheetRating"></p>
                <div class="meta"><span class="price" id="sheetPrice"></span><span class="w" id="sheetWeight"></span></div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            // картка страви поверх меню - відвідувач лишається на сайті закладу
            var sheet = document.getElementById('sheet');
            function set(id, text) { var el = document.getElementById(id); el.textContent = text || ''; el.style.display = text ? '' : 'none'; }
            function openDish(d) {
                var photo = document.getElementById('sheetPhoto');
                photo.style.display = d.dataset.photo ? '' : 'none';
                photo.style.backgroundImage = d.dataset.photo ? "url('" + d.dataset.photo + "')" : '';
                set('sheetTitle', d.dataset.title); set('sheetDesc', d.dataset.desc); set('sheetIngr', d.dataset.ingr);
                set('sheetPrice', d.dataset.price); set('sheetWeight', d.dataset.weight);
                set('sheetVariants', d.dataset.variants); set('sheetRating', d.dataset.rating);
                sheet.classList.add('open'); sheet.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
            }
            function closeDish() { sheet.classList.remove('open'); sheet.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
            document.querySelectorAll('.dish').forEach(function (d) {
                d.addEventListener('click', function () { openDish(d); });
                d.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDish(d); } });
            });
            sheet.addEventListener('click', function (e) { if (e.target === sheet || e.target.classList.contains('close')) closeDish(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDish(); });

            // пошук по меню: назва, опис, склад; розділи без збігів ховаються
            var q = document.getElementById('q');
            if (!q) return;
            var sections = document.querySelectorAll('section[id^="c-"]'), groups = document.querySelectorAll('.group');
            var popularBlock = document.getElementById('popular'), noResults = document.getElementById('noResults');
            q.addEventListener('input', function () {
                var term = q.value.trim().toLowerCase(), total = 0;
                sections.forEach(function (sec) {
                    var shown = 0;
                    sec.querySelectorAll('.dish').forEach(function (d) {
                        var hay = ((d.dataset.title || '') + ' ' + (d.dataset.desc || '') + ' ' + (d.dataset.ingr || '')).toLowerCase();
                        var ok = !term || hay.indexOf(term) >= 0;
                        d.style.display = ok ? '' : 'none';
                        if (ok) shown++;
                    });
                    sec.style.display = shown ? '' : 'none';
                    total += shown;
                });
                groups.forEach(function (g) { g.style.display = term ? 'none' : ''; });
                if (popularBlock) popularBlock.style.display = term ? 'none' : '';
                noResults.hidden = total > 0;
            });
        })();
        (function () {
            // фото далеких страв - коли до них доходить прокрутка
            var lazy = document.querySelectorAll('[data-lazy]');
            if ('IntersectionObserver' in window) {
                lazy.forEach(function (el) { var bg = el.style.backgroundImage; el.style.backgroundImage = ''; el.dataset.bg = bg; });
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) { if (e.isIntersecting) { e.target.style.backgroundImage = e.target.dataset.bg; io.unobserve(e.target); } });
                }, { rootMargin: '400px' });
                lazy.forEach(function (el) { io.observe(el); });
            }
            // активна вкладка розділу під час прокрутки
            var tabs = document.querySelectorAll('.tab'), nav = document.getElementById('tabs');
            if (!tabs.length || !('IntersectionObserver' in window)) return;
            var byId = {};
            tabs.forEach(function (t) { byId[t.getAttribute('href').slice(1)] = t; });
            var spy = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    tabs.forEach(function (t) { t.classList.remove('on'); });
                    var t = byId[e.target.id];
                    if (t) { t.classList.add('on'); nav.scrollTo({ left: t.offsetLeft - 14, behavior: 'smooth' }); }
                });
            }, { rootMargin: '-130px 0px -65% 0px' });
            document.querySelectorAll('section[id^="c-"]').forEach(function (s) { spy.observe(s); });
            tabs[0].classList.add('on');
        })();
    </script>
</body>
</html>
