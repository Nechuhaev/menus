@* Меню ресторану для вбудовування на сайт закладу (iframe). Дизайн TipMyMenu: обкладинка, картка закладу, вкладки
   розділів, страви картками, «Про заклад». Один шаблон для живої сторінки (/{мова}/{місто}/iframe/{slug}) і для кешу
   (IframeController.Clean). Посилання на tipmymenu.com - без схеми (//tipmymenu.com): кеш на frm.tipmymenu.com
   замінює «https://tipmymenu.com» на CDN фото. *@
@using System.Text.RegularExpressions
@using Menus.Abstract.Models
@using Menus.Web.Models.ViewModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using Microsoft.AspNetCore.Mvc.Localization
@model Menus.Web.Models.ViewModels.RestaurantViewModel
@inject IViewLocalizer Localizer
@inject Menus.Domain.Core Core
@{
    Layout = null;
    var crq = Context.Request;
    var culture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>().RequestCulture.Culture.TwoLetterISOLanguageName;
    var seo = ViewData["seo"] as IRestaurantSeo;
    var iframeSettings = ViewData["iframeSettings"] as IframeSettingsModel;
    var locales = (iframeSettings?.Languages ?? Enumerable.Empty<Menus.Abstract.Models.ILocale>()).Where(x => x.Id == "uk" || x.Id == "ru" || x.Id == culture).ToList();
    var city = await Core.Restaurants.GetCityById(Model.Restaurant.City);
    var citySlug = city?.Name.Get("en")?.ToLower() ?? "kyiv";
    var cityName = city?.Name.Get(culture) ?? "";
    var info = Model.RestaurantInfo;
    var address = info.DisplayAddress?.Get(culture);
    var fullAddress = string.IsNullOrWhiteSpace(address) ? cityName : $"{cityName}, {address}";
    var cuisines = (info.Cuisine?.Get(culture) ?? "").Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).Take(3).ToList();
    var currency = string.IsNullOrWhiteSpace(info.Currency) ? "₴" : info.Currency;
    var cover = Model.Photos?.FirstOrDefault();
    var coverStyle = cover != null ? $"background-image: url('{Img.Url(cover, Quality.High)}')" : null;
    var initials = string.Concat((Model.Restaurant.Name ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    // порядок розділів - як в адмінці (Index); у меню з групами (Clean) порядок уже задано групами
    var allCategories = Model.Menu.Categories.Any(c => c.IsTopLevelCategory) ? Model.Menu.Categories : Model.Menu.Categories.OrderBy(c => c.Index).ToList();
    var categories = allCategories.Where(c => c.IsTopLevelCategory || (c.Dishes != null && c.Dishes.Any())).ToList();
    var aboutTitle = Localizer["AboutPlace"].IsResourceNotFound ? "Про заклад" : Localizer["AboutPlace"].Value;
    string Hours(JToken day) => day["active"].Value<bool>() ? $"{day["from"].Value<string>()} — {day["to"].Value<string>()}" : Localizer["Closed"].Value;
    JArray days = null;
    if (Model.SchedulePerDay) { try { days = JsonConvert.DeserializeObject<JArray>(Model.OpenHours); } catch (Exception) { days = null; } }
    var dayNames = new[] { "Mon", "Tue", "Wed", "Thr", "Fri", "Sat", "Sun" };
    var today = (int)DateTime.Now.DayOfWeek; today = today == 0 ? 6 : today - 1;
    var dishIndex = 0;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="NOINDEX,FOLLOW" />
    <title>@Model.Restaurant.Name - меню | TipMyMenu</title>
    <style>
        @@font-face { font-family: TMM; src: url(//tipmymenu.com/fonts/GTWalsheimPro-Regular.woff2) format("woff2"); font-weight: 400; font-display: swap; }
        @@font-face { font-family: TMM; src: url(//tipmymenu.com/fonts/gtwalsheimpro-bold-webfont.woff) format("woff"); font-weight: 700; font-display: swap; }
        :root { --accent: #ffb80e; --dark: #231f20; --text: #1f2328; --muted: #6b7079; --bg: #f5f6f9; --card: #fff; --line: #eceef2; }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; font-family: TMM, system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); font-size: 16px; line-height: 1.45; -webkit-text-size-adjust: 100%; }
        a { color: inherit; }
        .cover { height: 150px; position: relative; background: radial-gradient(circle at 20% 30%, rgba(255,184,14,.35), transparent 45%), radial-gradient(circle at 85% 70%, rgba(255,184,14,.25), transparent 40%), var(--dark); background-size: cover; background-position: center; }
        .cover.photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.35), rgba(0,0,0,.1)); }
        .lang { position: absolute; z-index: 1; top: 12px; right: 12px; display: flex; background: rgba(0,0,0,.35); border-radius: 20px; padding: 3px; }
        .lang a { color: #fff; text-decoration: none; font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: 16px; text-transform: uppercase; }
        .lang a.on { background: var(--accent); color: var(--dark); }
        .wrap { max-width: 760px; margin: 0 auto; padding: 0 14px; }
        .head { background: var(--card); border-radius: 18px; margin-top: -56px; position: relative; padding: 18px; box-shadow: 0 6px 24px rgba(0,0,0,.08); display: flex; gap: 14px; align-items: center; }
        .logo { width: 64px; height: 64px; border-radius: 50%; flex: none; background: var(--dark) center/cover no-repeat; color: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; }
        .head h1 { margin: 0; font-size: 22px; line-height: 1.2; }
        .head .addr { color: var(--muted); font-size: 14px; margin-top: 4px; }
        .chips { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
        .chip { font-size: 12px; background: #fff6dd; color: #7a5200; border-radius: 12px; padding: 2px 9px; font-weight: 700; }
        .tabs { position: sticky; top: 0; z-index: 5; background: var(--bg); display: flex; gap: 8px; overflow-x: auto; padding: 14px 0 10px; scrollbar-width: none; }
        .tabs::-webkit-scrollbar { display: none; }
        .tab { white-space: nowrap; text-decoration: none; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 7px 14px; font-size: 14px; font-weight: 700; }
        .tab.on { background: var(--dark); color: #fff; border-color: var(--dark); }
        .group { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 26px 2px 0; }
        section { scroll-margin-top: 64px; }
        section h2 { font-size: 20px; margin: 18px 2px 10px; }
        .dish { background: var(--card); border-radius: 16px; padding: 14px; display: flex; gap: 12px; margin-bottom: 10px; align-items: stretch; }
        .dish .dt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .dish h3 { margin: 0 0 4px; font-size: 16px; line-height: 1.25; }
        .dish p { margin: 0; color: var(--muted); font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .meta { margin-top: auto; padding-top: 10px; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
        .price { font-weight: 700; font-size: 17px; white-space: nowrap; }
        .w { color: var(--muted); font-size: 13px; }
        .ph { width: 104px; height: 104px; border-radius: 12px; flex: none; background: var(--line) center/cover no-repeat; }
        .about { background: var(--card); border-radius: 16px; padding: 16px; margin: 22px 0 10px; }
        .about h2 { margin: 0 0 10px; font-size: 20px; }
        .row { display: flex; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); font-size: 15px; }
        .row:first-of-type { border-top: 0; }
        .row b { min-width: 96px; color: var(--muted); font-weight: 400; }
        .hours { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; }
        .hours .now { font-weight: 700; }
        .btn { display: inline-block; margin-top: 10px; background: var(--accent); color: var(--dark); text-decoration: none; font-weight: 700; border-radius: 10px; padding: 10px 16px; }
        .foot { text-align: center; color: var(--muted); font-size: 13px; padding: 18px 0 28px; }
        .foot a { text-decoration: none; }
        .foot img { height: 16px; vertical-align: -3px; margin-left: 4px; }
        .empty { background: var(--card); border-radius: 16px; padding: 24px; text-align: center; color: var(--muted); margin-top: 14px; }
        @@media (min-width: 720px) { .cover { height: 200px; } .dish .ph { width: 120px; height: 120px; } .head h1 { font-size: 26px; } }
    </style>
</head>
<body>
    <div class="cover @(cover != null ? "photo" : "")" style="@coverStyle">
        @if (locales.Count > 1)
        {
            <nav class="lang">
                @foreach (var lang in locales)
                {
                    <a class="@(lang.Id == culture ? "on" : "")" href="@Regex.Replace(crq.Path.Value, "^/(ru|uk|en)/", $"/{lang.Id}/")@crq.QueryString">@(lang.Id == "uk" ? "UA" : lang.Id.ToUpper())</a>
                }
            </nav>
        }
    </div>
    <div class="wrap">
        <header class="head">
            @if (!string.IsNullOrEmpty(info.Logo))
            {
                <div class="logo" style="background-image: url('@Img.Url(info.Logo, Quality.Low)')"></div>
            }
            else
            {
                <div class="logo">@initials</div>
            }
            <div>
                <h1>@Model.Restaurant.Name</h1>
                <div class="addr">@fullAddress</div>
                @if (cuisines.Any())
                {
                    <div class="chips">@foreach (var c in cuisines) { <span class="chip">@c</span> }</div>
                }
            </div>
        </header>

        @if (categories.Any(c => c.Dishes != null && c.Dishes.Any()))
        {
            <nav class="tabs" id="tabs">
                @foreach (var c in categories.Where(c => c.Dishes != null && c.Dishes.Any()))
                {
                    <a class="tab" href="#c-@c.Id">@(((IMenuCategory)c).Name.Get(culture))</a>
                }
            </nav>

            foreach (var c in categories)
            {
                if (c.Dishes == null || !c.Dishes.Any())
                {
                    <div class="group">@(((IMenuCategory)c).Name.Get(culture))</div>
                    continue;
                }
                <section id="c-@c.Id">
                    <h2>@(((IMenuCategory)c).Name.Get(culture))</h2>
                    @foreach (var dish in c.Dishes)
                    {
                        dishIndex++;
                        var photo = dish.Photos?.FirstOrDefault();
                        var description = dish.ShortDescription?.Get(culture);
                        <article class="dish">
                            <div class="dt">
                                <h3>@(Menus.Web.Helpers.DishName.Title(dish.Name, culture))</h3>
                                @if (!string.IsNullOrWhiteSpace(description))
                                {
                                    <p>@description</p>
                                }
                                <div class="meta">
                                    @if (dish.Price != 0)
                                    {
                                        <span class="price">@(dish.IsPriceMultiple ? Localizer["From"].Value + " " : "")@dish.Price.ToString("0.##") @currency</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dish.Weight) && dish.Weight != "0")
                                    {
                                        <span class="w">@dish.Weight @dish.WeightType</span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(photo))
                            {
                                <div class="ph" role="img" aria-label="@(Menus.Web.Helpers.DishName.Title(dish.Name, culture))" style="background-image: url('@Img.Url(photo, Quality.Low)')" @(dishIndex > 8 ? "data-lazy" : "")></div>
                            }
                        </article>
                    }
                </section>
            }
        }
        else
        {
            <div class="empty">@Localizer["NoItems"]</div>
        }

        <section class="about" id="about">
            <h2>@aboutTitle</h2>
            <div class="row"><b>@Localizer["Address"]</b><span>@fullAddress</span></div>
            @if (days != null && days.Count >= 7)
            {
                <div class="row">
                    <b>@Localizer["WorkHours"]</b>
                    <div class="hours">
                        @for (var i = 0; i < 7; i++)
                        {
                            <span class="@(i == today ? "now" : "")">@Localizer[dayNames[i]]</span><span class="@(i == today ? "now" : "")">@Hours(days[i])</span>
                        }
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.OpenHours))
            {
                <div class="row"><b>@Localizer["WorkHours"]</b><span>@Model.OpenHours</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Restaurant.Phone))
            {
                <div class="row"><b>@Localizer["Phone"]</b><a href="tel:@Model.Restaurant.Phone">@Model.Restaurant.Phone</a></div>
            }
            @if (!string.IsNullOrEmpty(info.GpsLatitude) && !string.IsNullOrEmpty(info.GpsLongitude))
            {
                <a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=@info.GpsLatitude,@info.GpsLongitude">@Localizer["Directions"]</a>
            }
        </section>

        <footer class="foot">
            @Localizer["LastMenuUpdate"]: @Model.Restaurant.UpdateDate.ToString("dd.MM.yyyy") ·
            <a href="//tipmymenu.com/@culture/@citySlug/restaurant/@(seo?.Url)" target="_blank" rel="noopener">Powered by <img src="//tipmymenu.com/images/site_logo_dark.svg" alt="TipMyMenu" /></a>
        </footer>
    </div>

    <script>
        (function () {
            // фото далеких страв - коли до них доходить прокрутка
            var lazy = document.querySelectorAll('[data-lazy]');
            if ('IntersectionObserver' in window) {
                lazy.forEach(function (el) { var bg = el.style.backgroundImage; el.style.backgroundImage = ''; el.dataset.bg = bg; });
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) { if (e.isIntersecting) { e.target.style.backgroundImage = e.target.dataset.bg; io.unobserve(e.target); } });
                }, { rootMargin: '400px' });
                lazy.forEach(function (el) { io.observe(el); });
            }
            // активна вкладка розділу під час прокрутки
            var tabs = document.querySelectorAll('.tab'), nav = document.getElementById('tabs');
            if (!tabs.length || !('IntersectionObserver' in window)) return;
            var byId = {};
            tabs.forEach(function (t) { byId[t.getAttribute('href').slice(1)] = t; });
            var spy = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    tabs.forEach(function (t) { t.classList.remove('on'); });
                    var t = byId[e.target.id];
                    if (t) { t.classList.add('on'); nav.scrollTo({ left: t.offsetLeft - 14, behavior: 'smooth' }); }
                });
            }, { rootMargin: '-70px 0px -70% 0px' });
            document.querySelectorAll('section[id^="c-"]').forEach(function (s) { spy.observe(s); });
            tabs[0].classList.add('on');
        })();
    </script>
</body>
</html>
