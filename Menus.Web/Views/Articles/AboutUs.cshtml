@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject Menus.Web.Services.SiteStatsService SiteStats

@{
    ViewData["Title"] = Localizer["MetaTitle"];
    ViewData["Description"] = Localizer["MetaDescription"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = await SiteStats.Get();
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/";
}

@section JsonLd {
    @(Menus.Web.Helpers.JsonLd.Script(
        Menus.Web.Helpers.JsonLd.Organization(siteUrl, siteUrl + "images/logo_tip_menu.png",
            "https://www.facebook.com/tipmymenu/", "https://www.instagram.com/tipmymenu/"),
        Menus.Web.Helpers.JsonLd.AboutPage(siteUrl, $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}", Localizer["AboutUs"].Value)))
}

@section Styles {
    <style>
        .about-facts { padding: 40px 0; }
        .about-facts h2 { text-align: center; margin-bottom: 24px; }
        .about-facts ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; max-width: 900px; margin: 0 auto; padding: 0; list-style: none; }
        .about-facts li { padding: 16px; border: 1px solid #e5e5e5; border-radius: 6px; text-align: center; }
        .about-facts strong { display: block; font-size: 28px; }
        .about-facts p { max-width: 900px; margin: 20px auto 0; text-align: center; }
    </style>
}

@await Html.PartialAsync("_Header")



<div class="site-content">
    <main>



        <div class="breadcrumbs breadcrumbs-content breadcrumbs-content-position">
            <ul>
                <li><breadcrumb asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</breadcrumb></li>
                <li><breadcrumb href="#">@Localizer["AboutUs"]</breadcrumb></li>
            </ul>
        </div>



        <div class="about_us_area">
            <div class="about_us_left">
                <div class="about_us_content">
                    <figure>
                        <img src="~/images/logo_tip_menu.png" alt="" />
                    </figure>
                    @Localizer["EatWriteShare"] ;)

                </div>
            </div>
            <div class="about_us_right">
                <img src="~/images/about_us.jpg" class="disable_on_mobile" alt="" />
                <img src="~/images/about_us_mobile.jpg" class="disable_on_desktop" alt="" />
            </div>
        </div>



        <div class="about_us_text">
            @Localizer["AboutUsText"]<span class="fa-fw select-all far"></span>
        </div>



        <div class="about_us_services">

            <h1>@Localizer["YouCan"]</h1>

            <ul class="disable_on_mobile">
                <li>
                    <em>
                        <span class="fa-fw select-all fas"></span>
                    </em>
                    <strong>@Localizer["Find"]</strong>
                    @Localizer["InWhichRestaurant"]<span>@Localizer["ToEat"]</span>@Localizer["WhatYouWant"]
                </li>
                <li>
                    <em>
                        <span class="fa-fw select-all fas"></span>
                    </em>
                    <strong>@Localizer["ChooseDish"]</strong>
                    @Localizer["ByRating"]<span>@Localizer["FromGuests"]</span>@Localizer["AlreadyVisited"]<span>@Localizer["ThisInstitution"]</span>
                </li>
                <li>
                    <em>
                        <span class="fa-fw select-all fas"></span>
                    </em>
                    <strong>@Localizer["Familiarize"]</strong>
                    @Localizer["RestaurantMenu"]<span>@Localizer["WhereAreYou"]</span> @Localizer["Going"]
                </li>
                <li>
                    <em>
                        <span class="fa-fw select-all fas"></span>
                    </em>
                    <strong>@Localizer["RateTheDish"]</strong>
                    @Localizer["WhichYouTried"]<span>@Localizer["AddIt"]</span>@Localizer["PhotoAndShare"]<span>@Localizer["OpinionOrComment"]</span>
                </li>
                <li>
                    <em>
                        <span class="fa-fw select-all fas"></span>
                    </em>
                    <strong>@Localizer["AddToService"]</strong>
                    @Localizer["Institution"]<span>@Localizer["WeMissed"]</span>
                </li>
            </ul>

            <!-- Swiper -->
            <div class="swiper-about-wrapper disable_on_desktop">
                <div class="swiper-container swiper-about">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <div class="swiper-caption">
                                <em>
                                    <span class="fa-fw select-all fas"></span>
                                </em>
                                <strong>@Localizer["Find"]</strong>
                                @Localizer["InWhichRestaurant"]<span>@Localizer["ToEat"]</span>@Localizer["WhatYouWant"]
                            </div>
                        </div>
                        <div class="swiper-slide">
                            <div class="swiper-caption">
                                <em>
                                    <span class="fa-fw select-all fas"></span>
                                </em>
                                <strong>@Localizer["ChooseDish"]</strong>
                                @Localizer["ByRating"]<span>@Localizer["FromGuests"]</span>@Localizer["AlreadyVisited"]<span>@Localizer["ThisInstitution"]</span>
                            </div>
                        </div>
                        <div class="swiper-slide">
                            <div class="swiper-caption">
                                <em>
                                    <span class="fa-fw select-all fas"></span>
                                </em>
                                <strong>@Localizer["Familiarize"]</strong>
                                @Localizer["RestaurantMenu"]<span>@Localizer["WhereAreYou"]</span>@Localizer["Going"]
                            </div>
                        </div>
                        <div class="swiper-slide">
                            <div class="swiper-caption">
                                <em>
                                    <span class="fa-fw select-all fas"></span>
                                </em>
                                <strong>@Localizer["RateTheDish"]</strong>
                                @Localizer["WhichYouTried"]<span>@Localizer["AddIt"]</span>@Localizer["PhotoAndShare"]<span>@Localizer["OpinionOrComment"]</span>
                            </div>
                        </div>
                        <div class="swiper-slide">
                            <div class="swiper-caption">
                                <em>
                                    <span class="fa-fw select-all fas"></span>
                                </em>
                                <strong>@Localizer["AddToService"]</strong>
                                @Localizer["Institution"]<span>@Localizer["WeMissed"]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Add Pagination -->
                <div class="swiper-about-pagination"></div>
            </div>

        </div>



        <div class="about_us_block_1">
            <div class="wrapper">
                <p>@Localizer["AboutUsBlock1"]</p>
                <a href="#" class="btn_more" data-sign-up>@Localizer["Register"]</a>
            </div>
        </div>



        <div class="about_us_info">
            <h2>@Localizer["AboutUsInfo1"]<span>@Localizer["AboutUsInfo2"]</span>@Localizer["AboutUsInfo3"]</h2>
            <ul class="about_us_desktop_info disable_on_mobile">
                <li>
                    <div class="caption">
                        <em>01</em>
                        <strong>@Localizer["FullyControl"]<span>@Localizer["YourReputation"]</span></strong>
                        @Localizer["OnOurResourse"]<span>@Localizer["YourProfile"]</span>
                    </div>
                    <figure>
                        <img src="~/images/info_img_1.jpg" alt="Alternate Text" />
                    </figure>
                </li>
                <li>
                    <figure>
                        <img src="~/images/info_img_2.jpg" alt="Alternate Text" />
                    </figure>
                    <div class="caption">
                        <em>03</em>
                        <strong>@Localizer["GetRealFeedback"]<span>@Localizer["AboutIndividualPositions"]</span>@Localizer["AndOptimizeIt"]</strong>
                        @Localizer["DiscoverStarDishes"]<span>@Localizer["ImprovePositions"]</span>@Localizer["NotRemove"]<span>@Localizer["GuestsAreComing"]</span>
                    </div>
                </li>
                <li>
                    <div class="caption">
                        <em>02</em>
                        <strong>@Localizer["GetDirectAccess"]<span>@Localizer["TargetAudiency"]</span></strong>
                        @Localizer["FirstImpression"]<span>@Localizer["HighlightYour"]</span>@Localizer["GuestWillComeBack"]
                    </div>
                    <figure>
                        <img src="~/images/info_img_3.jpg" alt="Alternate Text" />
                    </figure>
                </li>
            </ul>
            <ul class="about_us_mobile_info disable_on_desktop">
                <li>
                    <figure>
                        <img src="~/images/info_img_mobile_1.jpg" alt="Alternate Text" />
                    </figure>
                    <div class="caption">
                        <em>01</em>
                        <strong>@Localizer["FullyControl"] @Localizer["YourReputation"]</strong>
                        @Localizer["OnOurResourse"]<span>@Localizer["YourProfile"]</span>
                    </div>
                </li>
                <li>
                    <figure>
                        <img src="~/images/info_img_mobile_2.jpg" alt="Alternate Text" />
                    </figure>
                    <div class="caption">
                        <em>02</em>
                        <strong>@Localizer["GetDirectAccessMob"]<span>@Localizer["AudiencyAndTools"]</span>@Localizer["InteractionWithIt"]</strong>
                        @Localizer["FirstImpressionMob"]<span>@Localizer["HighlightYourMob"]</span>@Localizer["GuestWillComeBackMob"]
                    </div>
                </li>
                <li>
                    <figure>
                        <img src="~/images/info_img_mobile_3.jpg" alt="Alternate Text" />
                    </figure>
                    <div class="caption">
                        <em>03</em>
                        <strong>@Localizer["GetRealFeedback"]<span>@Localizer["AboutIndividualPositions"]</span>@Localizer["AndOptimizeIt"]</strong>
                        @Localizer["DiscoverStarDishesMob"]<span>@Localizer["ImprovePositionsMob"]</span>@Localizer["NotRemoveMob"]<span>@Localizer["GuestsAreComing"]</span>
                    </div>
                </li>
            </ul>
        </div>



        <div class="about-facts">
            <div class="wrapper">
                <h2>@Localizer["FactsHeader"]</h2>
                <ul>
                    <li><strong>@Menus.Web.Helpers.JsonLd.FoundingYear</strong>@Localizer["FactSince"]</li>
                    <li><strong>@stats.Restaurants.ToString("N0")</strong>@Localizer["FactRestaurants"]</li>
                    <li><strong>@stats.Dishes.ToString("N0")</strong>@Localizer["FactDishes"]</li>
                    <li><strong>@stats.Cities</strong>@Localizer["FactCities"]</li>
                </ul>
                <p>@string.Format(Localizer["FactCompany"].Value, Menus.Web.Helpers.JsonLd.LegalName) <a href="mailto:@Menus.Web.Helpers.JsonLd.ContactEmail">@Menus.Web.Helpers.JsonLd.ContactEmail</a></p>
            </div>
        </div>

        <div class="about_us_block_2">
            <div class="wrapper">
                <p>@Localizer["AboutUsBlock2"]<span>@Localizer["AboutUsBlock3"]</span> <strong>@Localizer["AboutUsBlock4"]</strong></p>
                <p>@Localizer["AboutUsBlock5"]<span>@Localizer["AboutUsBlock6"]</span></p>
                <a asp-area="" asp-controller="Articles" asp-action="ForOwners" class="btn_more">@Localizer["Register"]</a>
            </div>
        </div>



    </main>
</div>





@section Scripts
    {

    <!-- Initialize Swiper -->

    <script src="~/js/jquery.js"></script>
    <script src="~/js/swiper.min.js"></script>
    <script src="~/js/typeahead-inner.js"></script>

    <!-- Initialize Swiper -->
    <script>
        var swiper = new Swiper('.swiper-about', {
            slidesPerView: 2,
            spaceBetween: 30,
            pagination: {
                el: '.swiper-about-pagination',
                clickable: true,
            },
        });
    </script>

}



@await Html.PartialAsync("_Footer")
