@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    // Лендинг «Меню для сайту закладу» (iframe): /uk/iframe-menu, /ru/iframe-menu
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;
    ViewData["Title"] = Localizer["MetaTitle"].Value;
    ViewData["Description"] = Localizer["MetaDescription"].Value;
    ViewData["BodyClass"] = "iframe-menu-page";

    // живий приклад - меню ресторану «Чачапурі»; посилання без схеми, як у самому iframe
    var exampleSrc = "//tipmymenu.com/" + culture + "/kyiv/iframe/chachapuri";
    var connectUrl = Url.Action("ForOwners", "Articles", new { culture, viewMode = "internal" });
    var codeSample = "<iframe src=\"https://tipmymenu.com/" + culture + "/kyiv/iframe/chachapuri"
        + "\" width=\"100%\" height=\"800\" style=\"border:0;max-width:100%\" loading=\"lazy\"></iframe>";

    var benefits = new[]
    {
        ("🔄", "B1"), ("⚡", "B2"), ("🎨", "B3"), ("📸", "B4"), ("🔍", "B5"),
        ("⭐", "B6"), ("🕒", "B7"), ("📱", "B8"), ("🚀", "B9")
    };
    var faq = Enumerable.Range(1, 7).Select(i => (Q: Localizer["Q" + i].Value, A: Localizer["A" + i].Value)).ToList();
    var faqJson = Newtonsoft.Json.JsonConvert.SerializeObject(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.Select(x => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = x.Q,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = x.A }
        }).ToList()
    });
}

@section JsonLd {
    <script type="application/ld+json">@Html.Raw(faqJson)</script>
}

@section Styles {
<style>
    .im { --accent: #ffb80e; --accent-h: #f0a800; --dark: #231f20; --text: #1f2328; --muted: #5f6670; --bg: #f5f6f9; --line: #eceef2;
          color: var(--text); background: #fff; font-size: 17px; line-height: 1.5; letter-spacing: normal; }
    /* body сайту темний (#231f20) - світлі розділи задають фон самі; реклама Google перед футером на лендингу зайва */
    .iframe-menu-page .google-footer-container { display: none; }
    .im * { box-sizing: border-box; }
    .im .im-wrap { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
    .im h1, .im h2, .im h3, .im p { letter-spacing: normal; text-transform: none; }

    .im .im-hero { background: radial-gradient(circle at 15% 20%, rgba(255,184,14,.28), transparent 45%), radial-gradient(circle at 90% 90%, rgba(255,184,14,.18), transparent 40%), var(--dark); color: #fff; padding: 56px 0 64px; overflow: hidden; }
    .im .im-hero .im-wrap { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
    .im .im-badge { display: inline-block; padding: 6px 12px; border-radius: 999px; background: rgba(255,184,14,.16); color: var(--accent); font-weight: 700; font-size: 14px; }
    .im .im-hero h1 { font-size: 52px; line-height: 1.08; margin: 18px 0 16px; font-weight: 700; color: #fff; }
    .im .im-hero h1 em { font-style: normal; color: var(--accent); }
    .im .im-lead { font-size: 20px; color: #d9d6d2; margin: 0 0 28px; max-width: 560px; }
    .im .im-cta { display: flex; flex-wrap: wrap; gap: 12px; }
    .im .im-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 26px; border-radius: 14px; font-weight: 700; font-size: 17px; text-decoration: none; }
    .im .im-btn-main { background: var(--accent); color: var(--dark); }
    .im .im-btn-main:hover { background: var(--accent-h); color: var(--dark); }
    .im .im-btn-ghost { border: 1px solid rgba(255,255,255,.28); color: #fff; }
    .im .im-btn-ghost:hover { background: rgba(255,255,255,.08); color: #fff; }
    .im .im-facts { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 30px; color: #bdb8b2; font-size: 15px; }
    .im .im-facts b { display: block; color: #fff; font-size: 22px; }
    .im .im-phone { margin: 0 auto; width: 340px; max-width: 100%; height: 660px; border: 10px solid #0e0c0d; border-radius: 38px; background: #fff; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,.45); }
    .im .im-phone iframe { width: 100%; height: 100%; border: 0; display: block; }
    .im .im-phone-note { text-align: center; color: #bdb8b2; font-size: 14px; margin: 12px 0 0; }

    .im .im-section { padding: 72px 0; background: #fff; color: var(--text); }
    .im .im-section.im-alt { background: var(--bg); }
    .im .im-section h2 { font-size: 38px; line-height: 1.15; margin: 0 0 10px; font-weight: 700; color: var(--text); }
    .im .im-sub { color: var(--muted); font-size: 19px; margin: 0 0 36px; max-width: 720px; }
    .im .im-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .im .im-card { background: var(--bg); border-radius: 18px; padding: 22px; }
    .im .im-alt .im-card { background: #fff; }
    .im .im-ico { width: 44px; height: 44px; border-radius: 12px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 14px; }
    .im .im-card h3 { margin: 0 0 6px; font-size: 19px; font-weight: 700; color: var(--text); }
    .im .im-card p { margin: 0; color: var(--muted); font-size: 16px; }
    .im .im-card.im-wide { grid-column: span 3; display: flex; gap: 18px; align-items: center; background: var(--dark); }
    .im .im-card.im-wide h3 { color: #fff; }
    .im .im-card.im-wide p { color: #d9d6d2; }
    .im .im-card.im-wide .im-ico { flex: none; margin: 0; }

    .im .im-steps { counter-reset: step; }
    .im .im-step { position: relative; padding-top: 64px; }
    .im .im-step::before { counter-increment: step; content: counter(step); position: absolute; top: 22px; left: 22px; width: 32px; height: 32px; border-radius: 50%; background: var(--dark); color: var(--accent); font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .im .im-code { margin-top: 28px; background: var(--dark); color: #f3efe9; border-radius: 18px; padding: 20px 22px; }
    .im .im-code h3 { margin: 0 0 10px; font-size: 17px; color: #fff; }
    .im .im-code pre { margin: 0; white-space: pre-wrap; word-break: break-all; font: 14px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--accent); }
    .im .im-code p { margin: 10px 0 0; color: #bdb8b2; font-size: 14px; }

    .im .im-features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 28px; list-style: none; padding: 0; margin: 0; }
    .im .im-features li { position: relative; padding-left: 32px; font-size: 17px; }
    .im .im-features li::before { content: "✓"; position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--dark); font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; }

    .im .im-faq { max-width: 820px; }
    .im .im-faq details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 0 20px; margin-bottom: 10px; }
    .im .im-faq summary { cursor: pointer; list-style: none; padding: 18px 28px 18px 0; font-weight: 700; font-size: 18px; position: relative; }
    .im .im-faq summary::-webkit-details-marker { display: none; }
    .im .im-faq summary::after { content: "+"; position: absolute; right: 0; top: 14px; font-size: 24px; color: var(--muted); }
    .im .im-faq details[open] summary::after { content: "–"; }
    .im .im-faq details p { margin: 0 0 18px; color: var(--muted); font-size: 16px; }

    .im .im-final { background: var(--dark); color: #fff; text-align: center; padding: 64px 0; }
    .im .im-final h2 { color: #fff; margin: 0 0 10px; font-size: 36px; }
    .im .im-final p { color: #d9d6d2; margin: 0 0 26px; font-size: 19px; }

    @@media (max-width: 900px) {
        .im .im-hero { padding: 36px 0 44px; }
        .im .im-hero .im-wrap { grid-template-columns: 1fr; gap: 32px; }
        .im .im-hero h1 { font-size: 36px; }
        .im .im-lead { font-size: 18px; }
        .im .im-phone { width: 300px; height: 560px; }
        .im .im-grid { grid-template-columns: 1fr 1fr; }
        .im .im-card.im-wide { grid-column: span 2; }
        .im .im-section { padding: 48px 0; }
        .im .im-section h2, .im .im-final h2 { font-size: 28px; }
    }
    @@media (max-width: 560px) {
        .im .im-wrap { padding: 0 16px; }
        .im .im-grid, .im .im-features { grid-template-columns: 1fr; }
        .im .im-card.im-wide { grid-column: span 1; flex-direction: column; align-items: flex-start; }
        .im .im-btn { width: 100%; }
    }
</style>
}

@await Html.PartialAsync("_Header")

<div class="im">
    <section class="im-hero">
        <div class="im-wrap">
            <div>
                <span class="im-badge">@Localizer["Badge"]</span>
                <h1>@Localizer["HeroTitle1"] <em>@Localizer["HeroTitleAccent"]</em> @Localizer["HeroTitle2"]</h1>
                <p class="im-lead">@Localizer["HeroLead"]</p>
                <div class="im-cta">
                    <a class="im-btn im-btn-main" href="@connectUrl">@Localizer["CtaConnect"]</a>
                    <a class="im-btn im-btn-ghost" href="#how">@Localizer["CtaHow"]</a>
                </div>
                <div class="im-facts">
                    <div><b>@Localizer["FactCode"]</b>@Localizer["FactCodeText"]</div>
                    <div><b>@Localizer["FactPrice"]</b>@Localizer["FactPriceText"]</div>
                    <div><b>@Localizer["FactLangs"]</b>@Localizer["FactLangsText"]</div>
                </div>
            </div>
            <div>
                <div class="im-phone"><iframe src="@exampleSrc" title="@Localizer["PhoneTitle"]" loading="lazy"></iframe></div>
                <p class="im-phone-note">@Localizer["PhoneNote"]</p>
            </div>
        </div>
    </section>

    <section class="im-section">
        <div class="im-wrap">
            <h2>@Localizer["BenefitsTitle"]</h2>
            <p class="im-sub">@Localizer["BenefitsSub"]</p>
            <div class="im-grid">
                @foreach (var b in benefits)
                {
                    <div class="im-card"><div class="im-ico">@b.Item1</div><h3>@Localizer[b.Item2 + "Title"]</h3><p>@Localizer[b.Item2 + "Text"]</p></div>
                }
                <div class="im-card im-wide"><div class="im-ico">📈</div><div><h3>@Localizer["B10Title"]</h3><p>@Localizer["B10Text"]</p></div></div>
            </div>
        </div>
    </section>

    <section class="im-section im-alt" id="how">
        <div class="im-wrap">
            <h2>@Localizer["HowTitle"]</h2>
            <p class="im-sub">@Localizer["HowSub"]</p>
            <div class="im-grid im-steps">
                @for (var i = 1; i <= 3; i++)
                {
                    <div class="im-card im-step"><h3>@Localizer["S" + i + "Title"]</h3><p>@Localizer["S" + i + "Text"]</p></div>
                }
            </div>
            <div class="im-code">
                <h3>@Localizer["CodeTitle"]</h3>
                <pre>@codeSample</pre>
                <p>@Localizer["CodeNote"]</p>
            </div>
        </div>
    </section>

    <section class="im-section">
        <div class="im-wrap">
            <h2>@Localizer["FeaturesTitle"]</h2>
            <ul class="im-features">
                @for (var i = 1; i <= 10; i++)
                {
                    <li>@Localizer["F" + i]</li>
                }
            </ul>
        </div>
    </section>

    <section class="im-section im-alt">
        <div class="im-wrap">
            <h2>@Localizer["FaqTitle"]</h2>
            <div class="im-faq">
                @foreach (var item in faq)
                {
                    <details><summary>@item.Q</summary><p>@item.A</p></details>
                }
            </div>
        </div>
    </section>

    <section class="im-final">
        <div class="im-wrap">
            <h2>@Localizer["FinalTitle"]</h2>
            <p>@Localizer["FinalText"]</p>
            <a class="im-btn im-btn-main" href="@connectUrl">@Localizer["CtaConnect"]</a>
        </div>
    </section>
</div>

@await Html.PartialAsync("_Footer")
