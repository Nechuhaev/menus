                </div>
                <a class="yellow-button joinus desktop" href="#bottom-form">@Localizer["Services"]</a>
                <a data-joinus="" class="yellow-button mobile" href="#">@Localizer["Services"]</a>
            </div>
        </div>

        <div id="bottom-form">
            <div class="site-content-align-small">
                <div class="form">
                    <h2>@Localizer["JoinTheService"] Tip<span>mymenu</span></h2>
                    <p>@Localizer["Call"] <a href="tel:+380505562653">+380505562653</a> @Localizer["LeaveYourContacts"]</p>
