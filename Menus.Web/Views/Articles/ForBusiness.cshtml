<div class="popUpBlock popUpBlockMain packs">
    <div class="popUpCloser"></div>
    <div class="popUpBlock_inner">
        <!-- PopUp base packet -->
        <div class="popUpWindow popUpBasePacket">
            <form>
                <input type="hidden" name="Package" value="@Localizer["Free"]" />
                <span class="popUp_close"></span>
                <h2>
                    @Localizer["Activate"]<br />
                    @Localizer["Free"] @Localizer["Package"]
                </h2>
                <p>
                    @Localizer["LeaveYourContacts2"]
                </p>
                <label>@Localizer["RestarauntName"]<span>*</span></label>
                <input required name="Restaurant" type="text" />
                <label>Email <span>*</span></label>
                <input required name="Email" type="email" />
                <label>@Localizer["Phone"]<span>*</span></label>
                <div class="phone">
                    <input type="text" readonly value="+380" />
                    <input required name="Phone" type="tel" />
                </div>
                <input type="submit" value="@Localizer["SendRequest2"]" />
            </form>
        </div>

        <!-- PopUp Premium packet -->
        <div class="popUpWindow popUpPremiumPacket">
            <form>
                <input type="hidden" name="Package" value="@Localizer["Premium"]" />
                <span class="popUp_close"></span>
                <h2>
                    @Localizer["Activate"]<br />
                    @Localizer["Premium"] @Localizer["Package"]
                </h2>
                <p>
                    @Localizer["LeaveYourContacts2"]
                </p>
                <label>@Localizer["RestarauntName"]<span>*</span></label>
                <input required name="Restaurant" type="text" />
                <label>Email <span>*</span></label>
                <input required name="Email" type="email" />
                <label>@Localizer["Phone"]<span>*</span></label>
                <div class="phone">
                    <input type="text" readonly value="+380" />
                    <input required required name="Phone" type="tel" />
                </div>
                <input type="submit" value="@Localizer["SendRequest2"]" />
            </form>
        </div>


        <!-- PopUp thank you -->
        <div class="popUpWindow popUpThanks popUpThanksPacket">
            <span class="popUp_close"></span>
            <h2>
                @Localizer["Thanks"]<br />
                @Localizer["WeWillContact"]<br />
                @Localizer["Soon"]
            </h2>
        </div>

        <div class="popUpWindow popUpImg popUpDesign">
            <span class="popUp_close"></span>
            <div class="box" id="box1"><img src="~/images/des1.png" alt="" /></div>
            <div class="box" id="box2"><img src="~/images/des2.png" alt="" /></div>
        </div>

        <div class="popUpWindow popUpImg popUpTop">
            <span class="popUp_close"></span>
            <img src="~/images/adv1.png" alt="" />
        </div>

        <div class="popUpWindow popUpImg popUpAdvertising">
            <span class="popUp_close"></span>
            <div class="box" id="box3"><img src="~/images/adv2.png" alt="" /></div>
            <div class="box" id="box4"><img src="~/images/des2.png" alt="" /></div>
        </div>

        <div class="popUpWindow popUpJoinUs">
            <form>
                <span class="popUp_close"></span>
                <h2>@Localizer["JoinTheService"] Tip<span>mymenu</span></h2>
                <p>@Localizer["Call"] <a href="tel:+380505562653">+380505562653</a> @Localizer["LeaveYourContacts"]</p>
                <label>@Localizer["RestarauntName"]<span>*</span></label>
                <input required name="Restaurant" type="text" />
                <label>Email <span>*</span></label>
                <input required name="Email" type="email" />
                <label>@Localizer["Phone"]<span>*</span></label>
                <div class="phone">
                    <input type="text" readonly value="+380" />
                    <input required name="Phone" type="tel" />
                </div>
                <label>@Localizer["Package"]</label>
                <select required name="Package">
                    <option value="">@Localizer["ChoosePackage"]</option>
                    <option>@Localizer["Free"]</option>
                    <option>@Localizer["Premium"]</option>
                </select>
                <input type="submit" value="@Localizer["SendRequest2"]" />
