        </div>

    </div>
</div>

@section Scripts
    {
    <!-- Initialize Swiper -->
    <script src="~/js/swiper.min.js"></script>
    <script src="~/js/typeahead-inner.js"></script>

    <script src="~/js/jquery.js"></script>
    <script type="text/javascript">

        jQuery(document).ready(function () {


            if ($(window).outerWidth() > 992) {
                var advantagesSwiper = new Swiper('.our-advantages-carousel .swiper-container', {
                    spaceBetween: 1,
                    navigation: {
                        nextEl: '.our-advantages-carousel .swiper-button-next',
                        prevEl: '.our-advantages-carousel .swiper-button-prev',
                    },
                    pagination: {
                        el: '.our-advantages-carousel .swiper-pagination',
                        clickable: true,
                    },
                });
            }



            $(document).on("submit", ".site-content.packs form, .popUpBlockMain form", function (e) {
                e.preventDefault();

                $.ajax({
                    url: "@Url.Action("SendFormdata", "Home")",
                    type: "POST",
                    data: $(this).serialize()
                });

                $('.popUpBlockMain').addClass('visible');
                $('.popUpWindow').hide();
                $('.popUpThanksPacket').show();
            });

            jQuery('[data-base-packet]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible');
                jQuery('.popUpBasePacket').fadeIn();
                return false;
            });

            jQuery('[data-premium-packet]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible');
                jQuery('.popUpPremiumPacket').fadeIn();
                return false;
            });

            jQuery('.popUpWindow .popUp_close').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').removeClass('visible');
                jQuery('.popUpBlockMain').removeClass('joinus');
                jQuery('.popUpWindow').fadeOut();
            });

            jQuery('[data-design]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible');
                jQuery('.popUpDesign').fadeIn();

                let currentIndex = 0;
                $(".popUpDesign .box").hide();
                $(".popUpDesign .box").eq(currentIndex).show();

                var totalDiv = $(".popUpDesign .box").length;

                setInterval(function () {
                    currentIndex = (currentIndex + 1) % totalDiv;

                    $(".popUpDesign .box").hide();
                    $(".popUpDesign .box").eq(currentIndex).show();

                }, 2000);

                return false;
            });

            jQuery('[data-top]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible');
                jQuery('.popUpTop').fadeIn();
                return false;
            });

            jQuery('[data-joinus]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible joinus');
                jQuery('.popUpJoinUs').fadeIn();
                return false;
            });


            jQuery('[data-advertising]').on('click', function (e) {
                e.preventDefault();
                jQuery('.popUpBlockMain').addClass('visible');
                jQuery('.popUpAdvertising').fadeIn();

                let currentIndex = 0;

                $(".popUpAdvertising .box").hide();
                $(".popUpAdvertising .box").eq(currentIndex).show();

                var totalDiv = $(".popUpAdvertising .box").length;

                setInterval(function () {
                    currentIndex = (currentIndex + 1) % totalDiv;

                    $(".popUpAdvertising .box").hide();
                    $(".popUpAdvertising .box").eq(currentIndex).show();

                }, 2000);
                return false;
            });


            $('a.joinus').click(function () {
                $('html, body').animate({
                    scrollTop: $($.attr(this, 'href')).offset().top
                }, 500);
                return false;
            });

            jQuery('a.spoiler').on('click', function (e) {
                e.preventDefault();
                $(this).prev('ul').addClass('show');
            });

            $("#more-services .col-3 > li")
                .mouseleave(function () {
                    $(this).children('ul').removeClass('show');
                })


            if (isMobile) {

                var swiper = new Swiper('.swiper-container', {
                    spaceBetween: 30,
                    pagination: {
                        el: '.swiper-pagination',
                        clickable: true,
                    },
                });


            }

            var $obj = $('#why');
            var $objs = $('#services');
            var top = $obj.offset().top - 250;
            var bottom = $objs.offset().top;

            $(window).scroll(function (event) {
                    // what the y position of the scroll is
                    var y = $(this).scrollTop();

                    // whether that's below the form
                    if (y >= top) {
                        // if so, ad the fixed class
                        $('#top-banner .reg-text a.mobile').addClass('fixed');
                    } else {
                        // otherwise remove it
                        $('#top-banner .reg-text a.mobile').removeClass('fixed');
                }

                if (y >= bottom) {
                    // if so, ad the fixed class
                    $('#top-banner .reg-text a.mobile').removeClass('fixed');
                }
            });


        });


    </script>
}


@await Html.PartialAsync("_Footer")

