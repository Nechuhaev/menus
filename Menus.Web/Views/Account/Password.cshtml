@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer;
@model Menus.Web.Controllers.ResetPasswordModel;
@inject Menus.Web.Services.UserService  UserService;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_ProfileHeader")

<div class="profile_content">
    <div class="wrapper">

        @if (!UserService.IsMobileUser(Context.Request))
        {
            <div class="sidebar-container">
                <div class="sidebar-container-header">@Localizer["MyProfile"]</div>
                <div class="sidebar-menu-container">
                    <div class="sidebar-menu-item" id="profile">
                        <a asp-action="Index" asp-controller="Account"><i class="fa fa-user"></i><span>@Localizer["MyProfile"]</span></a>
                    </div>
                    <div class="sidebar-menu-item" id="activity">
                        <a asp-action="Activity" asp-controller="Account"><i class="fa fa-star"></i><span>@Localizer["MyActivity"]</span></a>
                    </div>
                    <div class="sidebar-menu-item current" id="password">
                        <a asp-action="Password" asp-controller="Account"><i class="fa fa-unlock-alt"></i><span>@Localizer["Password"]</span></a>
                    </div>
                </div>
            </div>
        }

        <div class="password-change-container account-container">
            <h3>@Localizer["Password"]</h3>
            <div class="reset-password-container">
                <form method="post" asp-action="ResetPassword" asp-controller="Account">
                    <div class="form-group">
                        <label class="control-label">
                            <span>@Localizer["OldPassword"]</span>
                            @if (Model != null)
                            {
                                <small class="text-danger" id="incorrect-password" style="display: block;">@Localizer["WrongPassword"]</small>
                            }
                            <small class="text-danger" id="old-password-warning-length">@Localizer["PasswordLengthMinimum"]!</small>
                        </label>
                        <input asp-for="OldPassword" class="form-control" onchange="checkLengthOfNewPassword(true);" id="old-password" autocomplete="current-password" required type="password" minlength="6" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">
                            <span>@Localizer["NewPassword"]</span>
                            <small class="text-danger" id="password-warning-length">@Localizer["PasswordLengthMinimum"]!</small>
                        </label>
                        <input asp-for="NewPassword" class="form-control" onchange="checkLengthOfNewPassword();" id="new-password" autocomplete="new-password" minlength="6" required type="password" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">
                            <span>@Localizer["ConfirmNewPassword"]</span>
                            <small class="text-danger" id="password-warning-match">@Localizer["PasswordsDoesntMatch"]</small>
                        </label>
                        <input asp-for="RepeatNewPassword" onchange="checkIfPasswordsMatch();" class="form-control" id="repeat-new-password" autocomplete="new-password" minlength="6" required type="password" />
                    </div>
                    <div class="submit-box">
                        <button type="submit" class="classic-btn" id="">@Localizer["Confirm"]</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@await Html.PartialAsync("_Footer")

<script>
    var oldPasswordElement = document.getElementById("old-password");
    var newPasswordElement = document.getElementById("new-password");
    var repeatNewPasswordElement = document.getElementById("repeat-new-password");
    var passwordsDoesNotMatchElement = document.getElementById("password-warning-match");
    var passwordLengthWarningElement = document.getElementById("password-warning-length");
    var oldPasswordLengthWarningElement = document.getElementById("old-password-warning-length");
    var submitBtnElement = document.getElementById("password-submit-btn");
    var incorrectPassword = document.getElementById("incorrect-password");

    function checkIfPasswordsMatch() {
        checkIfBtnCanBePressed();
        if (newPasswordElement.value !== repeatNewPasswordElement.value) {
            passwordsDoesNotMatchElement.style.display = "block";
        } else {
            passwordsDoesNotMatchElement.style.display = "none";
            return true;
        }
    }

    function checkIfBtnCanBePressed() {
        if (incorrectPassword) incorrectPassword.style.display = "none";
        if (oldPasswordElement.value.length > 5 && newPasswordElement.value.length > 5 && newPasswordElement.value === repeatNewPasswordElement.value) {
            //submitBtnElement.disabled = false;
            oldPasswordLengthWarningElement.style.display = "none";
            passwordLengthWarningElement.style.display = "none";
            passwordsDoesNotMatchElement.style.display = "none";
            return true;

        } else {
            return false;
        }
    }

    function checkLengthOfNewPassword(checkOldElement) {
        checkIfBtnCanBePressed();
        var inputElement = checkOldElement ? oldPasswordElement : newPasswordElement;
        var warningElement = checkOldElement ? oldPasswordLengthWarningElement : passwordLengthWarningElement;
        if (inputElement && inputElement.value.length < 6) {
            warningElement.style.display = "block";
        } else {
            warningElement.style.display = "none";
            return true;
        }

    }

    $("#password-submit-btn").click(function (e) {
        if (!checkIfBtnCanBePressed()) e.preventDefault();
    });
</script>

<script>
        var cityId = "@ViewData["selectedCity"]";
</script>
<script src="~/js/typeahead-inner.js"></script>
