@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer;
@model Menus.Web.Models.ApplicationUser;
@inject Menus.Web.Services.UserService  UserService;
@inject Menus.Domain.Core Core
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = await UserService.GetUserById(User.Identity.Name);
    var userStats = await UserService.GetUserStats(User.Identity.Name);

    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture.TwoLetterISOLanguageName;
}

@await Html.PartialAsync("_ProfileHeader")

<div class="profile_content">
    <div class="wrapper">

        @if (!UserService.IsMobileUser(Context.Request))
        {
            <div class="sidebar-container">
                <div class="sidebar-container-header">@Localizer["MyProfile"]</div>
                <div class="sidebar-menu-container">
                    <div class="sidebar-menu-item current" id="profile">
                        <a asp-action="Index" asp-controller="Account"><i class="fa fa-user"></i><span>@Localizer["MyProfile"]</span></a>
                    </div>
                    <div class="sidebar-menu-item" id="activity">
                        <a asp-action="Activity" asp-controller="Account"><i class="fa fa-star"></i><span>@Localizer["MyActivity"]</span></a>
                    </div>
                    <div class="sidebar-menu-item" id="password">
                        <a asp-action="Password" asp-controller="Account"><i class="fa fa-unlock-alt"></i><span>@Localizer["Password"]</span></a>
                    </div>

                    @if (User.IsInRole("restaurant") || User.IsInRole("restaurant-manager"))
                    {
                        <div class="sidebar-menu-item" id="password">
                            <a asp-route-culture="@culture" asp-area="" asp-controller="Restaurants" asp-action="Manage">
                                <i class="fa fa-rocket"></i><span>@Localizer["MyRestaurants"]</span>
                            </a>
                        </div>
                    }

                </div>
            </div>
        }
        <div class="account-container profile-container">
            <h3>@Localizer["MyProfile"]</h3>
            <div class="user-info-box">
                <form method="post" asp-action="EditUserInfo">
                    <input type="hidden" asp-for="ImageUrl" id="image-url-input" />
                    <div class="form-group">
                        <input asp-for="FirstName" class="form-control" placeholder="@Localizer["Name"]" />
                    </div>
                    <div class="form-group">
                        <input asp-for="LastName" class="form-control" placeholder="@Localizer["LastName"]" />
                    </div>
                    <div class="form-group">
                        <input asp-for="Email" class="form-control" disabled placeholder="Email" />
                    </div>
                    <div class="form-group">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="@Localizer["Phone"]" />
                    </div>
                    <div class="submit-box">
                        <button type="submit" class="classic-btn">@Localizer["Save"]</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<div class="generic-modal-container modal-container modal-update-success hidden">
    <div class="modal-background"></div>
    <div class="modal email-pwd">
        <button type="button" class="close-modal">X</button>
        <div class="modal-tab">
            <figure>
                <img src="~/images/icon_success.png" alt="Alternate Text" />
            </figure>
            <p>@Localizer["SuccessMessage"]</p>
            <button type="submit" class="proceed-btn">@Localizer["Proceed"]</button>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Footer")

<script>
    var cityId = "@ViewData["selectedCity"]";
</script>
<script src="~/js/typeahead-inner.js"></script>

@section Scripts
    {
    <script>
        const updateSuccess = '@ViewData["updateSuccess"]' === 'True';
        const $modalBackDrop = $(".modal-update-success .modal-background");
        const $closeModalBtn = $(".modal-update-success .close-modal");
        const $proceedBtn = $(".modal-update-success .proceed-btn");
        const $genericModal = $(".generic-modal-container");

        $(document).ready(function () {
            if (updateSuccess) {
                $genericModal.toggleClass('hidden', false);
            }

            $proceedBtn.click(function (e) {
                closeEditAccountModal();
            });

            $modalBackDrop.click(function (e) {
                closeEditAccountModal();
            });

            $closeModalBtn.click(function (e) {
                closeEditAccountModal();
            });
        });

        function closeEditAccountModal() {
            $genericModal.toggleClass('hidden', true);
        }
    </script>
}