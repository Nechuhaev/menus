{
  "compilerOptions": {
    "module": "none",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "outDir": "wwwroot/js",
    "sourceMap": true,
    "target": "es5",
    "lib": [
      "es6",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "wwwroot/ts/**/*"
  ]
}