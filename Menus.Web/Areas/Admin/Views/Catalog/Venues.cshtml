@model List<Menus.Web.Services.CatalogVenue>
@using Menus.Web.Services
@{
    ViewData["Title"] = "Каталог: заклади";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var cityId = ViewData["cityId"] as string;
    var citySlug = ViewData["citySlug"] as string;
    var type = ViewData["type"] as string;
    var q = ViewData["q"] as string;
    var districts = ViewData["districts"] as List<CatalogVenue> ?? new List<CatalogVenue>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="site-content">
    <main>
        <div class="site-content-center">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li><a asp-action="Index" asp-route-cityId="@cityId">Каталог</a></li>
                    <li>@ViewData["cityName"]: @(string.IsNullOrEmpty(type) ? "усі заклади" : CatalogService.TypeName(type, "uk"))</li>
                </ul>
            </div>

            @if (TempData["message"] != null)
            {
                <p><strong>@TempData["message"]</strong></p>
            }

            <form method="get" style="display:flex;flex-wrap:wrap;gap:8px;margin:12px 0;">
                <input type="hidden" name="cityId" value="@cityId" />
                <select name="type" onchange="this.form.submit()">
                    <option value="">Усі типи</option>
                    @foreach (var t in CatalogService.Types)
                    {
                        <option value="@t.Key" selected="@(t.Key == type)">@t.Value.Uk</option>
                    }
                </select>
                <input type="text" name="q" value="@q" placeholder="Назва закладу" />
                <button type="submit">Знайти</button>
                <span style="color:#777;font-size:12px;align-self:center;">@Model.Count</span>
            </form>

            <div style="overflow-x:auto;">
                <table class="mainTable">
                    <thead><tr><th>Заклад</th><th>Страв</th><th>Тип і район</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>
                                    <a href="/uk/@citySlug/restaurant/@v.Slug" target="_blank" rel="noopener">@v.Name ↗</a><br />
                                    <a style="font-size:12px" asp-controller="Outreach" asp-action="Restaurant" asp-route-id="@v.Id">картка в «Розсилці»</a>
                                </td>
                                <td>@v.Dishes</td>
                                <td><partial name="_VenueForm" model="(v, districts, returnUrl)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
