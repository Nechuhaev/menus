@model List<Menus.Web.Services.CatalogVenue>
@using Menus.Abstract.Models
@using Menus.Web.Services
@{
    ViewData["Title"] = "Каталог";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var cities = ViewData["cities"] as List<ICity>;
    var cityId = ViewData["cityId"] as string;
    var citySlug = ViewData["citySlug"] as string;
    var cityCounts = ViewData["cityCounts"] as Dictionary<string, int> ?? new Dictionary<string, int>();
    var settings = ViewData["settings"] as List<CatalogPageSettings> ?? new List<CatalogPageSettings>();
    var period = ViewData["period"] as string ?? "28";
    var last = ViewData["last"] as DateTime?;
    var from = ViewData["from"] as DateTime?;
    var to = ViewData["to"] as DateTime?;
    var stats = ViewData["stats"] as Dictionary<string, SeoSlugStats> ?? new Dictionary<string, SeoSlugStats>();
    var hasGa = stats.Values.Any(x => x.Views > 0);
    var rows = new List<(string Type, int Venues)> { ("", Model.Count) };
    rows.AddRange(CatalogService.Types.Keys.Where(t => t != "restorany").Select(t => (t, Model.Count(v => v.Type == t))));
    var restorany = Model.Count(v => v.Type == "restorany");
    var noCuisine = Model.Count(v => !v.CuisineList.Any());
    var cuisineRows = CatalogService.Cuisines.Keys.Select(c => (Cuisine: c, Venues: Model.Count(v => v.CuisineList.Contains(c))))
        .OrderByDescending(x => x.Venues).ToList();
    var noDistrict = Model.Count(v => string.IsNullOrEmpty(v.DistrictSlug));
}

<style>
    .catalog-admin .table-wrap { overflow-x: auto; }
    .catalog-admin .muted { color: #777; font-size: 12px; }
    .catalog-admin .filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 12px 0; }
    .catalog-admin .on { color: #1a7f37; font-weight: 600; }
    .catalog-admin .off { color: #c62828; }
</style>

<div class="site-content">
    <main>
        <div class="site-content-center catalog-admin">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Каталог</li>
                </ul>
            </div>
            <h2>Каталог міста: ресторани, кафе, бари…</h2>
            <p class="muted">
                Сторінки /uk/@citySlug/restaurants і /uk/@citySlug/restaurants/{тип}. Сторінка є на сайті, якщо закладів ≥ @CatalogService.MinVenues і вона не вимкнена.
                Тип і район закладів визначає бот (content-bot/venue_types.py, щоночі); зміна тут - вручну, бот її не перезаписує.
                Закриті заклади (статус «Закрито» в «Ресторанах» чи «ЗАКРИТО» в «Розсилці») у каталог не потрапляють.
            </p>

            @if (TempData["message"] != null)
            {
                <p><strong>@TempData["message"]</strong></p>
            }

            <form method="get" class="filters">
                <select name="cityId" onchange="this.form.submit()">
                    @foreach (var c in cities)
                    {
                        <option value="@c.Id" selected="@(c.Id == cityId)">@c.Name.Get("uk") (@(cityCounts.TryGetValue(c.Id, out var n) ? n : 0))</option>
                    }
                </select>
                @if (last != null)
                {
                    <span>Переходи за:</span>
                    <select name="period" id="cat-period">
                        @foreach (var (key, title) in new[] { ("7", "7 днів"), ("28", "28 днів"), ("90", "90 днів"), ("custom", "свої дати") })
                        {
                            <option value="@key" selected="@(key == period)">@title</option>
                        }
                    </select>
                    <span id="cat-dates" style="display: @(period == "custom" ? "inline" : "none");">
                        <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" max="@last?.ToString("yyyy-MM-dd")" /> —
                        <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" max="@last?.ToString("yyyy-MM-dd")" />
                    </span>
                    <button type="submit">Показати</button>
                    <span class="muted">@from?.ToString("dd.MM.yyyy") – @to?.ToString("dd.MM.yyyy"), усі мови разом</span>
                }
            </form>

            <div class="table-wrap">
                <table class="mainTable">
                    <thead>
                        <tr>
                            <th>Сторінка</th><th>Закладів</th><th>На сайті</th><th>Кліки Google</th><th>Покази Google</th>
                            @if (hasGa) { <th>Перегляди / сеанси GA4</th> }
                            <th>Текст</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (type, venues) in rows)
                        {
                            var s = settings.FirstOrDefault(x => x.CityId == cityId && x.VenueType == type);
                            var published = CatalogService.IsPublished(type == "" ? null : type, venues, s);
                            var st = stats.TryGetValue(type, out var x2) ? x2 : new SeoSlugStats();
                            var path = $"/uk/{citySlug}/restaurants" + (type == "" ? "" : "/" + type);
                            <tr>
                                <td>
                                    <strong>@(type == "" ? "Усі заклади" : CatalogService.TypeName(type, "uk"))</strong><br />
                                    @if (published)
                                    {
                                        <a class="muted" href="@path" target="_blank" rel="noopener">@path ↗</a>
                                    }
                                    else
                                    {
                                        <span class="muted">@path</span>
                                    }
                                </td>
                                <td><a asp-action="Venues" asp-route-cityId="@cityId" asp-route-type="@type">@venues</a></td>
                                <td>
                                    @if (published)
                                    {
                                        <span class="on">так</span>
                                    }
                                    else if (s != null && !s.Enabled)
                                    {
                                        <span class="off">вимкнено</span>
                                    }
                                    else
                                    {
                                        <span class="muted">ні (менше @CatalogService.MinVenues)</span>
                                    }
                                </td>
                                <td>@(st.Clicks > 0 ? st.Clicks.ToString("N0") : "–")</td>
                                <td>@(st.Impressions > 0 ? st.Impressions.ToString("N0") : "–")</td>
                                @if (hasGa) { <td>@(st.Views > 0 ? $"{st.Views:N0} / {st.Sessions:N0}" : "–")</td> }
                                <td>@(string.IsNullOrWhiteSpace(s?.CustomText) ? "авто" : "власний")</td>
                                <td><a asp-action="Page" asp-route-cityId="@cityId" asp-route-type="@type">Налаштувати</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <h3 style="margin-top:24px;">Кухні</h3>
            <div class="table-wrap">
                <table class="mainTable">
                    <thead>
                        <tr>
                            <th>Сторінка</th><th>Закладів</th><th>На сайті</th><th>Кліки Google</th><th>Покази Google</th>
                            @if (hasGa) { <th>Перегляди / сеанси GA4</th> }
                            <th>Текст</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (cuisine, venues) in cuisineRows)
                        {
                            var key = CatalogService.CuisineKey(cuisine);
                            var s = settings.FirstOrDefault(x => x.CityId == cityId && x.VenueType == key);
                            var published = CatalogService.IsCuisinePublished(cuisine, venues, s);
                            var st = stats.TryGetValue(key, out var x3) ? x3 : new SeoSlugStats();
                            var path = $"/uk/{citySlug}/restaurants/kukhnia/{cuisine}";
                            <tr>
                                <td>
                                    <strong>@CatalogService.CuisineName(cuisine, "uk")</strong><br />
                                    @if (published)
                                    {
                                        <a class="muted" href="@path" target="_blank" rel="noopener">@path ↗</a>
                                    }
                                    else
                                    {
                                        <span class="muted">@path</span>
                                    }
                                </td>
                                <td><a asp-action="Venues" asp-route-cityId="@cityId" asp-route-cuisine="@cuisine">@venues</a></td>
                                <td>
                                    @if (published)
                                    {
                                        <span class="on">так</span>
                                    }
                                    else if (s != null && !s.Enabled)
                                    {
                                        <span class="off">вимкнено</span>
                                    }
                                    else
                                    {
                                        <span class="muted">ні (менше @CatalogService.MinVenues)</span>
                                    }
                                </td>
                                <td>@(st.Clicks > 0 ? st.Clicks.ToString("N0") : "–")</td>
                                <td>@(st.Impressions > 0 ? st.Impressions.ToString("N0") : "–")</td>
                                @if (hasGa) { <td>@(st.Views > 0 ? $"{st.Views:N0} / {st.Sessions:N0}" : "–")</td> }
                                <td>@(string.IsNullOrWhiteSpace(s?.CustomText) ? "авто" : "власний")</td>
                                <td><a asp-action="Page" asp-route-cityId="@cityId" asp-route-type="@key">Налаштувати</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="muted">
                Без кухні: @noCuisine <a asp-action="Venues" asp-route-cityId="@cityId" asp-route-cuisine="-">показати →</a>.
                «Ресторани» (тип за замовчуванням): @restorany - окремої сторінки немає, вони на сторінці всіх закладів.
                Без району: @noDistrict <a asp-action="Venues" asp-route-cityId="@cityId">усі заклади міста →</a>.
                Графік по днях - <a asp-controller="Seo" asp-action="Index" asp-route-kind="catalog">SEO, вид «Каталог міста»</a>.
            </p>
        </div>
    </main>
</div>

<script>
    (function () {
        var p = document.getElementById('cat-period'), d = document.getElementById('cat-dates');
        if (p && d) p.addEventListener('change', function () { d.style.display = p.value === 'custom' ? 'inline' : 'none'; });
    })();
</script>
