@model List<Menus.Web.Services.CustomerRequestRow>

@{
    ViewData["Title"] = "Запити";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var currentPage = (int)ViewData["page"];
    var total = (int)ViewData["total"];
    var f = ViewData["filter"] as Menus.Web.Services.CustomerRequestFilter ?? new Menus.Web.Services.CustomerRequestFilter();
    var pageSize = Menus.Web.Services.CustomerRequestService.PageSize;
    var pages = (total + pageSize - 1) / pageSize;
    var statuses = new[] { (0, "Новий"), (1, "Оброблено"), (2, "Новий запит доступу") };
    string Route(int p) => Url.Action("Index", new
    {
        f.Restaurant, f.Package, f.Email, f.Phone, f.Ip, f.Status,
        From = f.From?.ToString("yyyy-MM-dd"), To = f.To?.ToString("yyyy-MM-dd"), page = p
    });
}

<style>
    /* таблиця вміщається в екран: фіксовані ширини колонок, довгий текст переноситься */
    .requests .table-wrap { overflow-x: visible; max-width: 100%; }
    .requests table.mainTable { table-layout: fixed; width: 100%; }
    .requests table th, .requests table td { overflow-wrap: anywhere; word-break: break-word; padding-left: 6px !important; padding-right: 6px !important; }
    .requests td small { display: block; color: #8a9099; font-size: 11px; }
    .requests .status-select { width: 100%; min-width: 0; height: auto; min-height: 32px; line-height: normal; padding: 4px; font-size: 13px; }
    .requests table td { vertical-align: top; overflow-wrap: anywhere; }
    .requests .filter-row input, .requests .filter-row select { width: 100%; min-width: 0; box-sizing: border-box; font-size: 13px; }
    .requests .filter-row .dates input { display: block; min-width: 0; margin-bottom: 2px; }
    .requests .muted { color: #777; font-size: 12px; }
    .requests .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 10px 0; }
    .requests .pager a, .requests .pager span { margin: 0 4px; }
    .requests .tg-badge { display: inline-block; padding: 0 6px; border-radius: 8px; background: #e7f3fd; color: #1d6fb8; font-size: 12px; }
    /* телефон: таблиця - картками, без бокової прокрутки; фільтри - стовпчиком */
    @@media (max-width: 760px) {
        .requests .table-wrap { overflow-x: visible; }
        .requests table, .requests thead, .requests tbody, .requests tr, .requests th, .requests td { display: block; width: 100%; box-sizing: border-box; }
        .requests thead tr:first-child { display: none; }
        .requests colgroup { display: none; }
        .requests tr.filter-row th { padding: 2px 0; }
        .requests tr.filter-row th:empty { display: none; }
        .requests tbody tr { border: 1px solid #e5e5e5; border-radius: 10px; margin: 0 0 10px; padding: 8px 10px; background: #fff; }
        .requests tbody td { border: 0; padding: 3px 0; }
        .requests tbody td[data-label]::before { content: attr(data-label) ": "; color: #777; font-size: 12px; }
    }
</style>

<div class="site-content">
    <main>
        <div class="site-content-center requests">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Запити</li>
                </ul>
            </div>

            <div class="title-section">
                <div class="title-section--left">
                    <h2>Запити на зв'язок (@total)</h2>
                </div>
            </div>

            @if (TempData["message"] != null)
            {
                <p><strong>@TempData["message"]</strong></p>
            }

            <form method="get" id="filter-form"></form>
            <form method="post" asp-action="Delete" id="delete-form" onsubmit="return confirm('Видалити вибрані запити?');">
                <input type="hidden" name="returnUrl" value="@Route(currentPage)" />
            </form>

            <div class="actions">
                <button type="submit" form="filter-form">Фільтрувати</button>
                <a href="@Url.Action("Index")">Скинути фільтри</a>
                <button type="submit" form="delete-form" id="delete-btn" disabled>Видалити вибрані</button>
                <span class="muted">IP записується для нових запитів (раніше не зберігався)</span>
            </div>

            <div class="table-wrap">
                <table class="mainTable">
                    <colgroup>
                        <col style="width:4%" /><col style="width:20%" /><col style="width:9%" /><col style="width:15%" />
                        <col style="width:14%" /><col style="width:9%" /><col style="width:11%" /><col style="width:12%" /><col style="width:6%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="check-all" title="Вибрати всі" /></th>
                            <th>Ресторан</th>
                            <th>Пакет</th>
                            <th>Email</th>
                            <th>Телефон</th>
                            <th>IP</th>
                            <th>Створено</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                        <tr class="filter-row">
                            <th></th>
                            <th><input form="filter-form" name="Restaurant" value="@f.Restaurant" placeholder="назва" /></th>
                            <th><input form="filter-form" name="Package" value="@f.Package" placeholder="пакет" /></th>
                            <th><input form="filter-form" name="Email" value="@f.Email" placeholder="email" /></th>
                            <th><input form="filter-form" name="Phone" value="@f.Phone" placeholder="телефон" /></th>
                            <th><input form="filter-form" name="Ip" value="@f.Ip" placeholder="IP" /></th>
                            <th class="dates">
                                <input form="filter-form" type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" title="Створено від" />
                                <input form="filter-form" type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")" title="Створено до" />
                            </th>
                            <th>
                                <select form="filter-form" name="Status">
                                    <option value="">усі</option>
                                    @foreach (var (value, title) in statuses)
                                    {
                                        <option value="@value" selected="@(f.Status == value)">@title</option>
                                    }
                                </select>
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-id="@item.Id">
                                <td><input type="checkbox" form="delete-form" name="ids" value="@item.Id" class="row-check" /></td>
                                <td data-label="Ресторан / повідомлення">
                                    @if (item.IsAccessRequest)
                                    {
                                        <a target="_blank" href="@Url.Action("Edit", "Restaurants", new { id = item.RestaurantName })">@(item.RestaurantTitle ?? "Перейти в ресторан")</a>
                                    }
                                    else
                                    {
                                        @item.RestaurantName
                                    }
                                </td>
                                <td data-label="Пакет">@if (item.Package == "Telegram-бот")
                                    {
                                        <span class="tg-badge">Telegram-бот</span>
                                    }
                                    else
                                    {
                                        @item.Package
                                    }</td>
                                <td data-label="Email">@if (!string.IsNullOrWhiteSpace(item.Email) && item.Email.Contains("@"))
                                    {
                                        <a href="mailto:@item.Email">@item.Email</a>
                                    }
                                    else
                                    {
                                        @item.Email
                                    }</td>
                                <td data-label="Контакт">@{
                                        var tgUser = System.Text.RegularExpressions.Regex.Match(item.Phone ?? "", @"t\.me/([A-Za-z0-9_]{3,})").Groups[1].Value;
                                        var phoneDigits = System.Text.RegularExpressions.Regex.Replace(item.Phone ?? "", @"[^\d+]", "");
                                    }
                                    @if (tgUser != "")
                                    {
                                        <a href="https://t.me/@tgUser" target="_blank" rel="noopener">@@@tgUser</a>
                                    }
                                    else if (phoneDigits.Length >= 9)
                                    {
                                        <a href="tel:@phoneDigits">@item.Phone</a>
                                    }
                                    else
                                    {
                                        @item.Phone
                                    }</td>
                                <td data-label="IP">@(item.Ip ?? "–")</td>
                                <td data-label="Створено">@item.CreateDate.ToString("dd.MM.yyyy HH:mm")@if (item.UpdateDate > item.CreateDate.AddMinutes(1))
                                    {
                                        <small>змінено @item.UpdateDate.ToString("dd.MM.yyyy HH:mm")</small>
                                    }</td>
                                <td data-label="Статус">
                                    <select class="status-select">
                                        @foreach (var (value, title) in statuses)
                                        {
                                            <option value="@value" selected="@(item.Status == value)">@title</option>
                                        }
                                    </select>
                                </td>
                                <td><a asp-action="Edit" asp-route-id="@item.Id">Змінити</a></td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="9">Запитів не знайдено</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pages > 1)
            {
                <div class="pager" style="text-align:center; margin-top: 20px;">
                    @for (var i = 0; i < pages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span><strong>@(i + 1)</strong></span>
                        }
                        else if (i == 0 || i == pages - 1 || Math.Abs(i - currentPage) <= 3)
                        {
                            <a href="@Route(i)">@(i + 1)</a>
                        }
                        else if (Math.Abs(i - currentPage) == 4)
                        {
                            <span>…</span>
                        }
                    }
                </div>
            }
        </div>
    </main>
</div>

<script>
    (function () {
        var token = document.querySelector('#delete-form input[name="__RequestVerificationToken"]').value;
        var checks = document.querySelectorAll('.row-check'), btn = document.getElementById('delete-btn');
        var update = function () {
            var n = Array.prototype.filter.call(checks, function (c) { return c.checked; }).length;
            btn.disabled = n === 0;
            btn.textContent = n ? 'Видалити вибрані (' + n + ')' : 'Видалити вибрані';
        };
        Array.prototype.forEach.call(checks, function (c) { c.addEventListener('change', update); });
        document.getElementById('check-all').addEventListener('change', function () {
            var on = this.checked;
            Array.prototype.forEach.call(checks, function (c) { c.checked = on; });
            update();
        });
        Array.prototype.forEach.call(document.querySelectorAll('.status-select'), function (sel) {
            sel.addEventListener('change', function () {
                var body = new URLSearchParams();
                body.append('__RequestVerificationToken', token);
                body.append('id', sel.closest('tr').getAttribute('data-id'));
                body.append('status', sel.value);
                fetch('@Url.Action("ChangeStatus")', { method: 'POST', body: body, credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) alert('Не вдалося змінити статус'); })
                    .catch(function () { alert('Не вдалося змінити статус'); });
            });
        });
    })();
</script>
