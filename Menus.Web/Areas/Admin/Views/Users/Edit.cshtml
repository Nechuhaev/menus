@model Menus.Abstract.Models.IUser

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@inject Menus.Web.Services.UserService UserService
@{
    var CurrentUser = await UserService.GetUserById(User.Identity.Name);
}

<div class="site-content">
    <main>

        <div class="breadcrumbs">
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                <li><a asp-area="Admin" asp-controller="Users" asp-action="Index">Пользователи</a></li>
                <li>Редактировать данные</li>
            </ul>
        </div>



        <div class="site-content-wrapper site-content-wrapper--indent">

            <div class="top_title">
                <div class="top_title_left">
                    <h2>редактировать данные</h2>
                </div>
                <div class="top_title_right">
                    <form class="form_choose">
                        <select class="form-control" asp-for="Status"
                                asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.UserStatus>()"></select>
                    </form>
                </div>
            </div>



            <form method="post" asp-action="Edit" class="editUser">
                <input type="hidden" asp-for="Id" />

                <div class="editUser--left">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label class="control-label">Имя</label>
                        <input asp-for="FirstName" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Фамилия</label>
                        <input asp-for="LastName" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Телефон</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    @if (CurrentUser.Role == Menus.Abstract.Models.UserRole.Admin)
                    {
                        <div class="form-group">
                            <label class="control-label">Роль</label>
                            <select class="form-control" asp-for="Role"
                                    asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.UserRole>()"></select>
                        </div>
                    }
                    @*<div class="form-group hiddenArea">
            <div class="checkbox">
                <label>
                    <input asp-for="Blocked" /> @Html.DisplayNameFor(model => model.Blocked)
                </label>
            </div>
        </div>*@
                    @{ 
                        var restaurants = ViewData["restaurants"] as IEnumerable<Menus.Abstract.Models.IRestaurant>;
                    }
                    @if (restaurants.Any())
                    {
                        <div class="form-group">
                            <label>Рестораны:</label>
                            <ul>
                                @foreach (var restaurant in restaurants)
                                {
                                    <li><a href="#">@restaurant.Name</a></li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="form-group form-group--submit">
                        <input type="submit" value="изменить" class="btn btn-default" />
                    </div>

                </div>

                @*<div class="editUser--right">
                        <div class="form-group">
                            <label>Старый пароль</label>
                            <input type="password" placeholder="" />
                        </div>
                        <div class="form-group">
                            <label>Новый пароль</label>
                            <input type="password" placeholder="" />
                        </div>
                        <div class="form-group">
                            <label>Подтвердить новый пароль</label>
                            <input type="password" placeholder="" />
                        </div>
                        <a href="#">Сгенерировать пароль</a>
                    </div>*@

            </form>



        </div>



    </main>
</div>

@section Scripts {
    <script src="~/js/jquery.js"></script>
    <script>
        function getToken() {
            var token = '@Html.AntiForgeryToken()';
            token = $(token).val();
            return token;
        }

        $(document).on("change", '[name="Status"]', function () {
            var id = "@Model.Id";
            var status = $(this).val();

            $.ajax({
                url: "@Url.Action("ChangeStatus")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id,
                    status: status
                }
            })
                .done(function () {

                 })
                .fail(function (data) {
                    window.Logger.logTextError("STATUS CHANGE User action failed, id = " + id);
                 });
        });
    </script>
}
