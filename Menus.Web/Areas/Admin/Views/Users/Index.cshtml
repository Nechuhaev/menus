@section Scripts {
    <script src="~/js/jquery.js"></script>
    <script>
        function getToken() {
            var token = '@Html.AntiForgeryToken()';
            token = $(token).val();
            return token;
        }

        $(document).on("change", '[name="ViewData[status]"]', function () {
            $("[name=status]").val($(this).val());
            $(".search-bar").submit();
        });


        $(document).on("change", '[name="ViewData[role]"]', function () {
            $("[name=role]").val($(this).val());
            $(".search-bar").submit();
        });

        $(document).on("change", "#checkAll", function () {
            $("tbody .tableCheckbox input[type=checkbox]").prop('checked', $(this).is(":checked"));
        });

        $(".filter-form").submit(function (e) {
            e.preventDefault();

            if ($("[name=multiaction]").val() !== "delete") return;
            if (!confirm("Are you sure?")) return;

            var ids = [];
            $("tbody .tableCheckbox input[type=checkbox]").each(function () {
                if ($(this).is(":checked")) {
                    ids.push($(this).closest("tr[data-id]").attr("data-id"));
                }
            });


            $.ajax({
                url: "@Url.Action("DeleteSeveral")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    ids: ids
                }
            })
                .done(function () {
                    $("tbody .tableCheckbox input[type=checkbox]").each(function () {
                        if ($(this).is(":checked")) {
                            $(this).closest("tr[data-id]").remove();
                        }
                    });
                 })
                .fail(function (data) {
                    window.Logger.logTextError("MULTI DELETE User action failed");
                 });
        });

        $(document).on("change", '[name="item.Status"]', function () {
            var id = $(this).closest("tr[data-id]").attr("data-id");
            var status = $(this).val();

            $.ajax({
                url: "@Url.Action("ChangeStatus")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id,
                    status: status
                }
            })
                .done(function () {
                    var tr = $("tr[data-id=" + id + "]");
                    var icon = tr.find(".tableStatusIcon");

                    icon.removeClass("StatusIconBlock").removeClass("StatusIconOnApproval");

                    if (status === 1) icon.addClass("StatusIconOnApproval");
                    if (status === 2) icon.addClass("StatusIconBlock");
                 })
                .fail(function (data) {
                    window.Logger.logTextError("STATUS CHANGE User action failed, id = " + id);
                 });
        });

        $(document).on("change", '[name="item.EmailConfirmed"]', function () {
            var id = $(this).closest("tr[data-id]").attr("data-id");

            $.ajax({
                    url: "@Url.Action("ChangeEmailStatus")",
                    method: "POST",
                    data: {
                        "__RequestVerificationToken": getToken(),
                        id: id
                    }
                })
                .done(function () {
                    
                })
                .fail(function (data) {
                    window.Logger.logTextError("EMAIL STATUS CHANGE User action failed, id = " + id);
                });
        });

        $(document).on("change", '[name="item.Role"]', function () {
            var id = $(this).closest("tr[data-id]").attr("data-id");
            var role = $(this).val();

            $.ajax({
                url: "@Url.Action("ChangeRole")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id,
                    role: role
                }
            })
                .done(function () {

                 })
                .fail(function (data) {
                    window.Logger.logTextError("ROLE CHANGE User action failed, id = " + id);
                 });
        });

        $(document).on("click", "[data-delete]", function () {
            var id = $(this).attr("data-id");

            if (!confirm("Are you sure?")) return;

            $.ajax({
                url: "@Url.Action("Delete")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id
                }
            })
                .done(function () {
                    $("tr[data-id=" + id + "]").remove();
                 })
                .fail(function (data) {
                    window.Logger.logTextError("DELETE User action failed, id = " + id);
                 });
        });
    </script>
}
