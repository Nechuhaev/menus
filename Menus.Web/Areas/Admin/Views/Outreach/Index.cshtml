@model List<Menus.Web.Services.OutreachRecipient>

@{
    ViewData["Title"] = "Розсилка";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var cities = ViewData["cities"] as List<Menus.Abstract.Models.ICity>;
    var templates = ViewData["templates"] as List<OutreachTemplate>;
    var optOuts = ViewData["optOuts"] as HashSet<string>;
    var q = ViewData["q"] as string;
    var cityId = ViewData["cityId"] as string;
    var filter = ViewData["filter"] as string;
    var currentPage = (int)ViewData["page"];
    var pages = (int)ViewData["pages"];
    var cityNames = cities.ToDictionary(x => x.Id, x => x.Name.Get("uk"));
    var filters = new[] { ("contacts", "З контактами"), ("new", "Ще не писали"), ("sent", "Уже писали"),
                          ("qr", "Меню оновлено з ChoiceQR/Expirenza"), ("noqr", "З контактами, меню не з QR"),
                          ("doubt", "Перевірка: сумнівні"), ("closed", "ЗАКРИТО"), ("qrsuspended", "QR-меню призупинено"), ("all", "Усі ресторани") };
}

<style>
    .outreach .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
    .outreach table td { vertical-align: top; overflow-wrap: anywhere; }
    .outreach .muted { color: #777; font-size: 12px; }
    .outreach .pager { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }
    .ok-text { color: #1b7f3b; }
</style>

<div class="site-content">
    <main>
        <div class="site-content-center outreach admin-ux">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Розсилка</li>
                </ul>
            </div>

            @if (TempData["message"] != null)
            {
                <p><strong>@TempData["message"]</strong></p>
            }

            <p>
                <a asp-action="Templates">Шаблони листів (@templates.Count)</a> ·
                контакти збирає <code>content-bot/collect_contacts.py</code> (сайти й QR-меню), їх можна змінювати в картці ресторану.
            </p>

            <form method="get" class="filters">
                <input type="text" name="q" value="@q" placeholder="Пошук за назвою" />
                <select name="cityId">
                    <option value="">Усі міста</option>
                    @foreach (var c in cities)
                    {
                        <option value="@c.Id" selected="@(c.Id == cityId)">@c.Name.Get("uk")</option>
                    }
                </select>
                <select name="filter">
                    @foreach (var (key, title) in filters)
                    {
                        <option value="@key" selected="@(key == filter)">@title</option>
                    }
                </select>
                <button type="submit">Показати</button>
                <span class="muted">знайдено: @ViewData["total"]</span>
            </form>

            <form asp-action="Send" method="post">
                <input type="hidden" name="q" value="@q" />
                <input type="hidden" name="cityId" value="@cityId" />
                <input type="hidden" name="filter" value="@filter" />
                <input type="hidden" name="page" value="@currentPage" />
                <p>
                    <label><input type="checkbox" id="toggleAll" /> вибрати ще не надіслані email на сторінці</label>
                    <span id="emailCount"></span>
                    <select name="templateId">
                        @foreach (var t in templates)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <button type="submit" onclick="return confirm('Надіслати лист на вибрані адреси?')">Надіслати email вибраним</button>
                </p>

                <div class="table-wrap">
                <table class="mainTable">
                    <thead>
                        <tr><th>Ресторан</th><th title="Чи заклад працює: content-bot/check_alive.py (сайт і QR-меню) або позначка адміна">Перевірка</th><th>Місто</th><th>Страв</th><th title="Звідки бот бере меню (QR-сервіс чи сайт закладу, кодом чи AI), підсумок останньої перевірки й дата застосування пропозицій у «Звітах». Наведіть на підсумок - повний запис журналу">Меню</th><th>Email</th><th>Telegram / Instagram</th><th title="Останній вхід на сайт користувача-власника сторінки (час - Київ)">Вхід власника</th><th>Остання відправка</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="@(r.Closed ? "row-closed" : "")">
                                <td><a asp-action="Restaurant" asp-route-id="@r.Id">@r.Name</a></td>
                                <td>
                                    @if (r.Closed)
                                    {
                                        <span class="closed-badge">ЗАКРИТО</span>
                                    }
                                    else if (r.QrSuspended)
                                    {
                                        <span class="doubt-badge">QR-меню призупинено</span>
                                    }
                                    else if (r.AliveStatus == "doubt")
                                    {
                                        <span class="doubt-badge" title="@r.AliveReason">⚠ сумнівно</span>
                                        <div class="muted">@r.AliveReason</div>
                                    }
                                    else if (r.AliveStatus == "ok")
                                    {
                                        <span class="ok-badge">✓</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>@(cityNames.TryGetValue(r.City ?? "", out var cityName) ? cityName : "")</td>
                                <td>@r.Dishes</td>
                                <td>
                                    @* звідки бот бере меню (QR-сервіс / сайт кодом / сайт AI), підсумок останньої перевірки і застосування *@
                                    @if (r.MenuSourceName != null && (r.MenuReadBy != null || r.MenuPlatform != null))
                                    {
                                        <div><strong>@(r.MenuPlatform ?? r.MenuSourceName)</strong> <span class="muted">@(r.MenuReadBy ?? (r.MenuPlatform != null ? "QR-меню" : ""))</span></div>
                                    }
                                    else if (r.MenuSourceName != null)
                                    {
                                        <div>@r.MenuSourceName <span class="muted">сайт</span></div>
                                    }
                                    @if (r.MenuSyncStatus != null)
                                    {
                                        <div class="@(r.MenuSyncOk ? "ok-text" : "muted")" title="@r.SyncNotes">@(r.MenuSyncOk ? "✓ " : "")@r.MenuSyncStatus@(r.SyncCheckedAt != null ? " · " + r.SyncCheckedAt.Value.ToString("dd.MM") : "")</div>
                                    }
                                    else if (r.SyncCheckedAt == null)
                                    {
                                        <div class="muted">бот ще не перевіряв</div>
                                    }
                                    @if (r.MenuAppliedAt != null)
                                    {
                                        <div class="muted">застосовано @r.MenuAppliedAt.Value.ToString("dd.MM.yyyy")</div>
                                    }
                                </td>
                                <td>
                                    @foreach (var email in r.Emails)
                                    {
                                        var sent = r.Log.Any(x => x.Channel == "email" && x.Recipient == email && (x.Status == "sent" || x.Status == "queued"));
                                        var optedOut = optOuts.Contains(email);
                                        <div>
                                            <label>
                                                <input type="checkbox" class="emailBox" name="emails" value="@r.Id|@email"
                                                       data-fresh="@(sent ? "0" : "1")" disabled="@(optedOut || r.Closed)" />
                                                @email
                                            </label>
                                            @if (optedOut) { <span class="muted">відписався</span> }
                                            else if (sent) { <span class="muted">надіслано</span> }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @foreach (var value in r.Values("telegram").Concat(r.Values("instagram")))
                                    {
                                        <div><a href="https://@value" target="_blank" rel="noopener">@value</a></div>
                                    }
                                </td>
                                <td class="muted">@r.OwnerLastSeenText</td>
                                <td class="muted">@(r.LastSent?.ToString("dd.MM.yyyy HH:mm"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </form>

            @if (pages > 1)
            {
                <div class="pager">
                    @for (var i = 1; i <= pages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="current">@i</span>
                        }
                        else if (i == 1 || i == pages || Math.Abs(i - currentPage) <= 3)
                        {
                            <a asp-action="Index" asp-route-q="@q" asp-route-cityId="@cityId" asp-route-filter="@filter" asp-route-page="@i">@i</a>
                        }
                        else if (Math.Abs(i - currentPage) == 4)
                        {
                            <span>…</span>
                        }
                    }
                </div>
            }
        </div>
    </main>
</div>

<script>
    (function () {
        var boxes = document.querySelectorAll('.emailBox');
        var count = function () {
            var n = Array.prototype.filter.call(boxes, function (b) { return b.checked; }).length;
            document.getElementById('emailCount').textContent = 'Вибрано: ' + n;
        };
        document.getElementById('toggleAll').addEventListener('change', function () {
            var on = this.checked;
            boxes.forEach(function (b) { if (!b.disabled && b.dataset.fresh === '1') { b.checked = on; } });
            count();
        });
        boxes.forEach(function (b) { b.addEventListener('change', count); });
        count();
    })();
</script>
