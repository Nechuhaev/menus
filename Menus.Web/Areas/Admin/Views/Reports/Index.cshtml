@model List<Menus.Web.Services.MenuSyncRestaurantSummary>

@{
    ViewData["Title"] = "Звіти";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var aiCost = ViewData["aiCost"] as Menus.Web.Services.AiCostTotals;
    var menuLinkRestaurants = ViewData["menuLinkRestaurants"] as int? ?? 0;
}

<div class="site-content">
    <main>
        <div class="site-content-center">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Звіти</li>
                </ul>
            </div>

            <div class="title-section">
                <div class="title-section--left">
                    <h2>Зміни меню з сайтів ресторанів</h2>
                </div>
            </div>

            @if (menuLinkRestaurants > 0)
            {
                <p>
                    <a asp-action="MenuLinks"><strong>Посилання на меню (Expirenza, ChoiceQR): @menuLinkRestaurants</strong></a>
                    - ресторани, для яких знайдено меню в QR-сервісах; підтвердіть або відхиліть посилання.
                </p>
            }

            @if (aiCost != null)
            {
                <p>
                    Витрати AI бота: сьогодні <strong>$@aiCost.Today.ToString("0.00")</strong>,
                    за 30 днів <strong>$@aiCost.Last30Days.ToString("0.00")</strong>
                    (@aiCost.TokensLast30Days.ToString("N0") токенів).
                </p>
            }

            @if (!Model.Any())
            {
                <p>Нових пропозицій немає. Бот додає їх, коли меню на сайті ресторану розпізнане впевнено.</p>
            }
            else
            {
                <table class="mainTable">
                    <thead>
                        <tr>
                            <th>Ресторан</th>
                            <th>Додати страв</th>
                            <th>Прибрати страв</th>
                            <th>Змінити ціну</th>
                            <th>Звіт від</th>
                            <th>Токени (вхід / вихід)</th>
                            <th>Ціна, $</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td><a asp-action="Restaurant" asp-route-id="@item.RestaurantId" asp-route-kind="add">@item.ToAdd</a></td>
                                <td><a asp-action="Restaurant" asp-route-id="@item.RestaurantId" asp-route-kind="remove">@item.ToRemove</a></td>
                                <td><a asp-action="Restaurant" asp-route-id="@item.RestaurantId" asp-route-kind="price">@item.ToChangePrice</a></td>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.InputTokens.ToString("N0") / @item.OutputTokens.ToString("N0")</td>
                                <td>@item.CostUsd.ToString("0.0000")</td>
                                <td><a asp-action="Restaurant" asp-route-id="@item.RestaurantId">Переглянути</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </main>
</div>
