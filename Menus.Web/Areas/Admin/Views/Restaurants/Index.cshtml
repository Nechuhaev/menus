@model IEnumerable<Menus.Abstract.Models.IRestaurant>

@inject Menus.Web.Services.UserService UserService
@{
    var CurrentUser = await UserService.GetUserById(User.Identity.Name);
    var page = (int)ViewData["page"];
}

<div class="site-content">
    <main>

        <div class="site-content-center">

            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Рестораны</li>
                </ul>
            </div>

            <form class="search-bar">
                <input type="text" name="q" value="@ViewData["q"]" />
                <input type="hidden" name="status" value="@ViewData["status"]" />
                <input type="hidden" name="createdBy" value="@ViewData["createdBy"]" />
                <button type="submit">Поиск</button>
            </form>

            <div class="title-section">
                <div class="title-section--left">
                    <h2>Рестораны</h2>
                    <a asp-area="Restaurants" asp-controller="Manage" asp-action="Register" class="create_plus"><span>+</span></a>
                </div>
                <div class="title-section--right">
                    <form method="post" class="filter-form">
                        <div class="filter-form--title">Фильтр:</div>
                        <p>
                            <select class="form-control" asp-for="@ViewData["createdBy"]"
                                    asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.RestaurantCreatedBy>()">
                                <option value="">Создан кем угодно</option>
                            </select>
                        </p>
                        <p>
                            <select class="form-control" asp-for="@ViewData["status"]"
                                    asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.RestaurantStatus>()">
                                <option value="">Все статусы</option>
                            </select>
                        </p>
                        <p>
                            <select name="multiaction">
                                <option value="">Действие</option>
                                <option value="delete">Удалить</option>
                            </select>
                        </p>
                        <input type="submit" name="name" value="Применить" />
                    </form>
                </div>
            </div>


            <table class="mainTable">
                <thead>
                    <tr>
                        <th class="tableCheckbox">
                            <input id="checkAll" type="checkbox" value="" />
                        </th>
                        <th></th>
                        <th>
                            Название
                        </th>
                        <th>
                            Телефон
                        </th>
                        <th>
                            Адрес
                        </th>
                        <th>
                            SEO meta
                        </th>
                        <th>
                            Актуальність даних
                        </th>
                        <th>
                            Статус
                        </th>
                        <th>
                            Дата создания
                        </th>
                        <th>
                            Мод.
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var restaurantMeta = ViewData["restaurantMeta"] as System.Collections.Generic.Dictionary<string, (bool SeoFilled, System.DateTime? LastChecked)>;
                    }
                    @foreach (var item in Model)
                    {
                        (bool SeoFilled, System.DateTime? LastChecked) meta = (false, null);
                        restaurantMeta?.TryGetValue(item.Id, out meta);

                        var statusIconClass = item.Status == Menus.Abstract.Models.RestaurantStatus.Blocked ? "StatusIconBlocked"
                            : item.Status == Menus.Abstract.Models.RestaurantStatus.Closed ? "StatusIconBlock"
                            : item.Status == Menus.Abstract.Models.RestaurantStatus.Pending ? "StatusIconOnApproval"
                            : "";

                        <tr data-id="@item.Id">
                            <td class="tableCheckbox">
                                <input type="checkbox" value="" />
                            </td>
                            <td class="tableStatusIcon @statusIconClass">
                                <span>+</span>
                            </td>
                            <td>
                                <span>@item.Name</span>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Phone)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Address)
                            </td>
                            <td>
                                <span>@(meta.SeoFilled ? "Заповнено" : "Не заповнено")</span>
                            </td>
                            <td>
                                <span>@(meta.LastChecked.HasValue ? meta.LastChecked.Value.ToString("dd.MM.yyyy") : "Ще не перевірено")</span>
                            </td>
                            <td>
                                <select class="form-control" asp-for="@item.Status"
                                        asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.RestaurantStatus>()"></select>
                            </td>
                            <td>
                                <input type="date" name="item.CreateDate" value="@item.CreateDate.ToString("yyyy-MM-dd")" />
                            </td>
                            <td>
                                @Html.EditorFor(modelItem => item.Moderated)
                            </td>
                            <td class="tableEdit">
                                <a class="tableEditBtn" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                                <a class="" href="#" data-copy data-id="@item.Id">cp</a>
                                <a class="tableDeleteBtn" href="#" data-delete data-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="text-align:center; margin-top: 30px;">
                @if (page != 0)
                {
                    <a asp-route-q="@(ViewData["q"])" asp-route-createdBy="@(ViewData["createdBy"])" asp-route-status="@(ViewData["status"])" asp-route-page="@(page - 1)">&larr;Назад &nbsp;</a>
                }
                @if (Model.Count() == Convert.ToInt32(ViewData["pageSize"].ToString()))
                {
                    <a asp-route-q="@(ViewData["q"])" asp-route-createdBy="@(ViewData["createdBy"])" asp-route-status="@(ViewData["status"])" asp-route-page="@(page + 1)">Вперёд&rarr;</a>
                }
            </div>

        </div>

    </main>
</div>



<div class="popUpWindow hidden">
    <div class="popUpAlign">
        <div class="popUpContent">
            <span class="popUpClose"></span>
            <figure>
                <img src="~/images/question.png" alt="Alternate Text" />
            </figure>
            <p>Вы действительно хотите изменить <span>статус ресторана Maganda?</span></p>
            <div class="popUpBtns">
                <a href="#" class="btnChange">Изменить</a>
                <a href="#" class="btnCancel">Отменить</a>
            </div>
        </div>
    </div>
</div>

