@using System.Linq
@model List<Menus.Web.Areas.Admin.Controllers.RestaurantAdminRow>

@inject Menus.Web.Services.UserService UserService
@{
    var CurrentUser = await UserService.GetUserById(User.Identity.Name);
    var page = (int)ViewData["page"];
}

<div class="site-content">
    <main>

        <div class="site-content-center">

            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Рестораны</li>
                </ul>
            </div>

            <div class="title-section">
                <div class="title-section--left">
                    <h2>Рестораны</h2>
                    <a asp-area="Restaurants" asp-controller="Manage" asp-action="Register" class="create_plus"><span>+</span></a>
                </div>
                <div class="title-section--right">
                    <form method="get" id="createdByForm">
                        <input type="hidden" name="nameFilter" value="@ViewData["nameFilter"]" />
                        <input type="hidden" name="phoneFilter" value="@ViewData["phoneFilter"]" />
                        <input type="hidden" name="addressFilter" value="@ViewData["addressFilter"]" />
                        <input type="hidden" name="siteFilter" value="@ViewData["siteFilter"]" />
                        <input type="hidden" name="seoFilter" value="@ViewData["seoFilter"]" />
                        <input type="hidden" name="freshnessFilter" value="@ViewData["freshnessFilter"]" />
                        <input type="hidden" name="status" value="@ViewData["status"]" />
                        <input type="hidden" name="moderatedFilter" value="@ViewData["moderatedFilter"]" />
                        <input type="hidden" name="createdDateFilter" value="@(ViewData["createdDateFilter"] as DateTime? != null ? ((DateTime)ViewData["createdDateFilter"]).ToString("yyyy-MM-dd") : "")" />
                        <p>
                            <select class="form-control" name="createdBy" onchange="this.form.submit()">
                                <option value="">Створено ким завгодно</option>
                                @{
                                    var currentCreatedBy = ViewData["createdBy"]?.ToString();
                                }
                                @foreach (var val in Enum.GetValues(typeof(Menus.Abstract.Models.RestaurantCreatedBy)))
                                {
                                    <option value="@((int)val)" selected="@(currentCreatedBy == ((int)val).ToString())">@val</option>
                                }
                            </select>
                        </p>
                    </form>
                </div>
            </div>

            <form method="get" id="filterForm">
                <input type="hidden" name="createdBy" value="@ViewData["createdBy"]" />
                <table class="mainTable">
                    <thead>
                        <tr>
                            <th class="tableCheckbox">
                                <input id="checkAll" type="checkbox" value="" />
                            </th>
                            <th></th>
                            <th>Название</th>
                            <th>Телефон</th>
                            <th>Адрес</th>
                            <th>Сайт</th>
                            <th>SEO meta</th>
                            <th>Актуальність даних</th>
                            <th>Статус</th>
                            <th>Дата создания</th>
                            <th>Мод.</th>
                            <th></th>
                        </tr>
                        <tr class="filterRow">
                            <th class="tableCheckbox"></th>
                            <th></th>
                            <th><input type="text" name="nameFilter" value="@ViewData["nameFilter"]" placeholder="Фільтр..." /></th>
                            <th><input type="text" name="phoneFilter" value="@ViewData["phoneFilter"]" placeholder="Фільтр..." /></th>
                            <th><input type="text" name="addressFilter" value="@ViewData["addressFilter"]" placeholder="Фільтр..." /></th>
                            <th><input type="text" name="siteFilter" value="@ViewData["siteFilter"]" placeholder="Фільтр..." /></th>
                            <th>
                                <select name="seoFilter" onchange="this.form.submit()">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewData["seoFilter"] as string))">Всі</option>
                                    <option value="filled" selected="@((ViewData["seoFilter"] as string) == "filled")">Заповнено</option>
                                    <option value="empty" selected="@((ViewData["seoFilter"] as string) == "empty")">Не заповнено</option>
                                </select>
                            </th>
                            <th>
                                <select name="freshnessFilter" onchange="this.form.submit()">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewData["freshnessFilter"] as string))">Всі</option>
                                    <option value="never" selected="@((ViewData["freshnessFilter"] as string) == "never")">Ще не перевірено</option>
                                    <option value="stale" selected="@((ViewData["freshnessFilter"] as string) == "stale")">Не перевірено 30+ днів</option>
                                    <option value="recent" selected="@((ViewData["freshnessFilter"] as string) == "recent")">Перевірено нещодавно</option>
                                </select>
                            </th>
                            <th>
                                <select name="status" onchange="this.form.submit()">
                                    <option value="">Всі</option>
                                    @{
                                        var currentStatus = ViewData["status"]?.ToString();
                                    }
                                    @foreach (var val in Enum.GetValues(typeof(Menus.Abstract.Models.RestaurantStatus)))
                                    {
                                        <option value="@((int)val)" selected="@(currentStatus == ((int)val).ToString())">@val</option>
                                    }
                                </select>
                            </th>
                            <th><input type="date" name="createdDateFilter" value="@(ViewData["createdDateFilter"] as DateTime? != null ? ((DateTime)ViewData["createdDateFilter"]).ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" /></th>
                            <th>
                                <select name="moderatedFilter" onchange="this.form.submit()">
                                    <option value="" selected="@(string.IsNullOrEmpty(ViewData["moderatedFilter"] as string))">Всі</option>
                                    <option value="1" selected="@((ViewData["moderatedFilter"] as string) == "1")">Так</option>
                                    <option value="0" selected="@((ViewData["moderatedFilter"] as string) == "0")">Ні</option>
                                </select>
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusIconClass = item.Status == Menus.Abstract.Models.RestaurantStatus.Blocked ? "StatusIconBlocked"
                                : item.Status == Menus.Abstract.Models.RestaurantStatus.Closed ? "StatusIconBlock"
                                : item.Status == Menus.Abstract.Models.RestaurantStatus.Pending ? "StatusIconOnApproval"
                                : "";

                            <tr data-id="@item.Id">
                                <td class="tableCheckbox">
                                    <input type="checkbox" value="" />
                                </td>
                                <td class="tableStatusIcon @statusIconClass">
                                    <span>+</span>
                                </td>
                                <td>
                                    <span>@item.Name</span>
                                </td>
                                <td>
                                    @item.Phone
                                </td>
                                <td>
                                    @item.Address
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Website))
                                    {
                                        <a href="@item.Website" target="_blank" rel="noopener">@item.Website</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    <span>@(item.SeoFilled ? "Заповнено" : "Не заповнено")</span>
                                </td>
                                <td>
                                    <span>@(item.LastChecked.HasValue ? item.LastChecked.Value.ToString("dd.MM.yyyy") : "Ще не перевірено")</span>
                                </td>
                                <td>
                                    <select class="form-control statusSelect" data-id="@item.Id">
                                        @foreach (var val in Enum.GetValues(typeof(Menus.Abstract.Models.RestaurantStatus)))
                                        {
                                            <option value="@((int)val)" selected="@(item.Status == (Menus.Abstract.Models.RestaurantStatus)val)">@val</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="date" name="item.CreateDate" value="@item.CreateDate.ToString("yyyy-MM-dd")" />
                                </td>
                                <td>
                                    <input type="checkbox" name="item.Moderated" class="moderatedCheckbox" data-id="@item.Id" checked="@item.Moderated" />
                                </td>
                                <td class="tableEdit">
                                    <a class="tableEditBtn" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                                    <a class="" href="#" data-copy data-id="@item.Id">cp</a>
                                    <a class="tableDeleteBtn" href="#" data-delete data-id="@item.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>

                        @{
                var totalPages = (int)ViewData["totalPages"];
                var pagesToShow = new List<int>();
                if (totalPages > 0)
                {
                    pagesToShow.Add(0);
                    for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages - 2, page + 2); p++)
                    {
                        pagesToShow.Add(p);
                    }
                    if (totalPages > 1) pagesToShow.Add(totalPages - 1);
                    pagesToShow = pagesToShow.Distinct().OrderBy(x => x).ToList();
                }
            }
            <div style="text-align:center; margin-top: 30px;">
                @if (page != 0)
                {
                    <a style="margin: 0 8px;" asp-route-nameFilter="@ViewData["nameFilter"]" asp-route-phoneFilter="@ViewData["phoneFilter"]" asp-route-addressFilter="@ViewData["addressFilter"]" asp-route-siteFilter="@ViewData["siteFilter"]" asp-route-seoFilter="@ViewData["seoFilter"]" asp-route-freshnessFilter="@ViewData["freshnessFilter"]" asp-route-status="@ViewData["status"]" asp-route-moderatedFilter="@ViewData["moderatedFilter"]" asp-route-createdBy="@ViewData["createdBy"]" asp-route-page="@(page - 1)">&larr;</a>
                }
                @{
                    var previousPage = -1;
                }
                @foreach (var p in pagesToShow)
                {
                    if (previousPage != -1 && p - previousPage > 1)
                    {
                        <span style="margin: 0 8px; color:#a9aab3;">...</span>
                    }
                    if (p == page)
                    {
                        <span style="margin: 0 8px; font-weight:900;">@(p + 1)</span>
                    }
                    else
                    {
                        <a style="margin: 0 8px;" asp-route-nameFilter="@ViewData["nameFilter"]" asp-route-phoneFilter="@ViewData["phoneFilter"]" asp-route-addressFilter="@ViewData["addressFilter"]" asp-route-siteFilter="@ViewData["siteFilter"]" asp-route-seoFilter="@ViewData["seoFilter"]" asp-route-freshnessFilter="@ViewData["freshnessFilter"]" asp-route-status="@ViewData["status"]" asp-route-moderatedFilter="@ViewData["moderatedFilter"]" asp-route-createdBy="@ViewData["createdBy"]" asp-route-page="@p">@(p + 1)</a>
                    }
                    previousPage = p;
                }
                @if (page < totalPages - 1)
                {
                    <a style="margin: 0 8px;" asp-route-nameFilter="@ViewData["nameFilter"]" asp-route-phoneFilter="@ViewData["phoneFilter"]" asp-route-addressFilter="@ViewData["addressFilter"]" asp-route-siteFilter="@ViewData["siteFilter"]" asp-route-seoFilter="@ViewData["seoFilter"]" asp-route-freshnessFilter="@ViewData["freshnessFilter"]" asp-route-status="@ViewData["status"]" asp-route-moderatedFilter="@ViewData["moderatedFilter"]" asp-route-createdBy="@ViewData["createdBy"]" asp-route-page="@(page + 1)">&rarr;</a>
                }
            </div>

        </div>

    </main>
</div>

<div class="popUpWindow hidden">
    <div class="popUpAlign">
        <div class="popUpContent">
            <span class="popUpClose"></span>
            <figure>
                <img src="~/images/question.png" alt="Alternate Text" />
            </figure>
            <p>Вы действительно хотите изменить <span>статус ресторана Maganda?</span></p>
            <div class="popUpBtns">
                <a href="#" class="btnChange">Изменить</a>
                <a href="#" class="btnCancel">Отменить</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jquery.js"></script>
    <script>
        function getToken() {
            var token = '@Html.AntiForgeryToken()';
            token = $(token).val();
            return token;
        }

        $(document).on("keypress", '.filterRow input[type=text]', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                $("#filterForm").submit();
            }
        });

        $(document).on("change", "#checkAll", function () {
            $("tbody .tableCheckbox input[type=checkbox]").prop('checked', $(this).is(":checked"));
        });

        $(document).on("change", '[name="item.CreateDate"]', function () {
            $.ajax({
                    url: "@Url.Action("UpdateCreateDate")",
                    method: "POST",
                    data: {
                        "__RequestVerificationToken": getToken(),
                        id: $(this).closest("tr").attr("data-id"),
                        createDate: $(this).val()
                    }
                })
                .done(function () {

                })
                .fail(function (data) {
                    window.Logger.logTextError("UPDATE Restaurant CreateDate action failed");
                });
        });

        $(document).on("change", '.moderatedCheckbox', function () {
            $.ajax({
                    url: "@Url.Action("ToggleModerated")",
                    method: "POST",
                    data: {
                        "__RequestVerificationToken": getToken(),
                        id: $(this).data("id")
                    }
                })
                .done(function () {

                })
                .fail(function (data) {
                    window.Logger.logTextError("UPDATE Restaurant Moderated action failed");
                });
        });

        $(document).on("click", "[data-delete]", function (e) {
            e.preventDefault();
            var id = $(this).attr("data-id");

            if (!confirm("Are you sure?")) return;

            $.ajax({
                url: "@Url.Action("Delete")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id
                }
            })
                .done(function () {
                    $("tr[data-id=" + id + "]").remove();
                 })
                .fail(function (data) {
                    window.Logger.logTextError("DELETE Restaurant action failed, id = " + id);
                 });
        });

        $(document).on("click", "[data-copy]", function () {
            var id = $(this).attr("data-id");

            if (!confirm("Are you sure?")) return;

            $.ajax({
                url: "@Url.Action("Copy")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id
                }
            })
                .done(function () {
                    location.reload();
                 })
                .fail(function (data) {
                    window.Logger.logTextError("COPY Restaurant action failed, id = " + id);
                 });
        });

        $(document).on("change", '.statusSelect', function () {
            var id = $(this).data("id");
            var status = $(this).val();

            $.ajax({
                url: "@Url.Action("ChangeStatus")",
                method: "POST",
                data: {
                    "__RequestVerificationToken": getToken(),
                    id: id,
                    status: status
                }
            })
                .done(function () {
                    var tr = $("tr[data-id=" + id + "]");
                    var icon = tr.find(".tableStatusIcon");

                    icon.removeClass("StatusIconBlock").removeClass("StatusIconOnApproval").removeClass("StatusIconBlocked");

                    if (status === "1") icon.addClass("StatusIconOnApproval");
                    if (status === "2") icon.addClass("StatusIconBlocked");
                    if (status === "3") icon.addClass("StatusIconBlock");
                 })
                .fail(function (data) {
                    window.Logger.logTextError("STATUS CHANGE Restaurant action failed, id = " + id);
                 });
        });
    </script>
}
