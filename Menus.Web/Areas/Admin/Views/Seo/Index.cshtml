@model List<Menus.Web.Services.SeoPageWeek>

@{
    ViewData["Title"] = "SEO за тиждень";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var weeks = ViewData["weeks"] as List<DateTime>;
    var week = ViewData["week"] as DateTime?;
    var previous = ViewData["previous"] as DateTime?;
    var totals = ViewData["totals"] as List<SeoKindTotal> ?? new List<SeoKindTotal>();
    var kind = ViewData["kind"] as string;
    var list = ViewData["list"] as string;
    var lists = new[] { ("gain", "Найбільший ріст"), ("loss", "Найбільше падіння"), ("new", "Нові в Google"), ("top", "Найбільше показів") };
    string Diff(int now, int before) => now == before ? "" : (now > before ? "+" : "") + (now - before).ToString("N0");
    string Name(string k) => SeoReportService.Kinds.TryGetValue(k ?? "", out var n) ? n : k;
}

<style>
    .seo-report .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
    .seo-report table td { vertical-align: top; overflow-wrap: anywhere; }
    .seo-report .up { color: #1a7f37; }
    .seo-report .down { color: #c62828; }
    .seo-report .muted { color: #777; font-size: 12px; }
    .seo-report .table-wrap { overflow-x: auto; }
</style>

<div class="site-content">
    <main>
        <div class="site-content-center seo-report">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>SEO за тиждень</li>
                </ul>
            </div>

            @if (!weeks.Any())
            {
                <p>Даних ще немає: запустіть на сервері <code>cd /root/menus/content-bot && venv/bin/python seo_weekly.py --weeks 8</code>.</p>
            }
            else
            {
                <form method="get" class="filters">
                    <select name="week">
                        @foreach (var w in weeks)
                        {
                            <option value="@w.ToString("yyyy-MM-dd")" selected="@(w == week)">тиждень до @w.ToString("dd.MM.yyyy")</option>
                        }
                    </select>
                    <select name="kind">
                        <option value="">Усі сторінки</option>
                        @foreach (var k in SeoReportService.Kinds)
                        {
                            <option value="@k.Key" selected="@(k.Key == kind)">@k.Value</option>
                        }
                    </select>
                    <select name="list">
                        @foreach (var (key, title) in lists)
                        {
                            <option value="@key" selected="@(key == list)">@title</option>
                        }
                    </select>
                    <button type="submit">Показати</button>
                    <span class="muted">@(previous.HasValue ? $"порівняння з тижнем до {previous:dd.MM.yyyy}" : "попереднього тижня в базі ще немає")</span>
                </form>

                <div class="table-wrap">
                    <table class="mainTable">
                        <thead>
                            <tr><th>Вид сторінок</th><th>Сторінок з показами</th><th>Кліки</th><th>Покази</th><th>CTR</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in totals)
                            {
                                <tr>
                                    <td>@Name(t.Kind)</td>
                                    <td>@t.Pages</td>
                                    <td>@t.Clicks.ToString("N0") <span class="@(t.Clicks >= t.PrevClicks ? "up" : "down")">@Diff(t.Clicks, t.PrevClicks)</span></td>
                                    <td>@t.Impressions.ToString("N0") <span class="@(t.Impressions >= t.PrevImpressions ? "up" : "down")">@Diff(t.Impressions, t.PrevImpressions)</span></td>
                                    <td>@(t.Impressions == 0 ? "-" : (100.0 * t.Clicks / t.Impressions).ToString("0.0") + "%")</td>
                                </tr>
                            }
                            <tr>
                                <td><strong>Разом</strong></td>
                                <td>@totals.Sum(x => x.Pages)</td>
                                <td><strong>@totals.Sum(x => x.Clicks).ToString("N0")</strong> @Diff(totals.Sum(x => x.Clicks), totals.Sum(x => x.PrevClicks))</td>
                                <td><strong>@totals.Sum(x => x.Impressions).ToString("N0")</strong> @Diff(totals.Sum(x => x.Impressions), totals.Sum(x => x.PrevImpressions))</td>
                                <td>@(totals.Sum(x => x.Impressions) == 0 ? "-" : (100.0 * totals.Sum(x => x.Clicks) / totals.Sum(x => x.Impressions)).ToString("0.0") + "%")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h3>@lists.First(x => x.Item1 == list).Item2 (до @Menus.Web.Areas.Admin.Controllers.SeoController.Rows)</h3>
                <div class="table-wrap">
                    <table class="mainTable">
                        <thead>
                            <tr><th>Сторінка</th><th>Вид</th><th>Кліки</th><th>Покази</th><th>CTR</th><th>Позиція</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td><a href="@p.Page" target="_blank" rel="noopener">@(Uri.TryCreate(p.Page, UriKind.Absolute, out var uri) ? Uri.UnescapeDataString(uri.AbsolutePath) : p.Page)</a></td>
                                    <td>@Name(p.Kind)</td>
                                    <td>@p.Clicks <span class="@(p.Clicks >= p.PrevClicks ? "up" : "down")">@Diff(p.Clicks, p.PrevClicks)</span></td>
                                    <td>@p.Impressions <span class="@(p.Impressions >= p.PrevImpressions ? "up" : "down")">@Diff(p.Impressions, p.PrevImpressions)</span></td>
                                    <td>@(p.Impressions == 0 ? "-" : p.Ctr.ToString("0.0") + "%")</td>
                                    <td>
                                        @(p.Impressions == 0 ? "-" : p.Position.ToString("0.0"))
                                        @if (p.PrevPosition.HasValue && p.Impressions > 0)
                                        {
                                            <span class="muted">(було @p.PrevPosition.Value.ToString("0.0"))</span>
                                        }
                                        @if (p.IsNew)
                                        {
                                            <span class="up">нова</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>
