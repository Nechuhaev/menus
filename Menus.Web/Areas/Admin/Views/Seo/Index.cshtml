@model List<Menus.Web.Services.SeoPagePeriod>

@{
    ViewData["Title"] = "SEO";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var last = ViewData["last"] as DateTime?;
    var from = ViewData["from"] as DateTime?;
    var to = ViewData["to"] as DateTime?;
    var prevFrom = ViewData["prevFrom"] as DateTime?;
    var prevTo = ViewData["prevTo"] as DateTime?;
    var totals = ViewData["totals"] as List<SeoKindPeriod> ?? new List<SeoKindPeriod>();
    var daily = ViewData["daily"] as List<SeoDayPoint> ?? new List<SeoDayPoint>();
    var period = ViewData["period"] as string ?? "7";
    var kind = ViewData["kind"] as string;
    var list = ViewData["list"] as string;
    var page = ViewData["page"] as string;
    var periods = new[] { ("1", "останній день"), ("7", "7 днів"), ("28", "28 днів"), ("90", "90 днів"), ("custom", "свої дати") };
    var lists = new[] { ("gain", "Найбільший ріст"), ("loss", "Найбільше падіння"), ("new", "Нові в Google"), ("top", "Найбільше показів") };
    var hasGa = totals.Any(t => t.Views > 0 || t.PrevViews > 0);
    string Diff(int now, int before) => now == before ? "" : (now > before ? "+" : "") + (now - before).ToString("N0");
    string Name(string k) => SeoReportService.Kinds.TryGetValue(k ?? "", out var n) ? n : k;
    string ShortPath(string p) => Uri.TryCreate(p ?? "", UriKind.Absolute, out var u) ? Uri.UnescapeDataString(u.AbsolutePath) : p;
    string D(DateTime? d) => d?.ToString("dd.MM.yyyy");
}

<style>
    .seo-report .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
    .seo-report table td { vertical-align: top; overflow-wrap: anywhere; }
    .seo-report .up { color: #1a7f37; }
    .seo-report .down { color: #c62828; }
    .seo-report .muted { color: #777; font-size: 12px; }
    .seo-report .table-wrap { overflow-x: auto; }
    .seo-report tr.selected td { background: #fff7e0; }
    .seo-report .custom-dates { display: none; gap: 6px; align-items: center; }
    .seo-report .custom-dates.on { display: inline-flex; }
</style>

<div class="site-content">
    <main>
        <div class="site-content-center seo-report">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>SEO</li>
                </ul>
            </div>

            @if (last == null)
            {
                <p>Даних ще немає: запустіть на сервері <code>cd /root/menus/content-bot && venv/bin/python seo_daily.py --days 90</code>, далі - щодня з cron.</p>
            }
            else
            {
                <form method="get" class="filters">
                    <select name="period" id="seo-period">
                        @foreach (var (key, title) in periods)
                        {
                            <option value="@key" selected="@(key == period)">@title</option>
                        }
                    </select>
                    <span class="custom-dates @(period == "custom" ? "on" : "")" id="seo-dates">
                        <input type="date" name="from" value="@from?.ToString("yyyy-MM-dd")" max="@last?.ToString("yyyy-MM-dd")" />
                        —
                        <input type="date" name="to" value="@to?.ToString("yyyy-MM-dd")" max="@last?.ToString("yyyy-MM-dd")" />
                    </span>
                    <select name="kind">
                        <option value="">Усі сторінки</option>
                        @foreach (var k in SeoReportService.Kinds)
                        {
                            <option value="@k.Key" selected="@(k.Key == kind)">@k.Value</option>
                        }
                    </select>
                    <select name="list">
                        @foreach (var (key, title) in lists)
                        {
                            <option value="@key" selected="@(key == list)">@title</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(page))
                    {
                        <input type="hidden" name="url" value="@page" />
                    }
                    <button type="submit">Показати</button>
                    <span class="muted">@D(from) – @D(to) проти @D(prevFrom) – @D(prevTo). Дані Search Console - по @D(last) (останні 2-3 дні Google ще дораховує).</span>
                </form>

                <h3>
                    По днях:
                    @if (!string.IsNullOrEmpty(page))
                    {
                        <span>сторінка <a href="@page" target="_blank" rel="noopener">@ShortPath(page)</a></span>
                        <a class="muted" href="@Url.Action("Index", new { period, from = from?.ToString("yyyy-MM-dd"), to = to?.ToString("yyyy-MM-dd"), kind, list })">× усі сторінки</a>
                    }
                    else
                    {
                        <span>@(string.IsNullOrEmpty(kind) ? "усі сторінки" : Name(kind))</span>
                    }
                </h3>
                <partial name="_DailyChart" model="daily" />

                <div class="table-wrap">
                    <table class="mainTable">
                        <thead>
                            <tr><th>Вид сторінок</th><th>Сторінок з показами</th><th>Кліки</th><th>Покази</th><th>CTR</th>@if (hasGa) { <th>Перегляди GA4</th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var t in totals)
                            {
                                <tr class="@(t.Kind == kind ? "selected" : "")">
                                    <td><a href="@Url.Action("Index", new { period, from = from?.ToString("yyyy-MM-dd"), to = to?.ToString("yyyy-MM-dd"), kind = t.Kind, list })">@Name(t.Kind)</a></td>
                                    <td>@t.Pages</td>
                                    <td>@t.Clicks.ToString("N0") <span class="@(t.Clicks >= t.PrevClicks ? "up" : "down")">@Diff(t.Clicks, t.PrevClicks)</span></td>
                                    <td>@t.Impressions.ToString("N0") <span class="@(t.Impressions >= t.PrevImpressions ? "up" : "down")">@Diff(t.Impressions, t.PrevImpressions)</span></td>
                                    <td>@(t.Impressions == 0 ? "-" : (100.0 * t.Clicks / t.Impressions).ToString("0.0") + "%")</td>
                                    @if (hasGa) { <td>@t.Views.ToString("N0") <span class="@(t.Views >= t.PrevViews ? "up" : "down")">@Diff(t.Views, t.PrevViews)</span></td> }
                                </tr>
                            }
                            <tr>
                                <td><strong><a href="@Url.Action("Index", new { period, from = from?.ToString("yyyy-MM-dd"), to = to?.ToString("yyyy-MM-dd"), list })">Разом</a></strong></td>
                                <td>@totals.Sum(x => x.Pages)</td>
                                <td><strong>@totals.Sum(x => x.Clicks).ToString("N0")</strong> @Diff(totals.Sum(x => x.Clicks), totals.Sum(x => x.PrevClicks))</td>
                                <td><strong>@totals.Sum(x => x.Impressions).ToString("N0")</strong> @Diff(totals.Sum(x => x.Impressions), totals.Sum(x => x.PrevImpressions))</td>
                                <td>@(totals.Sum(x => x.Impressions) == 0 ? "-" : (100.0 * totals.Sum(x => x.Clicks) / totals.Sum(x => x.Impressions)).ToString("0.0") + "%")</td>
                                @if (hasGa) { <td><strong>@totals.Sum(x => x.Views).ToString("N0")</strong> @Diff(totals.Sum(x => x.Views), totals.Sum(x => x.PrevViews))</td> }
                            </tr>
                        </tbody>
                    </table>
                </div>
                @if (!hasGa)
                {
                    <p class="muted">Перегляди GA4 з'являться, коли сервісний акаунт Search Console додадуть у GA4 як «Глядача» і seo_daily.py запуститься знову.</p>
                }

                <h3>@lists.First(x => x.Item1 == list).Item2 (до @Menus.Web.Areas.Admin.Controllers.SeoController.Rows) <span class="muted">натисніть на сторінку - графік по днях</span></h3>
                <div class="table-wrap">
                    <table class="mainTable">
                        <thead>
                            <tr><th>Сторінка</th><th>Вид</th><th>Кліки</th><th>Покази</th><th>CTR</th><th>Позиція</th>@if (hasGa) { <th>Перегляди GA4</th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr class="@(p.Page == page ? "selected" : "")">
                                    <td>
                                        <a href="@Url.Action("Index", new { period, from = from?.ToString("yyyy-MM-dd"), to = to?.ToString("yyyy-MM-dd"), kind, list, url = p.Page })">@ShortPath(p.Page)</a>
                                        <a class="muted" href="@p.Page" target="_blank" rel="noopener">↗</a>
                                    </td>
                                    <td>@Name(p.Kind)</td>
                                    <td>@p.Clicks <span class="@(p.Clicks >= p.PrevClicks ? "up" : "down")">@Diff(p.Clicks, p.PrevClicks)</span></td>
                                    <td>@p.Impressions <span class="@(p.Impressions >= p.PrevImpressions ? "up" : "down")">@Diff(p.Impressions, p.PrevImpressions)</span></td>
                                    <td>@(p.Impressions == 0 ? "-" : p.Ctr.ToString("0.0") + "%")</td>
                                    <td>
                                        @(p.Impressions == 0 ? "-" : p.Position.ToString("0.0"))
                                        @if (p.PrevPosition.HasValue && p.Impressions > 0)
                                        {
                                            <span class="muted">(було @p.PrevPosition.Value.ToString("0.0"))</span>
                                        }
                                        @if (p.IsNew)
                                        {
                                            <span class="up">нова</span>
                                        }
                                    </td>
                                    @if (hasGa) { <td>@p.Views <span class="@(p.Views >= p.PrevViews ? "up" : "down")">@Diff(p.Views, p.PrevViews)</span></td> }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>

<script>
    (function () {
        var period = document.getElementById('seo-period'), dates = document.getElementById('seo-dates');
        if (period && dates) period.addEventListener('change', function () { dates.classList.toggle('on', period.value === 'custom'); });
    })();
</script>
