@model List<Menus.Web.Services.SitePageInfo>
@{
    ViewData["Title"] = "Тексти сторінок";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="site-content">
    <main>
        <div class="site-content-center">
            <div class="breadcrumbs">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li>Тексти сторінок</li>
                </ul>
            </div>
            <h2>Тексти сторінок</h2>
            <p style="color:#777">Тексти лендингів: правка тут замінює текст на сайті, порожнє поле - текст за замовчуванням.</p>
            <ul>
                @foreach (var p in Model)
                {
                    <li style="margin:8px 0;"><a asp-action="Edit" asp-route-id="@p.Key">@p.Title</a> <a style="color:#777" href="/uk/@p.Url" target="_blank" rel="noopener">/uk/@p.Url ↗</a></li>
                }
            </ul>
        </div>
    </main>
</div>
