@inject Menus.Web.Services.LocaleService LocaleSrvc;
@{
    ViewData["Title"] = "Dishes";
    Layout = "~/Areas/Restaurants/Views/Shared/_Layoutinner.cshtml";
    var menuCategories = ViewData["menuCategories"] as IEnumerable<Menus.Abstract.Models.IMenuCategory>;
    var rqf = Context.Request.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    // Culture contains the information of the requested culture
    var culture = rqf.RequestCulture.Culture;
    var Locales = LocaleSrvc.GetLocales();
}

<style>
    iframe.subpage {
        width: 100%;
        height: 14vw;
        border-bottom: 1px #ccc solid;
        padding-bottom: 20px;
        margin-top: 20px;
    }
    iframe.subpage.opened {
        height: 43vw;
    }
</style>

<div class="site-content">
    <main>

        <div class="breadcrumbs">
            <ul>
                <li><a asp-controller="Manage" asp-action="Index">Мои рестораны</a></li>
                <li>Добавить блюдо</li>
            </ul>
        </div>

        <div class="site-content-wrapper">

            <ul class="content_nav">
                <li class="active"><a asp-action="CreateDish">Общая информация</a></li>
                <li class="not_active"><a href="#">SEO</a></li>
            </ul>

            <div class="language_and_text">
                <div class="column_left">
                    <p class="requiredField"><span>*</span> поля обязательные к заполнению</p>
                </div>
                <div class="column_right">
                    <ul class="content_language">
                        @{
                            var firstLocale = true;
                        }
                        @foreach (var locale in Locales)
                        {
                            <li class="@(firstLocale ? "current" : "")"><a data-locale="@locale.Id" href="#">@locale.ShortName</a></li>
                            firstLocale = false;
                        }
                    </ul>
                </div>
            </div>

            @*<iframe src="@Url.Action("CreateDishIframe")" frameborder="0" class="subpage"></iframe>*@
            @*<iframe src="@Url.Action("EditDishIframe", new { id = "d29c36ce-6fda-495c-8fa7-0f600f7bb894" })" class="subpage" frameborder="0"></iframe>*@

        </div>

    </main>
</div>



<script src="~/js/jquery.js"></script>
<script>
    jQuery(document).ready(function () {
        jQuery('.view-more').on('click', function (e) {
            e.preventDefault();
            jQuery(this).toggleClass('view-more-open');
            jQuery('.block-more').slideToggle();
        });
    });


    /* Lanuage position
    =================================================================*/

    var languagePosition = jQuery('.content_language').offset().top;

    jQuery(document).on('scroll', function () {

        var currentPosition = jQuery(document).scrollTop();

        if (currentPosition >= languagePosition) {
            jQuery('.content_language').addClass('fixed');
        }
        else {
            jQuery('.content_language').removeClass('fixed');
        }

    });


    var currentLangId = "ru";
    $("a[data-locale]").click(function (e) {
        e.preventDefault();
        $("a[data-locale]").parent().removeClass("current");
        $(this).parent().addClass("current");

        $("div[data-locale], span[data-locale]").addClass("hidden");
        var id = $(this).attr("data-locale");
        currentLangId = id;
        $("div[data-locale=" + id + "], span[data-locale=" + id + "]").removeClass("hidden");

        $("iframe[data-frame-id]").each(function () {
            var win = this.contentWindow;
            win.postMessage({
                action: "changeLang",
                id: id
            }, "@Context.Request.Scheme://@Context.Request.Host");
        });
    });

    function readURL(input, img) {

        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $(img).css('background-image', "url(" + e.target.result + ")");
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    $(document).on("change", ".add_photo_dishes input", function () {
        var container = $(this).parent();
        readURL(this, container[0]);
    });

    $(document).on("change", "[data-category] input", function () {
        var selectedCategories = [];
        $("[data-category] input").each(function () {
            if ($(this).is(":checked")) {
                var id = $(this).parent().parent().attr("data-category");
                selectedCategories.push(id);
            }
        });

        $("[name=Categories]").val(JSON.stringify(selectedCategories));
    });

    $("#clear-photo").click(function () {
        var fileopen = $(".add_photo_dishes input");

        var parent = fileopen.parent();
        parent.removeAttr("style");

        fileopen.remove();
        parent.append("<input id=\"dish-photo\" name=\"PhotoFile\" type=\"file\" accept=\"image/png, image/jpeg\" />");
    });

</script>
<script>
    function generateId() {
        var timestamp = (new Date().getTime() / 1000 | 0).toString(16);
        return timestamp + 'xxxxxxxxxxxxxxxx'.replace(/[x]/g, function () {
            return (Math.random() * 16 | 0).toString(16);
        }).toLowerCase();
    }
    function receiveMessage(event) {
        //console.log(event);
        if (event.data.action === "new") {
            var frameId = generateId();
            var iframeId = event.data.frameId;
            $("[data-frame-id=" + iframeId + "]").after('<iframe src="@Url.Action("CreateDishIframe")?frameId=' + frameId + '" data-frame-id="' + frameId + '" frameborder="0" class="subpage"></iframe>');
            $("[data-frame-id=" + frameId + "]")[0].scrollIntoView();
        }
        if (event.data.action === "existing") {
            var frameId = generateId();
            var iframeId = event.data.frameId;
            $("[data-frame-id=" + iframeId + "]").after('<iframe src="@Url.Action("EditDishIframe")/' + event.data.itemId + '/?frameId=' + frameId + '" data-frame-id="' + frameId + '" frameborder="0" class="subpage"></iframe>');
            $("[data-frame-id=" + frameId + "]")[0].scrollIntoView();
        }
        if (event.data.action === "copy") {
            var frameId = generateId();
            var iframeId = event.data.frameId;
            $("[data-frame-id=" + iframeId + "]").after('<iframe src="@Url.Action("CreateCopyDishIframe")/' + event.data.itemId + '/?frameId=' + frameId + '" data-frame-id="' + frameId + '" frameborder="0" class="subpage"></iframe>');
            $("[data-frame-id=" + frameId + "]")[0].scrollIntoView();
        }
        if (event.data.action === "viewMore") {
            var iframeId = event.data.frameId;
            var open = event.data.open;
            open
                ? $("[data-frame-id=" + iframeId + "]").addClass("opened")
                : $("[data-frame-id=" + iframeId + "]").removeClass("opened");

            $("iframe[data-frame-id]").each(function() {
                var win = this.contentWindow;
                win.postMessage({
                        action: "changeLang",
                        id: currentLangId
                    },
                    "@Context.Request.Scheme://@Context.Request.Host");
            });

            if (event.data.firstLoad) {
                $("[data-frame-id=" + iframeId + "]")[0].contentWindow.postMessage({
                    action: "focusNameInput"
                }, "@Context.Request.Scheme://@Context.Request.Host");
            }
        }
    }
    window.addEventListener("message", receiveMessage, false);
    var frameId = generateId();
    $(".site-content-wrapper").append('<iframe src="@Url.Action("CreateDishIframe")?frameId=' + frameId + '" data-frame-id="' + frameId + '" frameborder="0" class="subpage"></iframe>');
</script>