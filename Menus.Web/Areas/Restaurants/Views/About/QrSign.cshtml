@{
    Layout = null;
    var qrUrl = ViewData["qrUrl"] as string;
    var name = ViewData["name"] as string;
}
<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>QR-меню: @name</title>
    @* табличка A6 (105×148 мм): друк або «Зберегти як PDF» у вікні друку браузера *@
    <style>
        @@page { size: A6; margin: 0; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, sans-serif; background: #eef0f3; color: #231f20; }
        .tools { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding: 12px 16px; }
        .tools button, .tools a { min-height: 40px; padding: 8px 16px; border: 0; border-radius: 8px; background: #ffb80e; font-weight: 600; font-size: 15px; cursor: pointer; color: #231f20; text-decoration: none; }
        .tools .ghost { background: #fff; border: 1px solid #dfe2e8; }
        .hint { text-align: center; color: #5f6670; font-size: 13px; margin: 0 16px 12px; }
        .sign { width: 105mm; max-width: 100%; aspect-ratio: 105 / 148; margin: 0 auto 24px; background: #fff; border-radius: 6px; box-shadow: 0 2px 12px rgba(0,0,0,.12);
                display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 8mm 7mm 6mm; text-align: center; overflow: hidden; }
        .sign .name { font-size: 22px; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
        .sign .lead { font-size: 15px; margin-top: 4px; }
        .sign #qr { width: 62mm; max-width: 70%; aspect-ratio: 1; }
        .sign #qr img, .sign #qr canvas { width: 100% !important; height: auto !important; display: block; }
        .sign .scan { font-size: 13px; color: #5f6670; }
        .sign .brand { font-size: 12px; color: #8a9099; }
        .sign .brand b { color: #ffb80e; }
        @@media print {
            body { background: #fff; }
            .tools, .hint { display: none; }
            .sign { width: 105mm; height: 148mm; margin: 0; border-radius: 0; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="tools">
        <button type="button" onclick="window.print()">Друкувати / зберегти PDF</button>
        <a class="ghost" id="png" download="qr-menu.png" href="#">Завантажити QR (PNG)</a>
        <a class="ghost" href="@qrUrl" target="_blank" rel="noopener">Відкрити меню ↗</a>
    </div>
    <p class="hint">Формат A6 (105×148 мм). У вікні друку виберіть розмір паперу A6 або друкуйте на A4 і виріжте.</p>
    <div class="sign">
        <div>
            <div class="name">@name</div>
            <div class="lead">Меню й ціни</div>
        </div>
        <div id="qr"></div>
        <div>
            <div class="scan">Наведіть камеру телефона на код</div>
            <div class="brand">меню від <b>TipMyMenu</b></div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            var url = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(qrUrl));
            var box = document.getElementById('qr');
            new QRCode(box, { text: url, width: 600, height: 600, correctLevel: QRCode.CorrectLevel.M });
            // PNG для завантаження - з canvas, який малює бібліотека
            setTimeout(function () {
                var canvas = box.querySelector('canvas');
                if (canvas) document.getElementById('png').href = canvas.toDataURL('image/png');
            }, 300);
        })();
    </script>
</body>
</html>
