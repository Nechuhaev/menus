
@{
    ViewData["Title"] = "DishesList";
    Layout = "~/Areas/Restaurants/Views/Shared/_LayoutInner.cshtml";
}



<div class="site-content">
    <main>



        <div class="breadcrumbs">
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                @if (!User.IsInRole("admin") && !User.IsInRole("manager"))
                {
                    <li><a asp-controller="Manage" asp-action="Index">Мои рестораны</a></li>
                }
                <li>Мое меню</li>
            </ul>
        </div>



        <div class="site-content-wrapper">

            <div class="title-section">
                <div class="title-section--left">
                    <h2>Меню</h2>
                </div>
                <div class="title-section--right">
                    <form method="post" class="filter-form">
                        <div class="filter-form--title">Фильтр:</div>
                        <p>
                            <select>
                                <option value="">Категория</option>
                            </select>
                        </p>
                        <p>
                            <select class="form-control" asp-for="@ViewData["status"]"
                                    asp-items="Html.GetEnumSelectList<Menus.Abstract.Models.RestaurantStatus>()">
                                <option value="">Все статусы</option>
                            </select>
                        </p>
                        <p>
                            <select name="multiaction">
                                <option value="">Действие</option>
                                <option value="delete">Удалить</option>
                            </select>
                        </p>
                        <input type="submit" name="name" value="Применить" />
                    </form>
                </div>
            </div>

            <table class="dishes_list">
                <thead>
                    <tr>
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Блюдо</td>
                        <td class="dishes_category">Категория</td>
                        <td class="dishes_price">Цена</td>
                        <td class="dishes_weight">Вес</td>
                        <td class="dishes_btn"></td>
                    </tr>
                </thead>
                <tbody>
                    <tr class="selected">
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Добірка українських "помазух"</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                    <tr>
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Карпаччо із сала з соусом Юзу</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                    <tr>
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Карпаччо з телятини</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                    <tr>
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Добірка українських "помазух" Добірка українських "помазух" Добірка українських "помазух"</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                    <tr class="selected">
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Карпаччо із сала з соусом Юзу</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                    <tr>
                        <td class="dishes_checkbox"><input type="checkbox" value="" /></td>
                        <td class="dishes_name">Карпаччо з телятини</td>
                        <td class="dishes_category">Разное</td>
                        <td class="dishes_price">125 грн</td>
                        <td class="dishes_weight">200 г</td>
                        <td class="dishes_btn"><a class="tableEditBtn" href="#">Edit</a></td>
                    </tr>
                </tbody>
            </table>

        </div>



    </main>
</div>