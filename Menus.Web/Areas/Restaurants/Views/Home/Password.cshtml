
@{
    ViewData["Title"] = "Password";
    Layout = "~/Areas/Restaurants/Views/Shared/_LayoutInner.cshtml";
}



<div class="site-content">
    <main>



        <div class="breadcrumbs">
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                <li>Пароль</li>
            </ul>
        </div>



        <div class="site-content-wrapper">

            <form class="changePassword">
                <div class="form_group">
                    <label>Старый пароль</label>
                    <input type="password" />
                </div>
                <div class="form_group">
                    <label>Новый пароль</label>
                    <input type="password" />
                </div>
                <div class="form_group">
                    <label>Подтвердить новый пароль</label>
                    <input type="password" />
                </div>
                <div class="form_group form_group_submit">
                    <input type="submit" value="изменить" />
                </div>
            </form>

        </div>



    </main>
</div>