FROM mcr.microsoft.com/dotnet/core/runtime:2.1-alpine AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:2.1 AS build
WORKDIR /src
COPY *.sln ./
COPY Menus.Web/Menus.Web.csproj Menus.Web/
COPY Menus.Abstract/Menus.Abstract.csproj Menus.Abstract/
COPY Menus.Domain/Menus.Domain.csproj Menus.Domain/
COPY Menus.TelegramBot/Menus.TelegramBot.csproj Menus.TelegramBot/
COPY Menus.Files/Menus.Files.csproj Menus.Files/
RUN dotnet restore
COPY . .
WORKDIR /src/Menus.TelegramBot
RUN dotnet build -c Release -o /app

FROM build AS publish
RUN dotnet publish -c Release -o /app

FROM base AS final
WORKDIR /app
COPY --from=publish /app .
ENTRYPOINT ["dotnet", "Menus.TelegramBot.dll"]
